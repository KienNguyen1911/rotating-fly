<Window x:Class="AutoCreateImage.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoCreateImage"
        mc:Ignorable="d"
         Title="YouTube &amp; ChatGPT Automation Prototype" Height="750" Width="1250"
         Background="#0F172A" FontFamily="Segoe UI">
    <Window.Resources>
        <!-- TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ComboBox ToggleButton Template -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="Border" 
                    Background="#1E293B" 
                    BorderBrush="#334155" 
                    BorderThickness="1" 
                    CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="24" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="1" BorderBrush="#334155" BorderThickness="1,0,0,0" Margin="0,2"/>
                    <Path x:Name="Arrow" 
                          Grid.Column="1" 
                          Fill="#94A3B8" 
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Center" 
                          Data="M 0 0 L 4 4 L 8 0 Z"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#334155"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="White"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#334155"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" 
                                          Template="{StaticResource ComboBoxToggleButton}" 
                                          Focusable="false" 
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter x:Name="ContentSite" 
                                              IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              Margin="8,1,28,1" 
                                              VerticalAlignment="Center" 
                                              HorizontalAlignment="Left"/>
                            <TextBox x:Name="PART_EditableTextBox"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Margin="8,1,28,1"
                                     Focusable="True"
                                     Background="Transparent"
                                     Foreground="White"
                                     CaretBrush="White"
                                     BorderThickness="0"
                                     Visibility="Hidden"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"/>
                            <Popup x:Name="Popup" 
                                   Placement="Bottom" 
                                   IsOpen="{TemplateBinding IsDropDownOpen}" 
                                   AllowsTransparency="True" 
                                   Focusable="False" 
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown" 
                                      SnapsToDevicePixels="True" 
                                      MinWidth="{TemplateBinding ActualWidth}" 
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" 
                                            Background="#0F172A" 
                                            BorderBrush="#475569" 
                                            BorderThickness="1" 
                                            CornerRadius="4"/>
                                    <ScrollViewer Margin="4,6" SnapsToDevicePixels="True" VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="true">
                                <Setter Property="IsTabStop" Value="false"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="DropDownBorder" Property="Height" Value="95"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Padding" Value="8,5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3B82F6"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TabItem Custom Template for Dark Theme -->
        <Style TargetType="TabItem">
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <ContentPresenter Content="{TemplateBinding Content}"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="1,1,1,1" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}" 
                                Margin="0,0,8,0">
                            <ContentPresenter x:Name="ContentSite"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Border" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="White"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>
        
        <!-- DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#334155"/>
        </Style>
        
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3B82F6"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Value Converters -->
        <local:YoutubeUrlConverter x:Key="YoutubeUrlConverter"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="15" Margin="0,0,0,15" BorderBrush="#334155" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="YOUTUBE SCRIPT &amp; VOICEOVER AUTOMATION" Foreground="White" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="Prototype V2 - C# Playwright Automation Flow" Foreground="#93C5FD" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main TabControl -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <!-- TAB 1: AUTOMATION TASKS -->
            <TabItem Header="Automation Tasks" Padding="15,6" FontSize="12" FontWeight="SemiBold">
                <Grid Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Toolbar for Tasks -->
                    <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="15" Margin="0,0,0,15" BorderBrush="#334155" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Manage tasks configuration directly inside the table rows below. Press 'Tạo Task' to add a new row." VerticalAlignment="Center" Foreground="#94A3B8" FontSize="12" FontStyle="Italic"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                                <TextBlock Text="AI84 Key:" VerticalAlignment="Center" Foreground="#F8FAFC" FontSize="12" FontWeight="SemiBold" Margin="0,0,4,0"/>
                                <TextBox x:Name="TxtAi84ApiKey" Width="100" Height="25" VerticalContentAlignment="Center" Padding="4,2" Margin="0,0,10,0"/>
                                <TextBlock Text="Img URL:" VerticalAlignment="Center" Foreground="#F8FAFC" FontSize="12" FontWeight="SemiBold" Margin="0,0,4,0"/>
                                <TextBox x:Name="TxtImageApiUrl" Width="180" Height="25" VerticalContentAlignment="Center" Padding="4,2" Margin="0,0,10,0"/>
                                <TextBlock Text="Img Key:" VerticalAlignment="Center" Foreground="#F8FAFC" FontSize="12" FontWeight="SemiBold" Margin="0,0,4,0"/>
                                <TextBox x:Name="TxtImageApiKey" Width="100" Height="25" VerticalContentAlignment="Center" Padding="4,2"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnAddTask" Content="Tạo Task" Height="28" Width="100" Background="#10B981" Foreground="White" BorderThickness="0" FontSize="12" FontWeight="Bold" Click="BtnAddTask_Click" Margin="0,0,10,0"/>
                                <Button x:Name="BtnAddBulkTasks" Content="Tạo Nhiều" Height="28" Width="100" Background="#8B5CF6" Foreground="White" BorderThickness="0" FontSize="12" FontWeight="Bold" Click="BtnAddBulkTasks_Click" Margin="0,0,10,0"/>
                                <Button x:Name="BtnRun" Content="Chạy Toàn Bộ Task" Height="28" Width="140" Background="#2563EB" Foreground="White" BorderThickness="0" FontSize="12" FontWeight="Bold" Click="BtnRun_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Tasks Table & Logs Sidebar -->
                    <Grid Grid.Row="1">
                        <!-- Main Area: DataGrid of Tasks (always fills full width) -->
                        <Border Background="#1E293B" CornerRadius="8" Padding="15" BorderBrush="#334155" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Task Queue &amp; Automation Control" FontSize="16" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,0,15"/>
                                
                                <DataGrid Grid.Row="1" x:Name="DgridTasks" AutoGenerateColumns="False" CanUserAddRows="False" 
                                          Background="Transparent" BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                          RowHeaderWidth="0" IsReadOnly="False" RowHeight="36" FontSize="13">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Resources>
                                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3B82F6"/>
                                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#334155"/>
                                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White"/>
                                            </Style.Resources>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#334155"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Ngày tạo" Binding="{Binding CreatedAtFormatted}" Width="1.4*" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Padding" Value="5,0"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="Link Video" Binding="{Binding VideoUrl, Converter={StaticResource YoutubeUrlConverter}, UpdateSourceTrigger=PropertyChanged}" Width="2*" IsReadOnly="False">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Padding" Value="5,0"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        
                                        <DataGridTextColumn Header="Ngôn ngữ" Binding="{Binding TargetLanguage}" Width="1.2*" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Padding" Value="5,0"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTemplateColumn Header="Voice ID" Width="1.5*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="2,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0" Text="{Binding VoiceId, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalAlignment="Center" VerticalContentAlignment="Center" BorderThickness="1" BorderBrush="#334155" Background="#1E293B" Foreground="White" CaretBrush="White"/>
                                                        <Button Grid.Column="1" Content="🔍" Width="28" Height="28" Margin="4,0,0,0" VerticalAlignment="Center" Click="BtnBrowseVoice_Click" ToolTip="Browse shared voices" Background="#3B82F6" Foreground="White" BorderThickness="0">
                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="4"/>
                                                                </Style>
                                                            </Button.Resources>
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="Chrome Profile" Width="1.5*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ProfileList}"
                                                              SelectedItem="{Binding SelectedProfile, UpdateSourceTrigger=PropertyChanged}"
                                                              IsEditable="False"
                                                              Height="28" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="1.2*" IsReadOnly="True">
                                            <DataGridTextColumn.HeaderStyle>
                                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.HeaderStyle>
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="Text" Value="Done">
                                                            <Setter Property="Foreground" Value="#10B981"/>
                                                        </Trigger>
                                                        <Trigger Property="Text" Value="Failed">
                                                            <Setter Property="Foreground" Value="#EF4444"/>
                                                        </Trigger>
                                                        <Trigger Property="Text" Value="Pending">
                                                            <Setter Property="Foreground" Value="#94A3B8"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTemplateColumn Header="Action" Width="2.2*" IsReadOnly="True">
                                            <DataGridTemplateColumn.HeaderStyle>
                                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTemplateColumn.HeaderStyle>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Button Content="Run" Padding="6,3" Margin="2,0" Click="BtnRunSingleTask_Click" Background="#2563EB" Foreground="White" BorderThickness="0" FontSize="11" FontWeight="SemiBold"/>
                                                        <Button Content="Logs" Padding="6,3" Margin="2,0" Click="BtnViewTaskLog_Click" Background="#475569" Foreground="White" BorderThickness="0" FontSize="11"/>
                                                        <Button Content="Assets" Padding="6,3" Margin="2,0" Click="BtnViewTaskAssets_Click" Background="#10B981" Foreground="White" BorderThickness="0" FontSize="11"/>
                                                        <Button Content="Delete" Padding="6,3" Margin="2,0" Click="BtnDeleteTask_Click" Background="#EF4444" Foreground="White" BorderThickness="0" FontSize="11" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- Sidebar Drawer Overlay (slides from right, resizable via drag handle) -->
                        <Grid x:Name="SidebarLogs" HorizontalAlignment="Right" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <!-- Drag handle column -->
                                <ColumnDefinition Width="Auto"/>
                                <!-- Sidebar content column -->
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Drag handle for resizing -->
                            <Border Grid.Column="0" Width="6" Background="#334155" Cursor="SizeWE"
                                    MouseLeftButtonDown="SidebarDragHandle_MouseLeftButtonDown"
                                    MouseMove="SidebarDragHandle_MouseMove"
                                    MouseLeftButtonUp="SidebarDragHandle_MouseLeftButtonUp">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#3B82F6"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <!-- Sidebar content -->
                            <Border Grid.Column="1" Background="#0B0F19" BorderBrush="#3B82F6" BorderThickness="1,0,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Header with close button -->
                                    <Grid Grid.Row="0" Margin="15,15,15,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Task Live Logs" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="✕" Width="30" Height="30" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="16" Click="BtnCloseSidebar_Click"/>
                                    </Grid>

                                    <!-- Log content (stretches to fill sidebar width) -->
                                    <TextBox Grid.Row="1" x:Name="TxtSidebarLog" Background="Transparent" Foreground="#F8FAFC" BorderThickness="0" 
                                              Margin="15,0,15,15" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsReadOnly="True" 
                                              FontSize="12" FontFamily="Consolas" AcceptsReturn="True"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 2: CHROME PROFILE MANAGER -->
            <TabItem Header="Chrome Profiles" Padding="15,6" FontSize="12" FontWeight="SemiBold">
                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Profiles Listbox -->
                    <Border Grid.Column="0" Background="#1E293B" CornerRadius="8" Padding="15" BorderBrush="#334155" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Select Profile" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,10"/>
                            <ListBox Grid.Row="1" x:Name="LboxProfiles" ItemsSource="{Binding ProfileList}" BorderThickness="0" Background="Transparent" SelectedIndex="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,8" Margin="0,2" CornerRadius="4" BorderThickness="1" BorderBrush="#334155" Background="#0F172A">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="👤" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding}" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Right: Profile Controls -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Selected Profile Actions Card -->
                        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="20" BorderBrush="#334155" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Selected Profile Management" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,15"/>
                                
                                <TextBlock Text="Selected Profile:" FontSize="12" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding ElementName=LboxProfiles, Path=SelectedItem}" FontSize="18" FontWeight="Bold" Foreground="#60A5FA" Margin="0,2,0,20"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnOpenProfileBrowser" Content="🌐 Open Browser (ChatGPT Login)" Width="230" Height="35" Background="#2563EB" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Click="BtnOpenProfileBrowser_Click" Margin="0,0,10,0"/>
                                    <Button x:Name="BtnOpenProfileFolder" Content="📂 Open Folder in Explorer" Width="180" Height="35" Background="#475569" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Click="BtnOpenProfileFolder_Click" Margin="0,0,10,0"/>
                                    <Button x:Name="BtnDeleteProfile" Content="🗑️ Delete Profile" Width="130" Height="35" Background="#EF4444" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Click="BtnDeleteProfile_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Create New Profile Card -->
                        <Border Grid.Row="2" Background="#1E293B" CornerRadius="8" Padding="20" BorderBrush="#334155" BorderThickness="1" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Create New Chrome Profile" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,15"/>
                                <TextBlock Text="Profile Name (e.g. your Gmail or Name):" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,5"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtNewProfileName" Height="30" VerticalContentAlignment="Center" Padding="5" />
                                    <Button x:Name="BtnCreateProfile" Grid.Column="1" Content="Create &amp; Initialize Profile" Width="180" Height="30" Margin="10,0,0,0" Click="BtnCreateProfile_Click" Background="#10B981" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 3: HISTORY -->
            <TabItem Header="History" Padding="15,6" FontSize="12" FontWeight="SemiBold">
                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Dates Listbox -->
                    <Border Grid.Column="0" Background="#1E293B" CornerRadius="8" Padding="15" BorderBrush="#334155" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Lịch sử theo ngày" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,10"/>
                            
                            <ListBox Grid.Row="1" x:Name="LboxHistoryDates" ItemsSource="{Binding HistoryDates}" BorderThickness="0" Background="Transparent" 
                                     SelectedIndex="0" SelectionChanged="LboxHistoryDates_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,8" Margin="0,2" CornerRadius="4" BorderThickness="1" BorderBrush="#334155" Background="#0F172A">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📅" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding}" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Button Grid.Row="2" Content="Làm mới (Refresh)" Height="30" Margin="0,10,0,0" Click="BtnRefreshHistory_Click" Background="#2563EB" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
                        </Grid>
                    </Border>

                    <!-- Right: Historical Tasks DataGrid -->
                    <Border Grid.Column="2" Background="#1E293B" CornerRadius="8" Padding="15" BorderBrush="#334155" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Danh sách task đã tạo" FontSize="16" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,0,15"/>
                            
                            <DataGrid Grid.Row="1" x:Name="DgridHistoryTasks" ItemsSource="{Binding HistoryTasks}" AutoGenerateColumns="False" CanUserAddRows="False" 
                                      Background="Transparent" BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      RowHeaderWidth="0" IsReadOnly="True">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Resources>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3B82F6"/>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#334155"/>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White"/>
                                        </Style.Resources>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#334155"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Ngày tạo" Binding="{Binding CreatedAtFormatted}" Width="1.4*"/>
                                    <DataGridTextColumn Header="Link Video (ID)" Binding="{Binding VideoUrl, Converter={StaticResource YoutubeUrlConverter}}" Width="1.6*"/>
                                    <DataGridTextColumn Header="Ngôn ngữ" Binding="{Binding TargetLanguage}" Width="1*"/>
                                    <DataGridTextColumn Header="Voice ID" Binding="{Binding VoiceId}" Width="0.8*"/>
                                    <DataGridTemplateColumn Header="Steps" Width="1.4*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <CheckBox IsChecked="{Binding Step1}" Content="1" Margin="2,0" IsEnabled="False"/>
                                                    <CheckBox IsChecked="{Binding Step2}" Content="2" Margin="2,0" IsEnabled="False"/>
                                                    <CheckBox IsChecked="{Binding Step3}" Content="3" Margin="2,0" IsEnabled="False"/>
                                                    <CheckBox IsChecked="{Binding Step4}" Content="4" Margin="2,0" IsEnabled="False"/>
                                                    <CheckBox IsChecked="{Binding Step5}" Content="5" Margin="2,0" IsEnabled="False"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="1*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="Done">
                                                        <Setter Property="Foreground" Value="#10B981"/>
                                                    </Trigger>
                                                    <Trigger Property="Text" Value="Failed">
                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                    </Trigger>
                                                    <Trigger Property="Text" Value="Pending">
                                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="Action" Width="1.8*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="Logs" Padding="6,3" Margin="2,0" Click="BtnViewHistoryTaskLog_Click" Background="#475569" Foreground="White" BorderThickness="0" FontSize="11"/>
                                                    <Button Content="Assets" Padding="6,3" Margin="2,0" Click="BtnViewHistoryTaskAssets_Click" Background="#10B981" Foreground="White" BorderThickness="0" FontSize="11"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 4: CHATGPT API SERVER -->
            <TabItem Header="ChatGPT API Server" Padding="15,6" FontSize="12" FontWeight="SemiBold">
                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="400"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: API Server Control & Log -->
                    <Border Grid.Column="0" Background="#1E293B" CornerRadius="8" Padding="15" BorderBrush="#334155" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Grid.Row="0" Text="API Server Control" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,10"/>
                            
                            <!-- Status Panel -->
                            <Border Grid.Row="1" Background="#0F172A" Padding="10" CornerRadius="4" Margin="0,0,0,15" BorderBrush="#334155" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Trạng thái:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Ellipse x:Name="ApiStatusIndicator" Width="10" Height="10" Fill="#EF4444" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="TxtApiServerStatus" Text="Đã dừng" Foreground="#EF4444" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Control Buttons -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,15">
                                <Button x:Name="BtnStartApi" Content="Khởi động Server" Width="170" Height="30" Background="#10B981" Foreground="White" BorderThickness="0" FontWeight="Bold" Margin="0,0,10,0" Click="BtnStartApi_Click"/>
                                <Button x:Name="BtnStopApi" Content="Dừng Server" Width="170" Height="30" Background="#EF4444" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="BtnStopApi_Click"/>
                            </StackPanel>

                            <!-- Live Logs -->
                            <Grid Grid.Row="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Logs thực tế (Console)" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,5"/>
                                <TextBox Grid.Row="1" x:Name="TxtApiLogs" Background="#0F172A" Foreground="#34D399" BorderThickness="1" BorderBrush="#334155"
                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsReadOnly="True" FontSize="11" FontFamily="Consolas" AcceptsReturn="True"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Right: ChatGPT Accounts -->
                    <Border Grid.Column="2" Background="#1E293B" CornerRadius="8" Padding="15" BorderBrush="#334155" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Grid.Row="0" Text="Quản lý tài khoản ChatGPT" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,15"/>

                            <!-- Toolbar -->
                            <Grid Grid.Row="1" Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Grid.Column="0">
                                    <TextBlock Text="Gợi ý Email (nếu có):" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="12" Margin="0,0,5,0"/>
                                    <TextBox x:Name="TxtEmailHint" Width="180" Height="26" VerticalContentAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Grid.Column="1">
                                    <Button x:Name="BtnRefreshAccounts" Content="🔄 Làm mới" Width="100" Height="26" Background="#3B82F6" Foreground="White" BorderThickness="0" FontWeight="Bold" Margin="0,0,8,0" Click="BtnRefreshAccounts_Click"/>
                                    <Button x:Name="BtnAddAccount" Content="🔑 Đăng nhập ChatGPT" Width="160" Height="26" Background="#8B5CF6" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="BtnAddAccount_Click"/>
                                </StackPanel>
                            </Grid>

                            <!-- Accounts Table -->
                            <DataGrid Grid.Row="2" x:Name="DgridAccounts" AutoGenerateColumns="False" CanUserAddRows="False"
                                      Background="Transparent" BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      RowHeaderWidth="0" IsReadOnly="True" RowHeight="34" FontSize="12">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Email / Account" Binding="{Binding Email}" Width="2*"/>
                                    <DataGridTextColumn Header="Loại gói" Binding="{Binding Type}" Width="1*"/>
                                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="1*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="normal">
                                                        <Setter Property="Foreground" Value="#10B981"/>
                                                    </Trigger>
                                                    <Trigger Property="Text" Value="limited">
                                                        <Setter Property="Foreground" Value="#F59E0B"/>
                                                    </Trigger>
                                                    <Trigger Property="Text" Value="invalid">
                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Hạn ngạch (Quota)" Binding="{Binding Quota}" Width="1*"/>
                                    <DataGridTextColumn Header="Lần cuối refresh" Binding="{Binding RefreshedAt}" Width="1.5*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
