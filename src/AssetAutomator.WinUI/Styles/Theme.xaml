<?xml version="1.0" encoding="utf-8"?>
<!--
  Theme.xaml
  Stable semantic colour tokens. Themes (Theme.Light.xaml / Theme.Dark.xaml)
  provide the SolidColorBrush values for these keys.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Stable colour values (used by theme brushes). -->
    <Color x:Key="Color.Canvas">#E2E8F0</Color>
    <Color x:Key="Color.CanvasDark">#0C0F1D</Color>
    <Color x:Key="Color.Ink">#0F172A</Color>
    <Color x:Key="Color.InkDark">#FFFFFF</Color>
    <Color x:Key="Color.Body">#1E293B</Color>
    <Color x:Key="Color.BodyDark">#D0D5EE</Color>
    <Color x:Key="Color.Primary">#0F172A</Color>
    <Color x:Key="Color.PrimaryDark">#1E2442</Color>
    <Color x:Key="Color.PrimaryActive">#1E293B</Color>
    <Color x:Key="Color.PrimaryActiveDark">#2A325C</Color>
    <Color x:Key="Color.PrimaryDisabled">#94A3B8</Color>
    <Color x:Key="Color.PrimaryDisabledDark">#3A4A6A</Color>
    <Color x:Key="Color.SurfaceSoft">#CBD5E1</Color>
    <Color x:Key="Color.SurfaceSoftDark">#14192E</Color>
    <Color x:Key="Color.SurfaceCard">#FFFFFF</Color>
    <Color x:Key="Color.SurfaceCardDark">#1E2644</Color>
    <Color x:Key="Color.SurfaceStrong">#94A3B8</Color>
    <Color x:Key="Color.SurfaceStrongDark">#2B355A</Color>
    <Color x:Key="Color.Hairline">#CBD5E1</Color>
    <Color x:Key="Color.HairlineDark">#34406A</Color>
    <Color x:Key="Color.Subtle">#64748B</Color>
    <Color x:Key="Color.SubtleDark">#8B93B0</Color>
    <Color x:Key="Color.MutedSoft">#475569</Color>
    <Color x:Key="Color.MutedSoftDark">#A0A8C5</Color>

    <!-- Semantic status colours (same in both themes). -->
    <Color x:Key="Color.Success">#22C55E</Color>
    <Color x:Key="Color.Warning">#F59E0B</Color>
    <Color x:Key="Color.Danger">#EF4444</Color>
    <Color x:Key="Color.Pending">#475569</Color>
    <Color x:Key="Color.PendingDark">#64748B</Color>
    <Color x:Key="Color.OnAction">#FFFFFF</Color>
</ResourceDictionary>
