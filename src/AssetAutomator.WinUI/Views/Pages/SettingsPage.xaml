<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="AssetAutomator.WinUI.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="PageRoot">

    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">

            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="App Settings" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="Cấu hình hệ thống: API Keys, thư mục lưu trữ và số luồng xử lý." Style="{ThemeResource BodyTextBlockStyle}" Opacity="0.7" />
            </StackPanel>

            <!-- Status message -->
            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Trạng thái Cấu hình:" Message="{Binding StatusMessage}" />

            <!-- Command bar -->
            <CommandBar DefaultLabelPosition="Right" Background="Transparent" IsOpen="False" HorizontalAlignment="Left">
                <AppBarButton Icon="Save" Label="Lưu Cấu Hình" Command="{Binding SaveSettingsCommand}" />
                <AppBarSeparator />
                <AppBarButton Icon="Upload" Label="Xuất Cấu Hình" Command="{Binding ExportSettingsCommand}" />
                <AppBarButton Icon="Download" Label="Nhập Cấu Hình" Command="{Binding ImportSettingsCommand}" />
                <AppBarButton Icon="Repair" Label="Kiểm Tra Hệ Thống" Command="{Binding CheckRequirementsCommand}" />
            </CommandBar>

            <!-- 2 columns layout -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- LEFT: API Keys & Credentials -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="14">
                        <TextBlock Text="API Keys &amp; Credentials" Style="{ThemeResource SubtitleTextBlockStyle}" />

                        <!-- OpenAI / Gemini API Key -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="OpenAI / Gemini API Key" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.7" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="PbApiKey"
                                             Password="{Binding ApiKey, Mode=TwoWay}"
                                             PlaceholderText="sk-..." />
                            </Grid>
                        </StackPanel>

                        <!-- AI84 API Key (with Check Key button) -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="AI84 API Key" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.7" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="PbAi84ApiKey"
                                             Password="{Binding Ai84ApiKey, Mode=TwoWay}"
                                             PlaceholderText="Nhập AI84 API Key..." />
                                <Button Grid.Column="1"
                                        Content="Kiểm tra Key"
                                        Command="{Binding CheckAi84KeyCommand}" />
                            </Grid>
                        </StackPanel>

                        <!-- Supabase DB URL -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Supabase DB URL" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.7" />
                            <PasswordBox x:Name="PbSupabaseDbUrl"
                                         Password="{Binding SupabaseDbUrl, Mode=TwoWay}"
                                         PlaceholderText="https://xyz.supabase.co..." />
                        </StackPanel>

                        <!-- Image API URL -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Image API URL" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.7" />
                            <TextBox Text="{Binding ImageApiUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="http://localhost:8765" />
                        </StackPanel>

                        <!-- Subtitle API URL -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Subtitle API URL" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.7" />
                            <TextBox Text="{Binding SubtitleApiUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="https://...ngrok-free.app/api/transcribe" />
                        </StackPanel>

                        <!-- Image API Key -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Image API Key" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.7" />
                            <PasswordBox x:Name="PbImageApiKey"
                                         Password="{Binding ImageApiKey, Mode=TwoWay}"
                                         PlaceholderText="Nhập API Key cho Image API..." />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- RIGHT: Directories + Concurrency + Engine -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Grid.Column="1">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Directories &amp; Execution" Style="{ThemeResource SubtitleTextBlockStyle}" />

                        <!-- Output folder -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Thư mục xuất kết quả (Output Folder)" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.7" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding OutputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseFolderCommand}" />
                            </Grid>
                        </StackPanel>

                        <!-- Chrome Profiles Dir -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Chrome Profiles Directory" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.7" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding ChromeProfilesDir, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="C:\Path\To\Chrome\User Data" />
                                <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseChromeProfilesDirCommand}" />
                            </Grid>
                        </StackPanel>

                        <!-- Max concurrent threads -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Số luồng chạy song song tối đa (Max Concurrent Threads):" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.7" />
                            <NumberBox Value="{Binding MaxConcurrentThreads, Mode=TwoWay}" Minimum="1" Maximum="16" SmallChange="1" LargeChange="2" Width="140" HorizontalAlignment="Left" />
                        </StackPanel>

                        <CheckBox IsChecked="{Binding EnableHeadless, Mode=TwoWay}" Content="Chạy Trình duyệt ở chế độ An danh / Headless Mode" Margin="0,8,0,0" />

                        <!-- Theme selector -->
                        <StackPanel Spacing="6" Margin="0,8,0,0">
                            <TextBlock Text="Giao diện (Theme)" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.7" />
                            <ComboBox SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" Width="160" HorizontalAlignment="Left">
                                <ComboBoxItem Content="Dark" />
                                <ComboBoxItem Content="Light" />
                                <ComboBoxItem Content="Default" />
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>