<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="AssetAutomator.WinUI.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="PageRoot">

    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">

            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="App Settings" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="Cấu hình hệ thống: API Keys, thư mục lưu trữ và số luồng xử lý." Style="{ThemeResource BodyTextBlockStyle}" Opacity="0.7" />
            </StackPanel>

            <!-- Status message -->
            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Trạng thái Cấu hình:" Message="{Binding StatusMessage}" />

            <!-- Command bar -->
            <CommandBar DefaultLabelPosition="Right" Background="Transparent" IsOpen="False" HorizontalAlignment="Left">
                <AppBarButton Icon="Save" Label="Lưu Cấu Hình" Command="{Binding SaveSettingsCommand}" />
                <AppBarSeparator />
                <AppBarButton Icon="Upload" Label="Xuất Cấu Hình" Command="{Binding ExportSettingsCommand}" />
                <AppBarButton Icon="Download" Label="Nhập Cấu Hình" Command="{Binding ImportSettingsCommand}" />
                <AppBarButton Icon="Repair" Label="Kiểm Tra Hệ Thống" Command="{Binding CheckRequirementsCommand}" />
            </CommandBar>

            <!-- Row 1: 2 cards side-by-side (API Keys & Credentials | Directories & Execution) -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- LEFT: API Keys & Credentials -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="14">
                        <TextBlock Text="API Keys &amp; Credentials" Style="{ThemeResource SubtitleTextBlockStyle}" />

                        <!-- AI84 API Key (with Check Key button) -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="AI84 API Key" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.7" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="PbAi84ApiKey"
                                             PlaceholderText="Nhập AI84 API Key..." />
                                <Button Grid.Column="1"
                                        Content="Kiểm tra Key"
                                        Command="{Binding CheckAi84KeyCommand}" />
                            </Grid>
                        </StackPanel>

                        <!-- Image API URL -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Image API URL" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.7" />
                            <TextBox Text="{Binding ImageApiUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="http://localhost:8765" />
                        </StackPanel>

                        <!-- Subtitle API URL -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Subtitle API URL" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.7" />
                            <TextBox Text="{Binding SubtitleApiUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="https://...ngrok-free.app/api/transcribe" />
                        </StackPanel>

                        <!-- Image API Key -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Image API Key" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.7" />
                            <PasswordBox x:Name="PbImageApiKey"
                                         PlaceholderText="Nhập API Key cho Image API..." />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- RIGHT: Directories + Concurrency + Engine -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Grid.Column="1">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Directories &amp; Execution" Style="{ThemeResource SubtitleTextBlockStyle}" />

                        <!-- Output folder -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Thư mục xuất kết quả (Output Folder)" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.7" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding OutputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseFolderCommand}" />
                            </Grid>
                        </StackPanel>

                        <!-- Batch Image Gen Projects Storage -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Thư mục lưu Projects Batch Image Gen" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.7" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding ProjectsStorageDir, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="C:\AssetAutomator\Projects" />
                                <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseProjectsStorageDirCommand}" />
                            </Grid>
                            <TextBlock Text="Lưu file metadata (.json) của các dự án Batch Image Gen. Ảnh render vẫn dùng Output Folder ở trên."
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Opacity="0.55"
                                       TextWrapping="Wrap"
                                       FontSize="11" />
                        </StackPanel>

                        <!-- Chrome Profiles Dir -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Chrome Profiles Directory" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.7" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding ChromeProfilesDir, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="C:\Path\To\Chrome\User Data" />
                                <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseChromeProfilesDirCommand}" />
                            </Grid>
                        </StackPanel>

                        <!-- Max concurrent threads -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Số luồng chạy song song tối đa (Max Concurrent Threads):" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.7" />
                            <NumberBox Value="{Binding MaxConcurrentThreads, Mode=TwoWay}" Minimum="1" Maximum="16" SmallChange="1" LargeChange="2" Width="140" HorizontalAlignment="Left" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Row 2: 2 cards side-by-side (App & Updates | Google Flow Local Server) -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- LEFT: App & Updates -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="App &amp; Updates" Style="{ThemeResource SubtitleTextBlockStyle}" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="BtnLicense" Click="BtnLicense_Click"
                                    ToolTipService.ToolTip="Quản lý bản quyền ứng dụng">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE192;" FontSize="12" />
                                    <TextBlock Text="Bản Quyền" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnCheckUpdate" Click="BtnCheckUpdate_Click"
                                    ToolTipService.ToolTip="Kiểm tra phiên bản cập nhật mới nhất">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                    <TextBlock Text="Check Update" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <TextBlock Text="Giao diện (Theme):" VerticalAlignment="Center" FontSize="13" />
                            <ToggleSwitch x:Name="ThemeToggle"
                                          OffContent="Light"
                                          OnContent="Dark"
                                          Toggled="ThemeToggle_Toggled" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- RIGHT: Google Flow Local Server -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Grid.Column="1">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B7;" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="Google Flow Local Server" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        </StackPanel>
                        <TextBlock Text="Server Python auto-start cùng app, dùng để generate ảnh bằng tài khoản Google đã đăng nhập."
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Opacity="0.7"
                                   TextWrapping="Wrap" />

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Port" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.7" />
                                <NumberBox Value="{Binding GoogleFlow2Port, Mode=TwoWay}"
                                           Minimum="1024" Maximum="65535"
                                           SmallChange="1" LargeChange="10"
                                           Width="180" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Bottom">
                                <ToggleSwitch Header="Auto-launch on app start"
                                              IsOn="{Binding GoogleFlow2AutoLaunch, Mode=TwoWay}"
                                              OnContent="Bật" OffContent="Tắt" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                                <Button Command="{Binding RestartFlow2Command}" Style="{ThemeResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                        <TextBlock Text="Restart" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding TestFlow2Command}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE73E;" FontSize="12" />
                                        <TextBlock Text="Test" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

        <!-- Row 3: Gemini Watermark Removal (2-column: preview left | controls right) -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="540" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: Before/After preview gallery -->
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B7;" FontSize="14" VerticalAlignment="Center" Foreground="#FF107C10" />
                            <TextBlock Text="Preview kết quả" FontWeight="SemiBold" FontSize="13" />
                            <Border Background="#1A107C10" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="Output thật từ gwr CLI" FontSize="10" Foreground="#FF107C10" />
                            </Border>
                        </StackPanel>

                        <!-- Try-on-your-image: pick file, run gwr, view output -->
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="6"
                                Padding="10">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8E5;" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="Thử trên ảnh của bạn" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>

                                <!-- File picker + Run button + status -->
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding TestImagePath, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="True"
                                             PlaceholderText="Chọn 1 ảnh PNG/JPEG/WebP..."
                                             FontSize="11" />
                                    <Button Grid.Column="1" Content="Browse..."
                                            Command="{Binding PickTestImageCommand}"
                                            ToolTipService.ToolTip="Chọn ảnh từ File Explorer" />
                                    <Button Grid.Column="2"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Command="{Binding RunWatermarkTestCommand}"
                                            IsEnabled="{Binding CanRunWatermarkTest, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE768;" FontSize="11" />
                                            <TextBlock Text="Run Remove" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Progress ring + status -->
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <ProgressRing IsActive="{Binding IsRunningWatermarkTest, Mode=OneWay}"
                                                  Width="14" Height="14" />
                                    <TextBlock Text="{Binding WatermarkTestStatus, Mode=OneWay}"
                                               FontSize="11" Opacity="0.75"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- Result viewer: single After image (centered) -->
                                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="6"
                                        Background="#FF101010"
                                        MinHeight="180">
                                    <Grid>
                                        <Image Source="{Binding TestResultImage, Mode=OneWay}"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                        <Border Background="#CC107C10"
                                                CornerRadius="0,0,0,6"
                                                Padding="8,3"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="AFTER" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                                        </Border>
                                        <TextBlock Text="Chưa có kết quả — chọn ảnh và bấm Run Remove"
                                                   FontSize="11" Opacity="0.5"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding TestResultImage, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                    </StackPanel>

                    <!-- RIGHT: Controls -->
                    <StackPanel Grid.Column="1" Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7C3;" FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="Gemini Watermark Removal" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        </StackPanel>
                        <TextBlock Text="Xóa logo 'Gemini' bằng wiltodelta/remove-ai-watermarks (Python embedded + OpenCV/MI-GAN/LaMa inpainting). Robust với watermark ở mọi vị trí, không phụ thuộc Gemini catalog."
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Opacity="0.7"
                                   TextWrapping="Wrap" />

                        <!-- Master row: Enable | Parallel | Probe -->
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,8">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ToggleSwitch Header="Bật xóa watermark"
                                              IsOn="{Binding EnableWatermarkRemoval, Mode=TwoWay}"
                                              OnContent="Bật" OffContent="Tắt" />
                                <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Left">
                                    <TextBlock Text="Số luồng song song" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.7" />
                                    <NumberBox Value="{Binding WatermarkMaxParallel, Mode=TwoWay}"
                                               Minimum="0" Maximum="8" SmallChange="1" LargeChange="2"
                                               Width="120" HorizontalAlignment="Left" />
                                    <TextBlock Text="(0 = auto theo CPU)" FontSize="10" Opacity="0.55" />
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Command="{Binding CheckWatermarkCliCommand}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        VerticalAlignment="Bottom">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE73E;" FontSize="12" />
                                        <TextBlock Text="Kiểm tra Python &amp; CLI" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- InfoBar explaining the new pipeline -->
                        <InfoBar IsOpen="True" IsClosable="False" Severity="Success"
                                 Title="wiltodelta/remove-ai-watermarks (Python)"
                                 Message="Pipeline mới dùng inpainting (OpenCV / MI-GAN / LaMa). Auto-detect watermark Gemini, không cần cấu hình vị trí. Yêu cầu Python embedded tại tools/PythonEmbed/python.exe (cài qua tools/Scripts/Setup-PythonEmbed.ps1 nếu chưa có)." />

                        <!-- Backend selector + per-image timeout. Region override
                             was removed: wiltodelta's auto-detector is reliable on
                             standard Gemini watermarks, and the user can fall back
                             to the CLI manually if a rare layout fails. -->
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE713;" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="Tùy chọn nâng cao" FontWeight="SemiBold" FontSize="12" />
                                </StackPanel>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Backend selector -->
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Inpainting backend" FontSize="11" Opacity="0.7" />
                                        <ComboBox SelectedItem="{Binding WatermarkInpaintBackend, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch"
                                                  ToolTipService.ToolTip="auto: best installed backend (LaMa > MI-GAN > cv2). cv2: classical OpenCV, nhanh, không cần model. migan: ONNX learned, ~1GB. lama: ONNX learned, ~4.7GB, chất lượng tốt nhất.">
                                            <x:String>auto</x:String>
                                            <x:String>cv2</x:String>
                                            <x:String>migan</x:String>
                                            <x:String>lama</x:String>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Per-image timeout -->
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Timeout mỗi ảnh (giây)" FontSize="11" Opacity="0.7" />
                                        <NumberBox Value="{Binding WatermarkPerImageTimeoutSec, Mode=TwoWay}"
                                                   Minimum="10" Maximum="600" SmallChange="10" LargeChange="30"
                                                   SpinButtonPlacementMode="Inline" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
