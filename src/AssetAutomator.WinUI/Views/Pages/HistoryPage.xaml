<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="AssetAutomator.WinUI.Views.Pages.HistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="Task Execution History"
                       Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock Text="Nhật ký chi tiết các lần chạy tác vụ tự động hóa."
                       Style="{ThemeResource BodyTextBlockStyle}"
                       Opacity="0.7" />
        </StackPanel>

        <!-- Command bar & status -->
        <StackPanel Grid.Row="1" Spacing="8" Margin="0,0,0,12">
            <CommandBar DefaultLabelPosition="Right"
                        Background="Transparent"
                        IsOpen="False"
                        HorizontalAlignment="Left">
                <AppBarButton Icon="Refresh" Label="Tải lại Lịch sử" Command="{Binding LoadHistoryCommand}" />
                <AppBarButton Icon="Delete" Label="Xóa Lịch sử" Command="{Binding ClearHistoryCommand}" />
            </CommandBar>
            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Nhật ký:" Message="{Binding StatusText}" />
        </StackPanel>

        <!-- History ListView -->
        <Border Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
            <ListView ItemsSource="{Binding HistoryEntries}"
                      SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                      SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding Id}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding VideoUrl}" Opacity="0.8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding CreatedAtFormatted}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding Status}" Foreground="LightGreen" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="{Binding Logs}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>