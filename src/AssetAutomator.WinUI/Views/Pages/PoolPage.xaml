<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="AssetAutomator.WinUI.Views.Pages.PoolPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:models="using:AssetAutomator.Core.Models">

    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">

            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="Image Pool &amp; Asset Library" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="Quản lý tiến độ sinh ảnh tự động và kho tài nguyên ảnh đã hoàn thành." Style="{ThemeResource BodyTextBlockStyle}" Opacity="0.7" />
            </StackPanel>

            <!-- Status message -->
            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Trạng thái Pool:" Message="{Binding StatusText}" />

            <!-- 6 Metric Cards (A5) -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Card 1: Workers -->
                <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Workers (Active/Max)" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding RunningWorkers}" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource SystemAccentColor}" />
                            <TextBlock Text="/" FontSize="16" Opacity="0.5" />
                            <TextBlock Text="{Binding MaxWorkers}" FontSize="16" FontWeight="Bold" Opacity="0.8" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Card 2: Waiting -->
                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Đang chờ (Waiting)" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding WaitingRequests}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Card 3: Processing -->
                <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Đang tạo (Processing)" FontSize="11" Foreground="{ThemeResource SystemAccentColor}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding ProcessingRequests}" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource SystemAccentColor}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Card 4: Finished -->
                <Border Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Hoàn thành" FontSize="11" Foreground="LightGreen" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding FinishedRequests}" FontSize="18" FontWeight="Bold" Foreground="LightGreen" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Card 5: Avg Time -->
                <Border Grid.Column="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Thời gian TB (s)" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding AvgTimeSeconds}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Card 6: Total Items -->
                <Border Grid.Column="5" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Tổng số ảnh" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding TotalImagesCount}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Search bar & Action bar (A6) -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="🔍 Tìm kiếm theo Prompt hoặc tên file..." />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Tổng cộng:" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ImageItems.Count}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock Text="ảnh" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                    </StackPanel>

                    <Button Grid.Column="2" Style="{ThemeResource AccentButtonStyle}" Command="{Binding RefreshPoolCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="12" />
                            <TextBlock Text="Tải lại Kho Ảnh" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Pool Requests ListView / DataGrid (A20) -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    MinHeight="320">
                <ListView ItemsSource="{Binding ImageItems}"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          SelectionMode="Single">
                    <ListView.HeaderTemplate>
                        <DataTemplate>
                            <Grid Padding="12,8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Phong Cách" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Prompt Mô Tả" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="Tên Tệp / Đường Dẫn" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="Trạng Thái" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="Thao Tác" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.HeaderTemplate>

                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:BatchImageItem">
                            <Grid Padding="12,8" RowSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{x:Bind Engine}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Prompt}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{x:Bind ImagePath}" FontFamily="Consolas" FontSize="11" Opacity="0.7" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Status}" FontWeight="SemiBold" VerticalAlignment="Center" />

                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button ToolTipService.ToolTip="Mở Ảnh" Padding="6,4" Click="BtnOpenImage_Click">
                                        <FontIcon Glyph="&#xE8B9;" FontSize="11" />
                                    </Button>
                                    <Button ToolTipService.ToolTip="Hủy Yêu Cầu" Padding="6,4" Click="BtnCancelRequest_Click">
                                        <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="LightCoral" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>