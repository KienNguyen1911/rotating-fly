<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="AssetAutomator.WinUI.Views.Pages.TasksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:models="using:AssetAutomator.Core.Models"
      x:Name="PageRoot">

    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">

            <!-- Header & Metrics -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Automation Task Queue" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock Text="Quản lý và điều hành các tác vụ tự động hóa video." Style="{ThemeResource BodyTextBlockStyle}" Opacity="0.7" />
                </StackPanel>

                <!-- Metric Cards -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14,8" MinWidth="100">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Tổng tác vụ" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding TotalTasks}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14,8" MinWidth="100">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Đang chạy" FontSize="11" Foreground="{ThemeResource SystemAccentColor}" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding RunningCount}" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource SystemAccentColor}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14,8" MinWidth="100">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Hoàn thành" FontSize="11" Foreground="LightGreen" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding CompletedCount}" FontSize="20" FontWeight="Bold" Foreground="LightGreen" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14,8" MinWidth="100">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Thất bại" FontSize="11" Foreground="LightCoral" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding FailedCount}" FontSize="20" FontWeight="Bold" Foreground="LightCoral" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Status message InfoBar -->
            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Trạng thái:" Message="{Binding StatusMessage}" />

            <!-- Command Bar & Step Checkboxes -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="14">

                    <!-- Actions Command Bar -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Style="{ThemeResource AccentButtonStyle}" Command="{Binding CreateTaskCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                                    <TextBlock Text="Tạo Task Mới" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding CreateBulkTaskCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8B9;" FontSize="12" />
                                    <TextBlock Text="Tạo Nhiều Task (Bulk)" />
                                </StackPanel>
                            </Button>
                            <Button Style="{ThemeResource AccentButtonStyle}" Command="{Binding StartTaskCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE768;" FontSize="12" />
                                    <TextBlock Text="Chạy Task Đã Chọn" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding StopTaskCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE71A;" FontSize="12" />
                                    <TextBlock Text="Hủy Tác Vụ" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Button Grid.Column="1" Command="{Binding RefreshTasksCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                <TextBlock Text="Tải lại Danh Sách" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <MenuFlyoutSeparator />

                    <!-- Step Selector Checkboxes (A1) -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="⚙️ Chọn các bước tự động hóa sẽ thực thi:" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.7" />
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <CheckBox IsChecked="{Binding StepDownloadThumbnail, Mode=TwoWay}" Content="1. Download Thumbnail" />
                            <CheckBox IsChecked="{Binding StepGenerateThumbnail, Mode=TwoWay}" Content="2. Generate Thumbnail" />
                            <CheckBox IsChecked="{Binding StepGetTranscript, Mode=TwoWay}" Content="3. Get Transcript" />
                            <CheckBox IsChecked="{Binding StepRewrittenTranscript, Mode=TwoWay}" Content="4. Rewritten Transcript" />
                            <CheckBox IsChecked="{Binding StepVoiceover, Mode=TwoWay}" Content="5. Voiceover" />
                            <CheckBox IsChecked="{Binding StepSrt, Mode=TwoWay}" Content="6. SRT Subtitle" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Filter Bar (A2, A3) -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="🔍 Bộ lọc tìm kiếm &amp; trạng thái lỗi:" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.7" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" Text="{Binding FilterVideoUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Lọc theo Link / Title..." />
                        <TextBox Grid.Column="1" Text="{Binding FilterLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Ngôn ngữ..." />
                        <TextBox Grid.Column="2" Text="{Binding FilterVoiceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Voice ID..." />

                        <Button Grid.Column="3" Content="Xóa Lọc" Click="BtnClearFilters_Click" />
                    </Grid>

                    <!-- Filter Failure Step Checkboxes -->
                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                        <TextBlock Text="Lỗi tại step:" VerticalAlignment="Center" FontSize="12" Opacity="0.6" />
                        <CheckBox IsChecked="{Binding FilterStepT, Mode=TwoWay}" Content="Thumbnail (T)" FontSize="12" />
                        <CheckBox IsChecked="{Binding FilterStepR, Mode=TwoWay}" Content="Rewrite (R)" FontSize="12" />
                        <CheckBox IsChecked="{Binding FilterStepW, Mode=TwoWay}" Content="Voiceover (W)" FontSize="12" />
                        <CheckBox IsChecked="{Binding FilterStepV, Mode=TwoWay}" Content="Voice (V)" FontSize="12" />
                        <CheckBox IsChecked="{Binding FilterStepS, Mode=TwoWay}" Content="SRT (S)" FontSize="12" />
                        <CheckBox IsChecked="{Binding FilterStepG, Mode=TwoWay}" Content="Gen Image (G)" FontSize="12" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Tasks ListView / DataGrid (A4) -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    MinHeight="300">
                <ListView ItemsSource="{Binding Tasks}"
                          SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                          SelectionMode="Single">
                    <ListView.HeaderTemplate>
                        <DataTemplate>
                            <Grid Padding="12,8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="ChkSelectAll" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="Task ID" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="Video Link / Chi tiết" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="Voice / Lang" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="Trạng Thái" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="5" Text="Thao Tác" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.HeaderTemplate>

                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:AutomationTask">
                            <Grid Padding="12,8" RowSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Id}" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind VideoUrl}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind SelectedProfile}" FontSize="11" Opacity="0.6" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind TargetLanguage}" FontSize="12" />
                                    <TextBlock Text="{x:Bind VoiceId}" FontSize="11" Opacity="0.6" FontFamily="Consolas" />
                                </StackPanel>
                                <TextBlock Grid.Column="4" Text="{x:Bind Status}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                
                                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button ToolTipService.ToolTip="Chạy task" Padding="6,4" Click="BtnRunSingle_Click">
                                        <FontIcon Glyph="&#xE768;" FontSize="11" />
                                    </Button>
                                    <Button ToolTipService.ToolTip="Xem Log" Padding="6,4" Click="BtnViewLog_Click">
                                        <FontIcon Glyph="&#xE9D9;" FontSize="11" />
                                    </Button>
                                    <Button ToolTipService.ToolTip="Mở thư mục Assets" Padding="6,4" Click="BtnOpenAssets_Click">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="11" />
                                    </Button>
                                    <Button ToolTipService.ToolTip="Xóa Task" Padding="6,4" Click="BtnDeleteSingle_Click">
                                        <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="LightCoral" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>