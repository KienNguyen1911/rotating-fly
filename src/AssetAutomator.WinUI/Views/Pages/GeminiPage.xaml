<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="AssetAutomator.WinUI.Views.Pages.GeminiPage"
      x:Name="PageRoot"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:models="using:AssetAutomator.Core.Models"
      xmlns:converters="using:AssetAutomator.WinUI.Converters"
      xmlns:controls="using:AssetAutomator.WinUI.Controls"
      mc:Ignorable="d">

    <Page.Resources>
        <converters:NodeStatusToBrushConverter x:Key="NodeStatusToBrushConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InvertBoolConverter x:Key="InvertBoolConverter" />
        <converters:StringToImageSourceConverter x:Key="StringToImageSourceConverter" />
        <converters:StepStatusToTextConverter x:Key="StepStatusToTextConverter" />

        <!-- Row cell template helper: badge with brush -->
        <Style x:Key="StatusBadgeBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,3" />
        </Style>
    </Page.Resources>

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Gemini AI Creator"
                           Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="Hàng đợi tác vụ Gemini: chạy nhiều task kịch bản &amp; video song song."
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Opacity="0.7" />
            </StackPanel>

            <!-- View toggles: bottom console log -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <ToggleButton x:Name="BtnToggleConsolePanel"
                              IsChecked="{x:Bind ViewModel.IsConsoleLogVisible, Mode=TwoWay}"
                              ToolTipService.ToolTip="Ẩn / hiện Console Logs"
                              Width="32" Height="32" Padding="0">
                    <FontIcon Glyph="&#xE756;" FontSize="13" />
                </ToggleButton>
            </StackPanel>
        </Grid>

        <!-- C1: Toolbar with 6 buttons (single row, more compact) -->
        <Border Grid.Row="1"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Command="{x:Bind ViewModel.AddTaskCommand}" ToolTipService.ToolTip="Thêm task mới">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                            <TextBlock Text="Thêm Task" />
                        </StackPanel>
                    </Button>

                    <Button Command="{x:Bind ViewModel.DeleteSelectedTasksCommand}" ToolTipService.ToolTip="Xóa các task đã chọn">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74D;" FontSize="12" />
                            <TextBlock Text="Xóa Đã Chọn" />
                        </StackPanel>
                    </Button>

                    <AppBarSeparator />

                    <Button Command="{x:Bind ViewModel.SuggestTopicsCommand}"
                            IsEnabled="{x:Bind ViewModel.HasSelectedTask, Mode=OneWay}"
                            ToolTipService.ToolTip="Gợi ý chủ đề từ channel">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE721;" FontSize="12" />
                            <TextBlock Text="Gợi Ý Chủ Đề" />
                        </StackPanel>
                    </Button>

                    <Button Command="{x:Bind ViewModel.RefreshGemsCommand}"
                            IsEnabled="{x:Bind ViewModel.IsLoadingGems, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}"
                            ToolTipService.ToolTip="Tải lại danh sách Gemini Gems">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="12" />
                            <TextBlock Text="Tải Gems" />
                            <ProgressRing IsActive="{x:Bind ViewModel.IsLoadingGems, Mode=OneWay}"
                                          Width="14" Height="14" />
                        </StackPanel>
                    </Button>

                    <Button Command="{x:Bind ViewModel.ImportCookiesCommand}"
                            IsEnabled="{x:Bind ViewModel.IsImportingCookies, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}"
                            ToolTipService.ToolTip="Nạp cookies Gemini từ Chrome profiles">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE192;" FontSize="12" />
                            <TextBlock Text="Nạp Cookies" />
                            <ProgressRing IsActive="{x:Bind ViewModel.IsImportingCookies, Mode=OneWay}"
                                          Width="14" Height="14" />
                        </StackPanel>
                    </Button>

                    <AppBarSeparator />

                    <NumberBox Value="{x:Bind ViewModel.VideoDurationMinutes, Mode=TwoWay}"
                               Minimum="1"
                               Maximum="60"
                               PlaceholderText="📹 Phút"
                               ToolTipService.ToolTip="Thời lượng video mục tiêu (Phút)"
                               VerticalAlignment="Center"
                               Width="115"
                               SpinButtonPlacementMode="Compact" />
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{ThemeResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.RunSelectedTasksCommand}"
                        VerticalAlignment="Center"
                        Height="36"
                        Padding="16,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE768;" FontSize="14" />
                        <TextBlock Text="🚀 CHẠY TASK ĐÃ CHỌN" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- C2: Tasks queue (Full Width 100%) + Task Live Logs Drawer Overlay -->
        <Grid Grid.Row="2">
            <!-- LEFT / FULL WIDTH: Tasks queue -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header row (7 columns) -->
                    <Grid Grid.Row="0"
                          Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                          Padding="12,8"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="2.5*" />
                            <ColumnDefinition Width="1.6*" />
                            <ColumnDefinition Width="1.8*" />
                            <ColumnDefinition Width="1.8*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1.4*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0"
                                  IsChecked="{x:Bind ViewModel.SelectAllTasks, Mode=TwoWay}"
                                  ToolTipService.ToolTip="Chọn tất cả" />
                        <TextBlock Grid.Column="1" Text="Chủ Đề / Link YouTube" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="Tiến Trình" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="🎬 Scriptwriter" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="🎭 Scene Creator" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="5" Text="Trạng Thái" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="6" Text="Thao Tác" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Tasks list -->
                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.GeminiTasks, Mode=OneWay}"
                              SelectionMode="Single"
                              SelectedItem="{x:Bind ViewModel.SelectedTask, Mode=TwoWay}"
                              x:Name="LstGeminiTasks">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:GeminiTaskModel">
                                <Grid Padding="12,8" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="2.5*" />
                                        <ColumnDefinition Width="1.6*" />
                                        <ColumnDefinition Width="1.8*" />
                                        <ColumnDefinition Width="1.8*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1.4*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 1. Select -->
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                              VerticalAlignment="Center" />

                                    <!-- 2. Topic -->
                                    <TextBox Grid.Column="1"
                                             Text="{x:Bind Topic, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="Nhập chủ đề hoặc link YouTube..."
                                             AcceptsReturn="False"
                                             TextWrapping="NoWrap"
                                             VerticalAlignment="Center" />

                                    <!-- 3. Progress -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                        <ProgressBar Value="{x:Bind ProgressPercent, Mode=OneWay}"
                                                     Maximum="100"
                                                     Height="6" />
                                        <TextBlock Text="{x:Bind ProgressText, Mode=OneWay}"
                                                   FontSize="10"
                                                   Opacity="0.7" />
                                    </StackPanel>

                                    <!-- 4. Scriptwriter badge -->
                                    <TextBlock Grid.Column="3"
                                               Text="{x:Bind ScriptwriterSummary, Mode=OneWay}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />

                                    <!-- 5. Scene Creator badge -->
                                    <TextBlock Grid.Column="4"
                                               Text="{x:Bind SceneCreatorSummary, Mode=OneWay}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />

                                    <!-- 6. Status badge -->
                                    <Border Grid.Column="5"
                                            Background="{x:Bind Status, Converter={StaticResource NodeStatusToBrushConverter}}"
                                            Style="{StaticResource StatusBadgeBorderStyle}"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{x:Bind StatusBadge, Mode=OneWay}"
                                                   Foreground="White"
                                                   FontSize="10"
                                                   FontWeight="SemiBold" />
                                    </Border>

                                    <!-- 7. Actions -->
                                    <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button Command="{Binding ViewModel.RunSingleTaskCommand, ElementName=LstGeminiTasks}"
                                                CommandParameter="{x:Bind}"
                                                ToolTipService.ToolTip="Chạy task này"
                                                Padding="6,4">
                                            <FontIcon Glyph="&#xE768;" FontSize="11" />
                                        </Button>
                                        <Button Click="BtnShowRowDetails_Click"
                                                Tag="{x:Bind}"
                                                ToolTipService.ToolTip="Mở cấu hình chi tiết"
                                                Padding="6,4">
                                            <FontIcon Glyph="&#xE713;" FontSize="11" />
                                        </Button>
                                        <Button Click="BtnShowTaskLogs_Click"
                                                Tag="{x:Bind}"
                                                ToolTipService.ToolTip="Xem log tiến trình task (5 bước)"
                                                Padding="6,4">
                                            <FontIcon Glyph="&#xE9D9;" FontSize="11" />
                                        </Button>
                                        <Button Command="{Binding ViewModel.DeleteSingleTaskCommand, ElementName=PageRoot}"
                                                CommandParameter="{x:Bind}"
                                                ToolTipService.ToolTip="Xóa task này"
                                                Padding="6,4">
                                            <FontIcon Glyph="&#xE74D;" FontSize="11" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- BOTTOM DRAWER: Task Configuration Drawer (Slide Up/Down) -->
            <Border x:Name="TaskDetailsDrawer"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Stretch"
                    MaxHeight="460"
                    Canvas.ZIndex="120"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,2,1,1"
                    CornerRadius="14,14,0,0"
                    Padding="16,12"
                    Visibility="{x:Bind ViewModel.IsRowDetailsDrawerOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="TaskDetailsDrawerTransform" Y="0" />
                </Border.RenderTransform>
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Drawer Header -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE713;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="TxtTaskDetailsDrawerTitle"
                                       Text="⚙️ Cấu Hình Chi Tiết Task"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Click="BtnCloseTaskDetailsDrawer_Click"
                                ToolTipService.ToolTip="Đóng bảng cấu hình"
                                Padding="6,2"
                                Height="28" Width="28">
                            <FontIcon Glyph="&#xE711;" FontSize="11" />
                        </Button>
                    </Grid>

                    <!-- Scrollable Content Host -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ContentControl x:Name="TaskDetailsContentHost" HorizontalContentAlignment="Stretch" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- RIGHT: Drawer Overlay — Task Live Logs (5-step accordion for SelectedTask) -->
            <Border x:Name="TaskLogsDrawer"
                    HorizontalAlignment="Right"
                    Width="{x:Bind ViewModel.TaskLogsDrawerWidth, Mode=OneWay}"
                    Canvas.ZIndex="100"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="2,1,1,1"
                    CornerRadius="8,0,0,8"
                    Padding="12"
                    Visibility="{x:Bind ViewModel.IsTaskLogsDrawerOpen, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <!-- Left Resize Drag Handle -->
                    <controls:ResizableDragHandle Width="8"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Stretch"
                                                  Margin="-12,-12,0,-12"
                                                  Background="Transparent"
                                                  PointerPressed="DrawerDragHandle_PointerPressed"
                                                  PointerMoved="DrawerDragHandle_PointerMoved"
                                                  PointerReleased="DrawerDragHandle_PointerReleased"
                                                  Canvas.ZIndex="10" />

                    <Grid RowSpacing="10" Margin="4,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                    <!-- Drawer Header -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE9D9;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Task Live Logs"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{x:Bind ViewModel.CloseTaskLogsCommand}"
                                ToolTipService.ToolTip="Đóng log drawer"
                                Padding="6,2"
                                Height="28" Width="28">
                            <FontIcon Glyph="&#xE711;" FontSize="11" />
                        </Button>
                    </Grid>

                    <!-- Selected Task Title Banner -->
                    <Border Grid.Row="1"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,6">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="📌 Task:" FontSize="11" Opacity="0.7" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedTaskTopic, Mode=OneWay}"
                                       FontWeight="SemiBold"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- 5-Step Accordion -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="8">
                            <!-- Step 1: Gemini Deep Research & Script -->
                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Expander x:Name="ExpanderStep1" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <Expander.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Step 1: Gemini Deep Research &amp; Script"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                            <Border x:Name="BadgeStep1"
                                                    Grid.Column="1"
                                                    CornerRadius="10"
                                                    Padding="8,2"
                                                    Background="{x:Bind ViewModel.CurrentStep1Status, Mode=OneWay, Converter={StaticResource NodeStatusToBrushConverter}}">
                                                <TextBlock Text="{x:Bind ViewModel.CurrentStep1Status, Mode=OneWay, Converter={StaticResource StepStatusToTextConverter}}"
                                                           Foreground="White"
                                                           FontSize="10"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                    </Expander.Header>
                                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,4,0,0">
                                        <TextBlock Text="{x:Bind ViewModel.CurrentStep1Log, Mode=OneWay}"
                                                   FontFamily="Consolas"
                                                   FontSize="10"
                                                   TextWrapping="NoWrap" />
                                    </ScrollViewer>
                                </Expander>
                            </Border>

                            <!-- Step 2: Voiceover & SRT Subtitles -->
                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Expander x:Name="ExpanderStep2" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <Expander.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Step 2: Voiceover &amp; SRT Subtitles"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                            <Border x:Name="BadgeStep2"
                                                    Grid.Column="1"
                                                    CornerRadius="10"
                                                    Padding="8,2"
                                                    Background="{x:Bind ViewModel.CurrentStep2Status, Mode=OneWay, Converter={StaticResource NodeStatusToBrushConverter}}">
                                                <TextBlock Text="{x:Bind ViewModel.CurrentStep2Status, Mode=OneWay, Converter={StaticResource StepStatusToTextConverter}}"
                                                           Foreground="White"
                                                           FontSize="10"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                    </Expander.Header>
                                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,4,0,0">
                                        <TextBlock Text="{x:Bind ViewModel.CurrentStep2Log, Mode=OneWay}"
                                                   FontFamily="Consolas"
                                                   FontSize="10"
                                                   TextWrapping="NoWrap" />
                                    </ScrollViewer>
                                </Expander>
                            </Border>

                            <!-- Step 3: Scene Breakdown & Prompts -->
                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Expander x:Name="ExpanderStep3" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <Expander.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Step 3: Scene Breakdown &amp; Prompts"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                            <Border x:Name="BadgeStep3"
                                                    Grid.Column="1"
                                                    CornerRadius="10"
                                                    Padding="8,2"
                                                    Background="{x:Bind ViewModel.CurrentStep3Status, Mode=OneWay, Converter={StaticResource NodeStatusToBrushConverter}}">
                                                <TextBlock Text="{x:Bind ViewModel.CurrentStep3Status, Mode=OneWay, Converter={StaticResource StepStatusToTextConverter}}"
                                                           Foreground="White"
                                                           FontSize="10"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                    </Expander.Header>
                                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,4,0,0">
                                        <TextBlock Text="{x:Bind ViewModel.CurrentStep3Log, Mode=OneWay}"
                                                   FontFamily="Consolas"
                                                   FontSize="10"
                                                   TextWrapping="NoWrap" />
                                    </ScrollViewer>
                                </Expander>
                            </Border>

                            <!-- Step 4: Batch Image Generation -->
                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Expander x:Name="ExpanderStep4" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <Expander.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Step 4: Batch Image Generation"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                            <Border x:Name="BadgeStep4"
                                                    Grid.Column="1"
                                                    CornerRadius="10"
                                                    Padding="8,2"
                                                    Background="{x:Bind ViewModel.CurrentStep4Status, Mode=OneWay, Converter={StaticResource NodeStatusToBrushConverter}}">
                                                <TextBlock Text="{x:Bind ViewModel.CurrentStep4Status, Mode=OneWay, Converter={StaticResource StepStatusToTextConverter}}"
                                                           Foreground="White"
                                                           FontSize="10"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                    </Expander.Header>
                                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,4,0,0">
                                        <TextBlock Text="{x:Bind ViewModel.CurrentStep4Log, Mode=OneWay}"
                                                   FontFamily="Consolas"
                                                   FontSize="10"
                                                   TextWrapping="NoWrap" />
                                    </ScrollViewer>
                                </Expander>
                            </Border>

                            <!-- Step 5: Export & Packaging -->
                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Expander x:Name="ExpanderStep5" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <Expander.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Step 5: Export &amp; Packaging"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                            <Border x:Name="BadgeStep5"
                                                    Grid.Column="1"
                                                    CornerRadius="10"
                                                    Padding="8,2"
                                                    Background="{x:Bind ViewModel.CurrentStep5Status, Mode=OneWay, Converter={StaticResource NodeStatusToBrushConverter}}">
                                                <TextBlock Text="{x:Bind ViewModel.CurrentStep5Status, Mode=OneWay, Converter={StaticResource StepStatusToTextConverter}}"
                                                           Foreground="White"
                                                           FontSize="10"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                    </Expander.Header>
                                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,4,0,0">
                                        <TextBlock Text="{x:Bind ViewModel.CurrentStep5Log, Mode=OneWay}"
                                                   FontFamily="Consolas"
                                                   FontSize="10"
                                                   TextWrapping="NoWrap" />
                                    </ScrollViewer>
                                </Expander>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
        </Grid>

        <!-- C4 + C5: Console log + actions (collapsible, default hidden) -->
        <Border Grid.Row="3"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,12,0,0"
                Visibility="{x:Bind ViewModel.IsConsoleLogVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="📋 Console Logs"
                               FontWeight="SemiBold"
                               FontSize="12"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <ProgressRing IsActive="{x:Bind ViewModel.IsGenerating, Mode=OneWay}"
                                      Width="16" Height="16"
                                      Visibility="{x:Bind ViewModel.IsGenerating, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <Button Command="{x:Bind ViewModel.CancelGenerationCommand}"
                                IsEnabled="{x:Bind ViewModel.IsGenerating, Mode=OneWay}"
                                ToolTipService.ToolTip="Hủy pipeline đang chạy">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE71A;" FontSize="11" />
                                <TextBlock Text="Hủy" />
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind ViewModel.RunSelectedTasksCommand}"
                                Style="{ThemeResource AccentButtonStyle}"
                                ToolTipService.ToolTip="Chạy các task đã chọn">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE768;" FontSize="11" />
                                <TextBlock Text="Chạy" />
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind ViewModel.ClearLogsCommand}"
                                ToolTipService.ToolTip="Xóa logs">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE74D;" FontSize="11" />
                                <TextBlock Text="Xóa Logs" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              MaxHeight="180"
                              Margin="0,8,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <TextBlock Text="{x:Bind ViewModel.ConsoleLogs, Mode=OneWay}"
                               FontFamily="Consolas"
                               FontSize="11"
                               TextWrapping="NoWrap" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Hidden named Flyout for showing row details (positioned from code-behind) -->
        <Grid x:Name="RowDetailsHost" />
    </Grid>
</Page>
