<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="AssetAutomator.WinUI.Views.Pages.GeminiPage"
      x:Name="PageRoot"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:models="using:AssetAutomator.Core.Models"
      xmlns:converters="using:AssetAutomator.WinUI.Converters"
      xmlns:controls="using:AssetAutomator.WinUI.Controls"
      mc:Ignorable="d"
      NavigationCacheMode="Required">

    <Page.Resources>
        <converters:NodeStatusToBrushConverter x:Key="NodeStatusToBrushConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InvertBoolConverter x:Key="InvertBoolConverter" />
        <converters:StringToImageSourceConverter x:Key="StringToImageSourceConverter" />
        <converters:StepStatusToTextConverter x:Key="StepStatusToTextConverter" />
        <converters:NullableToBoolConverter x:Key="NullableToBoolConverter" />
        <converters:DetailTabToBoolConverter x:Key="DetailTabToBoolConverter" />
        <converters:DetailTabToVisibilityConverter x:Key="DetailTabToVisibilityConverter" />
        <converters:DoubleToGridLengthConverter x:Key="DoubleToGridLengthConverter" />
        <converters:BoolToGridLengthConverter x:Key="BoolToGridLengthConverter" />
        <converters:BoolToDoubleConverter x:Key="BoolToDoubleConverter" />

        <!-- Row cell template helper: badge with brush -->
        <Style x:Key="StatusBadgeBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,3" />
        </Style>

        <!-- ReadOnly console log style so users can select + Ctrl+C / right-click copy -->
        <Style x:Key="StepLogTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>
    </Page.Resources>

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Gemini AI Creator"
                           Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="Hàng đợi tác vụ Gemini: chạy nhiều task kịch bản &amp; video song song."
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Opacity="0.7" />
                <!-- Status bar — mirrors WPF TxtGeminiStatusIcon + TxtGeminiStatus so the
                     user can see lifecycle messages that only update ViewModel.StatusLog
                     (not ConsoleLogs, which only receives entries from ILogService). -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtGeminiStatusIcon"
                               Text="💡"
                               FontSize="13"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtGeminiStatus"
                               Text="{x:Bind ViewModel.StatusLog, Mode=OneWay}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

            <!-- View toggles: bottom console log -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <ToggleButton x:Name="BtnToggleConsolePanel"
                              IsChecked="{x:Bind ViewModel.IsConsoleLogVisible, Mode=TwoWay}"
                              ToolTipService.ToolTip="Ẩn / hiện Console Logs"
                              Width="32" Height="32" Padding="0">
                    <FontIcon Glyph="&#xE756;" FontSize="13" />
                </ToggleButton>
            </StackPanel>
        </Grid>

        <!-- C1: Toolbar with 6 buttons (single row, more compact) -->
        <Border Grid.Row="1"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Command="{x:Bind ViewModel.AddTaskCommand}" ToolTipService.ToolTip="Thêm task mới">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                            <TextBlock Text="Thêm Task" />
                        </StackPanel>
                    </Button>

                    <Button Command="{x:Bind ViewModel.BulkAddTasksCommand}" ToolTipService.ToolTip="Thêm hàng loạt (kế thừa config nếu đang chọn task)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8D5;" FontSize="12" />
                            <TextBlock Text="Thêm Hàng Loạt" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnManageProfiles"
                            Click="BtnManageProfiles_Click"
                            ToolTipService.ToolTip="Quản lý &amp; tạo Task Profiles">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE713;" FontSize="12" />
                            <TextBlock Text="Profiles" />
                        </StackPanel>
                    </Button>

                    <Button Command="{x:Bind ViewModel.DeleteSelectedTasksCommand}" ToolTipService.ToolTip="Xóa các task đã chọn">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74D;" FontSize="12" />
                            <TextBlock Text="Xóa Đã Chọn" />
                        </StackPanel>
                    </Button>

                    <AppBarSeparator />

                    <Button Command="{x:Bind ViewModel.SuggestTopicsCommand}"
                            IsEnabled="{x:Bind ViewModel.HasSelectedTask, Mode=OneWay}"
                            ToolTipService.ToolTip="Gợi ý chủ đề từ channel">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE721;" FontSize="12" />
                            <TextBlock Text="Gợi Ý Chủ Đề" />
                        </StackPanel>
                    </Button>

                    <Button Command="{x:Bind ViewModel.RefreshGemsCommand}"
                            IsEnabled="{x:Bind ViewModel.IsLoadingGems, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}"
                            ToolTipService.ToolTip="Tải lại danh sách Gemini Gems">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="12" />
                            <TextBlock Text="Tải Gems" />
                            <ProgressRing IsActive="{x:Bind ViewModel.IsLoadingGems, Mode=OneWay}"
                                          Width="14" Height="14" />
                        </StackPanel>
                    </Button>

                    <Button Command="{x:Bind ViewModel.ImportCookiesCommand}"
                            IsEnabled="{x:Bind ViewModel.IsImportingCookies, Mode=OneWay, Converter={StaticResource InvertBoolConverter}}"
                            ToolTipService.ToolTip="Nạp cookies Gemini từ Chrome profiles">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE192;" FontSize="12" />
                            <TextBlock Text="Nạp Cookies" />
                            <ProgressRing IsActive="{x:Bind ViewModel.IsImportingCookies, Mode=OneWay}"
                                          Width="14" Height="14" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{ThemeResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.RunSelectedTasksCommand}"
                        VerticalAlignment="Center"
                        Height="36"
                        Padding="16,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE768;" FontSize="14" />
                        <TextBlock Text="🚀 CHẠY TASK ĐÃ CHỌN" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- C2: Master-Detail layout: Tasks list (left) + Detail Panel (right) with Config/Logs tabs.
             Replaces the old dual-overlay-drawer pattern. The detail panel is a true layout
             cell (not an overlay), so it never blocks the task list and the list stays usable
             while the user is configuring or watching logs for a selected task. -->
        <Grid Grid.Row="2" ColumnSpacing="{x:Bind ViewModel.IsDetailPanelVisible, Mode=OneWay, Converter={StaticResource BoolToDoubleConverter}, ConverterParameter=12}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="500" />
                <ColumnDefinition x:Name="DetailPanelColumn"
                                  Width="0"
                                  MinWidth="380"
                                  MaxWidth="900" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: Tasks queue (always visible) -->
            <Border Grid.Column="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header row (7 columns) -->
                    <Grid Grid.Row="0"
                          Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                          Padding="12,8"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2.2*" />
                            <ColumnDefinition Width="2.2*" />
                            <ColumnDefinition Width="1.2*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0"
                                  IsChecked="{x:Bind ViewModel.SelectAllTasks, Mode=TwoWay}"
                                  ToolTipService.ToolTip="Chọn tất cả" />
                        <TextBlock Grid.Column="1" Text="Chủ Đề / Link YouTube" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="Tiến Trình" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="🎬 Scriptwriter" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="🎭 Scene Creator" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="5" Text="Trạng Thái" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Tasks list — click row to auto-open detail panel; no per-row actions column.
                     All actions (Run, Config, Logs, Delete) live on the detail panel header. -->
                        <ListView Grid.Row="1"
                              x:Name="LstGeminiTasks"
                              ItemsSource="{x:Bind ViewModel.GeminiTasks, Mode=OneWay}"
                              SelectionMode="Single"
                              PointerPressed="LstGeminiTasks_PointerPressed"
                              SelectedItem="{x:Bind ViewModel.SelectedTask, Mode=TwoWay}"
                              SelectionChanged="LstGeminiTasks_SelectionChanged">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:GeminiTaskModel">
                                <Grid Padding="12,8"
                                      ColumnSpacing="8"
                                      Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="2.2*" />
                                        <ColumnDefinition Width="2.2*" />
                                        <ColumnDefinition Width="1.2*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 1. Select -->
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                              VerticalAlignment="Center" />

                                    <!-- 2. Topic -->
                                    <TextBox Grid.Column="1"
                                             Text="{x:Bind Topic, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="Nhập chủ đề hoặc link YouTube..."
                                             AcceptsReturn="False"
                                             TextWrapping="NoWrap"
                                             VerticalAlignment="Center" />

                                    <!-- 3. Progress -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                        <ProgressBar Value="{x:Bind ProgressPercent, Mode=OneWay}"
                                                     Maximum="100"
                                                     Height="6" />
                                        <TextBlock Text="{x:Bind ProgressText, Mode=OneWay}"
                                                   FontSize="10"
                                                   Opacity="0.7" />
                                    </StackPanel>

                                    <!-- 4. Scriptwriter badge -->
                                    <TextBlock Grid.Column="3"
                                               Text="{x:Bind ScriptwriterSummary, Mode=OneWay}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />

                                    <!-- 5. Scene Creator badge -->
                                    <TextBlock Grid.Column="4"
                                               Text="{x:Bind SceneCreatorSummary, Mode=OneWay}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />

                                    <!-- 6. Status badge -->
                                    <Border Grid.Column="5"
                                            Background="{x:Bind Status, Converter={StaticResource NodeStatusToBrushConverter}}"
                                            Style="{StaticResource StatusBadgeBorderStyle}"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{x:Bind StatusBadge, Mode=OneWay}"
                                                   Foreground="White"
                                                   FontSize="10"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- RIGHT: Detail Panel (master-detail). Hidden when no task is selected.
             Hosts two tabs: Configuration (config form) and Live Logs (5-step accordion). -->
            <Border Grid.Column="1"
                    x:Name="DetailPanelRoot"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{x:Bind ViewModel.IsDetailPanelVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">

                <Grid>
                    <!-- Resize grip on the LEFT edge of the detail panel -->
                    <controls:ResizableDragHandle Width="8"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Stretch"
                                                  Background="Transparent"
                                                  PointerPressed="DetailPanelDragHandle_PointerPressed"
                                                  PointerMoved="DetailPanelDragHandle_PointerMoved"
                                                  PointerReleased="DetailPanelDragHandle_PointerReleased"
                                                  Canvas.ZIndex="10" />

                    <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header: tab switcher + global actions for SelectedTask + close -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Tab toggle: looks like two segmented buttons -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                            <ToggleButton x:Name="TabConfig"
                                          IsChecked="{x:Bind ViewModel.ActiveDetailTab, Mode=OneWay, Converter={StaticResource DetailTabToBoolConverter}, ConverterParameter=Configuration}"
                                          Click="TabConfig_Click"
                                          Padding="10,4"
                                          CornerRadius="6,0,0,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE713;" FontSize="12" />
                                    <TextBlock Text="Cấu hình" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="TabLogs"
                                          IsChecked="{x:Bind ViewModel.ActiveDetailTab, Mode=OneWay, Converter={StaticResource DetailTabToBoolConverter}, ConverterParameter=LiveLogs}"
                                          Click="TabLogs_Click"
                                          Padding="10,4"
                                          CornerRadius="0,6,6,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE9D9;" FontSize="12" />
                                    <TextBlock Text="Live Logs" />
                                </StackPanel>
                            </ToggleButton>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <!-- Profile quick-apply buttons -->
                            <Button x:Name="BtnNewProfile"
                                    Click="BtnNewProfile_Click"
                                    ToolTipService.ToolTip="Tạo profile mới"
                                    Padding="6,2" Height="28">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE710;" FontSize="10" />
                                    <TextBlock Text="Profile" FontSize="11" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnApplyProfile"
                                    Click="BtnApplyProfile_Click"
                                    ToolTipService.ToolTip="Áp dụng profile đã chọn cho task"
                                    Padding="6,2" Height="28">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE73E;" FontSize="10" />
                                    <TextBlock Text="Áp dụng" FontSize="11" />
                                </StackPanel>
                            </Button>
                            <AppBarSeparator />
                            <Button Command="{x:Bind ViewModel.RunSelectedTaskCommand}"
                                    IsEnabled="{x:Bind ViewModel.SelectedTask, Mode=OneWay, Converter={StaticResource NullableToBoolConverter}}"
                                    ToolTipService.ToolTip="Chạy task đang chọn"
                                    Padding="6,2" Height="28" Width="28">
                                <FontIcon Glyph="&#xE768;" FontSize="11" />
                            </Button>
                            <AppBarSeparator />
                            <Button Command="{x:Bind ViewModel.CloseDetailPanelCommand}"
                                    ToolTipService.ToolTip="Đóng panel"
                                    Padding="6,2" Height="28" Width="28">
                                <FontIcon Glyph="&#xE711;" FontSize="11" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Selected Task title banner -->
                    <Border Grid.Row="1"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,6"
                            Margin="0,8,0,8">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="📌 Task:" FontSize="11" Opacity="0.7" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedTaskTopic, Mode=OneWay}"
                                       FontWeight="SemiBold"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- TAB CONTENT: Configuration form OR 5-step accordion.
                     We render both and toggle Visibility so the user never loses scroll/state
                     when switching tabs. -->
                    <Grid Grid.Row="2">
                        <!-- Config tab content -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{x:Bind ViewModel.ActiveDetailTab, Mode=OneWay, Converter={StaticResource DetailTabToVisibilityConverter}, ConverterParameter=Configuration}">
                            <ContentControl x:Name="TaskDetailsContentHost" HorizontalContentAlignment="Stretch" />
                        </ScrollViewer>

                        <!-- Live Logs tab content -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Visibility="{x:Bind ViewModel.ActiveDetailTab, Mode=OneWay, Converter={StaticResource DetailTabToVisibilityConverter}, ConverterParameter=LiveLogs}">
                            <StackPanel Spacing="8">
                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <Expander x:Name="ExpanderStep1" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                        <Expander.Header>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Step 1: Gemini Deep Research &amp; Script"
                                                           FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <Border x:Name="BadgeStep1" Grid.Column="1" CornerRadius="10" Padding="8,2"
                                                        Background="{x:Bind ViewModel.CurrentStep1Status, Mode=OneWay, Converter={StaticResource NodeStatusToBrushConverter}}">
                                                    <TextBlock Text="{x:Bind ViewModel.CurrentStep1Status, Mode=OneWay, Converter={StaticResource StepStatusToTextConverter}}"
                                                               Foreground="White" FontSize="10" FontWeight="SemiBold" />
                                                </Border>
                                            </Grid>
                                        </Expander.Header>
                                        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,4,0,0">
                                            <TextBox Style="{StaticResource StepLogTextBoxStyle}"
                                                     Text="{x:Bind ViewModel.CurrentStep1Log, Mode=OneWay}" />
                                        </ScrollViewer>
                                    </Expander>
                                </Border>

                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="6">
                                    <Expander x:Name="ExpanderStep2" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                        <Expander.Header>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Step 2: Voiceover &amp; SRT Subtitles" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <Border x:Name="BadgeStep2" Grid.Column="1" CornerRadius="10" Padding="8,2"
                                                        Background="{x:Bind ViewModel.CurrentStep2Status, Mode=OneWay, Converter={StaticResource NodeStatusToBrushConverter}}">
                                                    <TextBlock Text="{x:Bind ViewModel.CurrentStep2Status, Mode=OneWay, Converter={StaticResource StepStatusToTextConverter}}" Foreground="White" FontSize="10" FontWeight="SemiBold" />
                                                </Border>
                                            </Grid>
                                        </Expander.Header>
                                        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,4,0,0">
                                            <TextBox Style="{StaticResource StepLogTextBoxStyle}" Text="{x:Bind ViewModel.CurrentStep2Log, Mode=OneWay}" />
                                        </ScrollViewer>
                                    </Expander>
                                </Border>

                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                                    <Expander x:Name="ExpanderStep3" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                        <Expander.Header>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Step 3: Scene Breakdown &amp; Prompts" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <Border x:Name="BadgeStep3" Grid.Column="1" CornerRadius="10" Padding="8,2"
                                                        Background="{x:Bind ViewModel.CurrentStep3Status, Mode=OneWay, Converter={StaticResource NodeStatusToBrushConverter}}">
                                                    <TextBlock Text="{x:Bind ViewModel.CurrentStep3Status, Mode=OneWay, Converter={StaticResource StepStatusToTextConverter}}" Foreground="White" FontSize="10" FontWeight="SemiBold" />
                                                </Border>
                                            </Grid>
                                        </Expander.Header>
                                        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,4,0,0">
                                            <TextBox Style="{StaticResource StepLogTextBoxStyle}" Text="{x:Bind ViewModel.CurrentStep3Log, Mode=OneWay}" />
                                        </ScrollViewer>
                                    </Expander>
                                </Border>

                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                                    <Expander x:Name="ExpanderStep4" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                        <Expander.Header>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Step 4: Batch Image Generation" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <Border x:Name="BadgeStep4" Grid.Column="1" CornerRadius="10" Padding="8,2"
                                                        Background="{x:Bind ViewModel.CurrentStep4Status, Mode=OneWay, Converter={StaticResource NodeStatusToBrushConverter}}">
                                                    <TextBlock Text="{x:Bind ViewModel.CurrentStep4Status, Mode=OneWay, Converter={StaticResource StepStatusToTextConverter}}" Foreground="White" FontSize="10" FontWeight="SemiBold" />
                                                </Border>
                                            </Grid>
                                        </Expander.Header>
                                        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,4,0,0">
                                            <TextBox Style="{StaticResource StepLogTextBoxStyle}" Text="{x:Bind ViewModel.CurrentStep4Log, Mode=OneWay}" />
                                        </ScrollViewer>
                                    </Expander>
                                </Border>

                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                                    <Expander x:Name="ExpanderStep5" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                        <Expander.Header>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Step 5: Export &amp; Packaging" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <Border x:Name="BadgeStep5" Grid.Column="1" CornerRadius="10" Padding="8,2"
                                                        Background="{x:Bind ViewModel.CurrentStep5Status, Mode=OneWay, Converter={StaticResource NodeStatusToBrushConverter}}">
                                                    <TextBlock Text="{x:Bind ViewModel.CurrentStep5Status, Mode=OneWay, Converter={StaticResource StepStatusToTextConverter}}" Foreground="White" FontSize="10" FontWeight="SemiBold" />
                                                </Border>
                                            </Grid>
                                        </Expander.Header>
                                        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,4,0,0">
                                            <TextBox Style="{StaticResource StepLogTextBoxStyle}" Text="{x:Bind ViewModel.CurrentStep5Log, Mode=OneWay}" />
                                        </ScrollViewer>
                                    </Expander>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- C4 + C5: Console log + actions (collapsible, default hidden) -->
        <Border Grid.Row="3"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,12,0,0"
                Visibility="{x:Bind ViewModel.IsConsoleLogVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="📋 Console Logs"
                               FontWeight="SemiBold"
                               FontSize="12"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <ProgressRing IsActive="{x:Bind ViewModel.IsGenerating, Mode=OneWay}"
                                      Width="16" Height="16"
                                      Visibility="{x:Bind ViewModel.IsGenerating, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <Button Command="{x:Bind ViewModel.CancelGenerationCommand}"
                                IsEnabled="{x:Bind ViewModel.IsGenerating, Mode=OneWay}"
                                ToolTipService.ToolTip="Hủy pipeline đang chạy">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE71A;" FontSize="11" />
                                <TextBlock Text="Hủy" />
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind ViewModel.RunSelectedTasksCommand}"
                                Style="{ThemeResource AccentButtonStyle}"
                                ToolTipService.ToolTip="Chạy các task đã chọn">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE768;" FontSize="11" />
                                <TextBlock Text="Chạy" />
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind ViewModel.ClearLogsCommand}"
                                ToolTipService.ToolTip="Xóa logs">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE74D;" FontSize="11" />
                                <TextBlock Text="Xóa Logs" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Action bar: copy to clipboard + clear + auto-scroll toggle -->
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="6"
                                Margin="0,0,0,4">
                        <CheckBox x:Name="ConsoleAutoScrollCheck"
                                  Content="Auto-scroll"
                                  IsChecked="True"
                                  MinWidth="0"
                                  FontSize="11"/>
                        <Button x:Name="CopyConsoleLogsButton"
                                Content="📋 Copy"
                                FontSize="11"
                                Padding="8,2"
                                Click="CopyConsoleLogsButton_Click"
                                ToolTipService.ToolTip="Copy toàn bộ nội dung console log vào clipboard"/>
                    </StackPanel>

                    <!-- ReadOnly TextBox so users can select + Ctrl+C / right-click copy -->
                    <ScrollViewer x:Name="ConsoleLogsScrollViewer"
                                  Grid.Row="1"
                                  MaxHeight="180"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto">
                        <TextBox x:Name="ConsoleLogsTextBox"
                                 Text="{x:Bind ViewModel.ConsoleLogs, Mode=OneWay}"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <!-- Hidden named Flyout for showing row details (positioned from code-behind) -->
        <Grid x:Name="RowDetailsHost" />
    </Grid>
</Page>
