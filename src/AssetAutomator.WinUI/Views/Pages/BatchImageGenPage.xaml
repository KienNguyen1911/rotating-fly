<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="AssetAutomator.WinUI.Views.Pages.BatchImageGenPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:models="using:AssetAutomator.Core.Models"
      xmlns:converters="using:AssetAutomator.WinUI.Converters"
      mc:Ignorable="d">

    <Page.Resources>
        <converters:AspectRatioHeightConverter x:Key="AspectRatioHeightConverter" />
        <converters:NodeStatusToBrushConverter x:Key="NodeStatusToBrushConverter" />
        <converters:HexToBrushConverter x:Key="HexToBrushConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:StringToImageSourceConverter x:Key="StringToImageSourceConverter" />
    </Page.Resources>

    <Grid Padding="24">

        <!-- LEVEL 1: PROJECTS DASHBOARD PANEL -->
        <Grid x:Name="PanelProjectsDashboard"
              Visibility="{x:Bind ViewModel.DashboardVisibility, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Dashboard Header Card -->
            <Border Grid.Row="0"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20"
                    Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8B7;" FontSize="22" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="QUẢN LÝ DỰ ÁN (PROJECTS DASHBOARD)"
                                       FontSize="20"
                                       FontWeight="Bold" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="⚙️ Thư mục lưu trữ dự án:"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBox x:Name="TxtProjectsStoragePath"
                                     Text="{x:Bind ViewModel.ProjectsStoragePath, Mode=OneWay}"
                                     Width="380"
                                     Height="32"
                                     FontSize="12"
                                     IsReadOnly="True"
                                     VerticalContentAlignment="Center" />
                            <Button Content="📂 Mở Folder"
                                    Height="32"
                                    Click="BtnOpenProjectsFolder_Click"
                                    ToolTipService.ToolTip="Mở thư mục lưu trữ dự án bằng File Explorer. Để chọn thư mục khác, vào Settings." />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button Content="➕ Tạo dự án mới"
                                Style="{StaticResource AccentButtonStyle}"
                                Height="40"
                                Padding="20,0"
                                FontWeight="Bold"
                                Click="BtnNewProject_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Projects Cards Grid (DEBUG: full Grid layout) -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Projects, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" ItemWidth="360" MaximumRowsOrColumns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:BatchProjectModel">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16"
                                    Margin="0,0,16,16">
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Background="{ThemeResource SystemControlBackgroundAccentBrush}"
                                                CornerRadius="10"
                                                Width="44"
                                                Height="44"
                                                Margin="0,0,12,0">
                                            <FontIcon Glyph="&#xE8B7;"
                                                      FontSize="20"
                                                      Foreground="White"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind ProjectName}"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind CreatedAt}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>

                                    <Border Grid.Row="1"
                                            Background="#1A1F2A"
                                            CornerRadius="6"
                                            Padding="8,6">
                                        <TextBlock Text="{x:Bind OutputDir}"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Border>

                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                CornerRadius="4"
                                                Padding="8,4">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="Tỷ lệ: " FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind AspectRatio}" FontSize="11" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                CornerRadius="4"
                                                Padding="8,4">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="Engine: " FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind Engine}" FontSize="11" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <Grid Grid.Row="3" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0"
                                                Content="📂 Mở Dự Án"
                                                HorizontalAlignment="Stretch"
                                                Style="{StaticResource AccentButtonStyle}"
                                                FontWeight="Bold"
                                                Tag="{x:Bind}"
                                                Click="BtnOpenProject_Click" />

                                        <Button Grid.Column="1"
                                                Content="🗑️ Xóa"
                                                Width="70"
                                                Tag="{x:Bind}"
                                                Click="BtnDeleteProject_Click" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- LEVEL 2: PROJECT EDITOR PANEL -->
        <Grid x:Name="PanelProjectEditor"
              Visibility="{x:Bind ViewModel.EditorVisibility, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Editor Header Bar -->
            <Border Grid.Row="0"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16,12"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button Content="⬅️ Danh sách Dự án"
                                Click="BtnBackToProjects_Click" />
                        <TextBlock Text="{x:Bind ViewModel.ProjectTitle, Mode=OneWay}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="12"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <ProgressBar Value="{x:Bind ViewModel.TotalDoneCount, Mode=OneWay}"
                                     Maximum="{x:Bind ViewModel.TotalCount, Mode=OneWay}"
                                     Width="180"
                                     Height="10" />
                        <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="💾 Lưu dự án"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="BtnSaveProject_Click" />
                        <Button Content="🌐 Google Flow Web"
                                Click="BtnOpenFlowProjectUrl_Click"
                                ToolTipService.ToolTip="Mở dự án này trực tiếp trên Web Google Flow (labs.google)" />
                        <Button Content="{x:Bind ViewModel.ViewToggleText, Mode=OneWay}"
                                Click="BtnBatchViewToggle_Click" />
                        <Button Content="📁 Open Folder"
                                Click="BtnOpenFolder_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Editor Main Body -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Sidebar Panel (Sprint 4) -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">

                        <!-- SECTION 1: NHÂN VẬT GỐC -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="👤 NHÂN VẬT GỐC"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                                <!-- Select Button / Dropzone -->
                                <Button HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="12"
                                        Click="BtnSelectRefImage_Click">
                                    <Grid>
                                        <!-- Empty State -->
                                        <StackPanel Visibility="{x:Bind ViewModel.EmptyRefImageVisibility, Mode=OneWay}"
                                                    Spacing="6"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE8B9;" FontSize="24" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="Nhấp để chọn ảnh nhân vật gốc"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>

                                        <!-- Has Image Preview State -->
                                        <Grid Visibility="{x:Bind ViewModel.HasRefImageVisibility, Mode=OneWay}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Image x:Name="ImgRefPreview"
                                                   Width="60"
                                                   Height="60"
                                                   Stretch="UniformToFill" />

                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind ViewModel.RefImageInfo, Mode=OneWay}"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind ViewModel.RefImageTag, Mode=OneWay}"
                                                           FontSize="10"
                                                           Foreground="{ThemeResource SystemControlBackgroundAccentBrush}"
                                                           FontWeight="SemiBold" />
                                            </StackPanel>

                                            <Button Grid.Column="2"
                                                    Content="✕"
                                                    Width="28"
                                                    Height="28"
                                                    Padding="0"
                                                    Click="BtnClearRefImage_Click" />
                                        </Grid>
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- SECTION 2: KỊCH BẢN (JSON OBJECT/ARRAY) -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="📝 KỊCH BẢN (JSON OBJECT/ARRAY)"
                                           FontSize="13"
                                           FontWeight="Bold" />

                                <TextBox Text="{x:Bind ViewModel.ScriptJson, Mode=TwoWay}"
                                         Height="160"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         FontFamily="Consolas"
                                         FontSize="11" />

                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            Content="📄 Chọn file JSON"
                                            HorizontalAlignment="Stretch"
                                            Click="BtnImportJson_Click" />

                                    <Button Grid.Column="1"
                                            Content="⚙️ Cập nhật Kịch bản"
                                            HorizontalAlignment="Stretch"
                                            Click="BtnUpdateScriptJson_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- SECTION 3: CẤU HÌNH & ENGINE EXPANDER -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="⚙️ CẤU HÌNH DỰ ÁN"
                                           FontSize="13"
                                           FontWeight="Bold" />

                                <!-- Aspect Ratio -->
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Tỷ lệ khung hình:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <ComboBox x:Name="CboxAspect"
                                              SelectedIndex="0"
                                              SelectionChanged="CboxAspect_SelectionChanged"
                                              HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="16:9 (Ngang)" Tag="16:9" />
                                        <ComboBoxItem Content="9:16 (Dọc Shorts/Reels)" Tag="9:16" />
                                        <ComboBoxItem Content="1:1 (Vuông)" Tag="1:1" />
                                        <ComboBoxItem Content="4:3" Tag="4:3" />
                                        <ComboBoxItem Content="3:4" Tag="3:4" />
                                    </ComboBox>
                                </StackPanel>

                                <!-- Output Directory -->
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Thư mục xuất ảnh:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{x:Bind ViewModel.OutputDir, Mode=TwoWay}" FontSize="11" />
                                        <Button Grid.Column="1" Content="Browse..." Click="BtnBrowseOutputDir_Click" />
                                    </Grid>
                                </StackPanel>

                                <!-- Expander: Cấu hình Engine / Model AI -->
                                <Expander Header="Cấu hình Engine / Model AI"
                                          HorizontalAlignment="Stretch"
                                          IsExpanded="True"
                                          Margin="0,4,0,0">
                                    <StackPanel Spacing="10" Padding="0,8">

                                        <!-- Provider (Google Flow Local is the only backend) -->
                                        <TextBlock Text="API Provider:" FontSize="11" FontWeight="SemiBold" />
                                        <TextBlock Text="🌐 Google Flow Local API (D:\Dev\google-flow-2.0.0 — :8787)"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Margin="0,2,0,4" />
                                        <TextBlock x:Name="TxtGoogleFlow2RootPath"
                                                   Text="(đường dẫn launcher sẽ tự động khởi động khi mở ứng dụng)"
                                                   FontSize="10"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,6" />

                                        <!-- Engine (always "flow" for Google Flow Local) -->
                                        <TextBlock Text="Engine:" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0" />
                                        <ComboBox x:Name="CboxEngine"
                                                  SelectedIndex="0"
                                                  SelectionChanged="CboxEngine_SelectionChanged"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="Flow" Tag="flow" />
                                        </ComboBox>

                                        <!-- Models Panel -->
                                        <StackPanel Visibility="{x:Bind ViewModel.FlowOptionsVisibility, Mode=OneWay}" Spacing="8">
                                            <!-- Flow Local Models -->
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Model (Flow Local):" FontSize="11" FontWeight="SemiBold" />
                                                <RadioButton Content="Gemini 3.1 Flash" GroupName="FlowLocalModelGroup" Tag="gemini-3.1-flash-image" Checked="RadModel_Checked" />
                                                <RadioButton Content="Gemini 3.0 Pro" GroupName="FlowLocalModelGroup" Tag="gemini-3.0-pro-image" Checked="RadModel_Checked" />
                                                <RadioButton Content="Imagen 4 Preview" GroupName="FlowLocalModelGroup" Tag="imagen-4.0-generate-preview" Checked="RadModel_Checked" />
                                                <RadioButton Content="Nano Banana 2 Flow" GroupName="FlowLocalModelGroup" Tag="nano-banana-2" Checked="RadModel_Checked" IsChecked="True" />
                                                <RadioButton Content="Nano Banana Pro Flow" GroupName="FlowLocalModelGroup" Tag="nano-banana-pro" Checked="RadModel_Checked" />
                                            </StackPanel>

                                            <!-- Upscale options -->
                                            <TextBlock Text="Upscale:" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0" />
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <RadioButton Content="None" GroupName="UpscaleGroup" Tag="none" Checked="RadUpscale_Checked" IsChecked="True" />
                                                <RadioButton Content="2K" GroupName="UpscaleGroup" Tag="2K" Checked="RadUpscale_Checked" />
                                                <RadioButton Content="4K" GroupName="UpscaleGroup" Tag="4K" Checked="RadUpscale_Checked" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Concurrency -->
                                        <TextBlock Text="Số ảnh chạy song song:" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0" />
                                        <ComboBox x:Name="CboxConcurrency"
                                                  SelectedIndex="2"
                                                  SelectionChanged="CboxConcurrency_SelectionChanged"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="1 ảnh" Tag="1" />
                                            <ComboBoxItem Content="2 ảnh" Tag="2" />
                                            <ComboBoxItem Content="4 ảnh" Tag="4" />
                                            <ComboBoxItem Content="6 ảnh" Tag="6" />
                                            <ComboBoxItem Content="8 ảnh" Tag="8" />
                                        </ComboBox>

                                    </StackPanel>
                                </Expander>

                                <!-- Bottom Batch Generate Button -->
                                <Button Content="{x:Bind ViewModel.GenerateButtonText, Mode=OneWay}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Height="44"
                                        FontWeight="Bold"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,8,0,0"
                                        Click="BtnBatchGenerate_Click" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- Right Main Panel (Sprint 5: Card Grid View B8 & Fallback Table View B9) -->
                <Grid Grid.Column="2">

                    <!-- Card Grid View (Main View B8) -->
                    <ScrollViewer x:Name="ScrollCardGrid"
                                  Visibility="{x:Bind ViewModel.CardGridVisibility, Mode=OneWay}"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ItemsControlBatchCards"
                                      ItemsSource="{x:Bind ViewModel.BatchImageItems, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" ItemWidth="360" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:BatchImageItem">
                                    <Border Background="#12141A"
                                            CornerRadius="12"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            Margin="0,0,16,16">
                                        <Grid Height="{x:Bind AspectRatio, Mode=OneWay, Converter={StaticResource AspectRatioHeightConverter}, ConverterParameter=320}">
                                            <!-- Waiting/Status Placeholder -->
                                            <Grid Background="#12141A">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                                                    <FontIcon Glyph="&#xE8B9;" FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                                    <TextBlock Text="{x:Bind Status, Mode=OneWay}"
                                                               FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               HorizontalAlignment="Center"
                                                               FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Clear Generated Image -->
                                            <Image Source="{x:Bind ImagePath, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                                   Stretch="UniformToFill"
                                                   Tag="{x:Bind}" />

                                            <!-- Glass Overlay Container -->
                                            <Grid Background="Transparent">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- Top Bar: Scene Title, Status Badge & Action Buttons -->
                                                <Grid Grid.Row="0" Margin="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Left: Scene Badge & Status Badge -->
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <Border Background="#CC0F172A" CornerRadius="6" Padding="8,4" BorderBrush="#40FFFFFF" BorderThickness="1">
                                                            <TextBlock Text="{x:Bind SceneTitle, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                                                        </Border>
                                                        <Border Background="{x:Bind Status, Mode=OneWay, Converter={StaticResource NodeStatusToBrushConverter}}"
                                                                CornerRadius="6"
                                                                Padding="7,4"
                                                                BorderBrush="#30FFFFFF"
                                                                BorderThickness="1">
                                                            <TextBlock Text="{x:Bind Status, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" Foreground="#E2E8F0" />
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- Right: Quick Action Buttons (Regenerate 🔄, Open 📁, Copy 📋) -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <Button Content="🔄"
                                                                Width="30" Height="30" Padding="0"
                                                                CornerRadius="15"
                                                                Tag="{x:Bind}"
                                                                Click="BtnCardRegenerate_Click"
                                                                ToolTipService.ToolTip="Tạo lại ảnh cảnh này" />
                                                        <Button Content="📁"
                                                                Width="30" Height="30" Padding="0"
                                                                CornerRadius="15"
                                                                Tag="{x:Bind}"
                                                                Click="BtnCardOpenImage_Click"
                                                                ToolTipService.ToolTip="Mở file ảnh" />
                                                        <Button Content="📋"
                                                                Width="30" Height="30" Padding="0"
                                                                CornerRadius="15"
                                                                Tag="{x:Bind}"
                                                                Click="BtnCardCopyPrompt_Click"
                                                                ToolTipService.ToolTip="Sao chép prompt" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Bottom Glass Bar: Transcript & Prompt Snippet -->
                                                <Border Grid.Row="2"
                                                        Margin="10"
                                                        Background="#D9090D16"
                                                        CornerRadius="8"
                                                        Padding="10,8"
                                                        BorderBrush="#30FFFFFF"
                                                        BorderThickness="1">
                                                    <StackPanel Spacing="3">
                                                        <TextBlock Text="{x:Bind Transcript, Mode=OneWay}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#FFFFFF"
                                                                   MaxLines="2"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{x:Bind Prompt, Mode=OneWay}"
                                                                   FontSize="10"
                                                                   FontStyle="Italic"
                                                                   Foreground="#CBD5E1"
                                                                   MaxLines="2"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Fallback Table Queue View (B9) -->
                    <Border x:Name="BorderTableView"
                            Visibility="{x:Bind ViewModel.TableViewVisibility, Mode=OneWay}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12">
                        <ListView x:Name="LviewBatchImageItems"
                                  ItemsSource="{x:Bind ViewModel.BatchImageItems, Mode=OneWay}"
                                  SelectionMode="Single">
                            <ListView.HeaderTemplate>
                                <DataTemplate>
                                    <Grid Padding="12,8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="65" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="#" FontWeight="Bold" FontSize="12" />
                                        <TextBlock Grid.Column="1" Text="Scene" FontWeight="Bold" FontSize="12" />
                                        <TextBlock Grid.Column="2" Text="Prompt" FontWeight="Bold" FontSize="12" />
                                        <TextBlock Grid.Column="3" Text="Status" FontWeight="Bold" FontSize="12" />
                                        <TextBlock Grid.Column="4" Text="Engine" FontWeight="Bold" FontSize="12" />
                                        <TextBlock Grid.Column="5" Text="Aspect" FontWeight="Bold" FontSize="12" />
                                        <TextBlock Grid.Column="6" Text="Finished" FontWeight="Bold" FontSize="12" />
                                        <TextBlock Grid.Column="7" Text="Error / Info" FontWeight="Bold" FontSize="12" />
                                        <TextBlock Grid.Column="8" Text="Action" FontWeight="Bold" FontSize="12" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.HeaderTemplate>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:BatchImageItem">
                                    <Grid Padding="12,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="65" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind IndexFormatted, Mode=OneWay}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind SceneTitle, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Prompt, Mode=OneWay}" FontSize="11" TextTrimming="CharacterEllipsis" MaxLines="1" VerticalAlignment="Center" />
                                        <Border Grid.Column="3" Background="{x:Bind Status, Mode=OneWay, Converter={StaticResource NodeStatusToBrushConverter}}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Status, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                        <TextBlock Grid.Column="4" Text="{x:Bind Engine, Mode=OneWay}" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="5" Text="{x:Bind AspectRatio, Mode=OneWay}" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="6" Text="{x:Bind FinishedTimeFormatted, Mode=OneWay}" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="7" Text="{x:Bind ErrorMessage, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" VerticalAlignment="Center" />
                                        <Button Grid.Column="8" Content="Open Image" FontSize="11" Padding="8,4" Tag="{x:Bind}" Click="BtnCardOpenImage_Click" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
