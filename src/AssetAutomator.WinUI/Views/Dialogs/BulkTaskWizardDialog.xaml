<ContentDialog x:Class="AssetAutomator.WinUI.Views.Dialogs.BulkTaskWizardDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:local="using:AssetAutomator.WinUI.Views.Dialogs"
               xmlns:models="using:AssetAutomator.Core.Models"
               xmlns:converters="using:AssetAutomator.WinUI.Converters"
               Title="Thêm Task Hàng Loạt"
               PrimaryButtonText="Tạo Task"
               SecondaryButtonText="Hủy bỏ"
               DefaultButton="Primary"
               PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
               SecondaryButtonClick="ContentDialog_SecondaryButtonClick">

    <ContentDialog.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </ContentDialog.Resources>

    <Grid MinWidth="550" MinHeight="400">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="Nhập danh sách topic hoặc link YouTube" FontWeight="SemiBold" />
            <TextBlock Text="Mỗi dòng là 1 task mới. Dán từ Excel, Notepad đều được." 
                       Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Multiline Topic Input -->
            <TextBox x:Name="TopicsInputBox"
                     Grid.Row="0"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     PlaceholderText="Lợi ích của việc đọc sách&#x0a;https://www.youtube.com/watch?v=abc123&#x0a;Cách giảm stress hiệu quả"
                     TextChanged="TopicsInputBox_TextChanged"
                     VerticalAlignment="Stretch"
                     MinHeight="120" />

            <!-- Template Selector -->
            <Border Grid.Row="1" Margin="0,12,0,0" 
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="6" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Template:" VerticalAlignment="Center" 
                               FontWeight="SemiBold" Margin="0,0,12,0" />
                    
                    <ComboBox x:Name="TemplateComboBox" Grid.Column="1"
                              ItemsSource="{x:Bind AvailableTemplates}"
                              SelectedItem="{x:Bind SelectedTemplate, Mode=TwoWay}"
                              DisplayMemberPath="Topic"
                              HorizontalAlignment="Stretch" />
                    
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0"
                               Opacity="0.6" FontSize="12">
                        <Run Text="{x:Bind TaskCount}" />
                        <Run Text=" task(s)" />
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Preview Section -->
            <Border Grid.Row="2" Margin="0,12,0,0" 
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="12"
                    Visibility="{x:Bind HasTopics, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Preview" FontWeight="SemiBold" Opacity="0.8" />
                    <ListView ItemsSource="{x:Bind PreviewItems}" MaxHeight="150" 
                              SelectionMode="None" Background="Transparent">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:PreviewItem">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE8AB;" FontSize="12" 
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind DisplayText}" 
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer hint -->
        <TextBlock Grid.Row="2" Margin="0,12,0,0" FontSize="11" Opacity="0.5" TextWrapping="Wrap">
            <Run Text="Dòng bắt đầu bằng 'http' hoặc 'www' sẽ được nhận dạng là YouTube URL." />
        </TextBlock>
    </Grid>
</ContentDialog>
