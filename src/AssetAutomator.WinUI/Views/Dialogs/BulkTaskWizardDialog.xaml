<ContentDialog x:Class="AssetAutomator.WinUI.Views.Dialogs.BulkTaskWizardDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:local="using:AssetAutomator.WinUI.Views.Dialogs"
               xmlns:models="using:AssetAutomator.Core.Models"
               Title="Thêm Task Hàng Loạt (Bulk Add)"
               PrimaryButtonText="Tiếp tục"
               SecondaryButtonText="Hủy bỏ"
               DefaultButton="Primary"
               PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
               SecondaryButtonClick="ContentDialog_SecondaryButtonClick">

    <Grid MinWidth="500" MinHeight="450">
        <!-- BƯỚC 1: NHẬP TOPIC -->
        <Grid x:Name="Step1Panel" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Bước 1: Nhập danh sách chủ đề hoặc link YouTube (mỗi dòng 1 task mới):" 
                       TextWrapping="Wrap" Margin="0,0,0,12" Opacity="0.8" />

            <ListView Grid.Row="1" ItemsSource="{x:Bind Topics}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:TopicItem">
                        <Grid Margin="0,0,0,8" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{x:Bind Topic, Mode=TwoWay}" PlaceholderText="Ví dụ: Lợi ích của việc đọc sách..." />
                            <Button Grid.Column="1" Click="RemoveTopic_Click" Tag="{x:Bind}" ToolTipService.ToolTip="Xóa dòng này">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="Red" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Button Grid.Row="2" Margin="0,12,0,0" Click="AddTopic_Click" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                    <TextBlock Text="Thêm dòng" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- BƯỚC 2: CẤU HÌNH -->
        <Grid x:Name="Step2Panel" Visibility="Collapsed" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Text="Bước 2: Cấu hình chung cho tất cả các task mới" 
                       TextWrapping="Wrap" Margin="0,0,0,12" Opacity="0.8" />

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16" Padding="0,0,16,0">
                    
                    <!-- Scriptwriter Config -->
                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Scriptwriter (Viết kịch bản)" FontWeight="SemiBold" />
                            <ComboBox Header="Gem chuyên gia" ItemsSource="{x:Bind AvailableScriptwriterGems}" SelectedItem="{x:Bind TemplateTask.SelectedScriptwriterGem, Mode=TwoWay}" DisplayMemberPath="DisplayName" HorizontalAlignment="Stretch" />
                            <ComboBox Header="Model AI" ItemsSource="{x:Bind AvailableAiModels}" SelectedItem="{x:Bind TemplateTask.ScriptwriterModel, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                            <ToggleSwitch Header="Deep Research (Tìm kiếm Web sâu)" IsOn="{x:Bind TemplateTask.EnableDeepResearch, Mode=TwoWay}" />
                            <TextBox Header="Ngôn ngữ Video" Text="{x:Bind TemplateTask.TargetLanguage, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>

                    <!-- Scene Creator Config -->
                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Scene Creator (Tạo hình ảnh)" FontWeight="SemiBold" />
                            <ComboBox Header="Gem chuyên gia" ItemsSource="{x:Bind AvailableSceneCreatorGems}" SelectedItem="{x:Bind TemplateTask.SelectedSceneCreatorGem, Mode=TwoWay}" DisplayMemberPath="DisplayName" HorizontalAlignment="Stretch" />
                            <ComboBox Header="Model AI" ItemsSource="{x:Bind AvailableAiModels}" SelectedItem="{x:Bind TemplateTask.SceneCreatorModel, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                            <ComboBox Header="Nhà cung cấp ảnh" ItemsSource="{x:Bind AvailableImageProviders}" SelectedItem="{x:Bind TemplateTask.SelectedImageProvider, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                            <TextBox Header="Character Reference (Path ảnh)" Text="{x:Bind TemplateTask.CharacterRef, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>

                    <!-- Voice Config -->
                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Lồng Tiếng (ElevenLabs)" FontWeight="SemiBold" />
                            <TextBox Header="Voice ID" Text="{x:Bind TemplateTask.VoiceId, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>
                    
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</ContentDialog>
