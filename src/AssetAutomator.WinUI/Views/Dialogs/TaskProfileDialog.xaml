<ContentDialog x:Class="AssetAutomator.WinUI.Views.Dialogs.TaskProfileDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:models="using:AssetAutomator.Core.Models"
               Title="Tạo / Chỉnh Sửa Profile"
               PrimaryButtonText="Lưu"
               CloseButtonText="Hủy"
               DefaultButton="Primary"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               HorizontalContentAlignment="Stretch"
               VerticalContentAlignment="Stretch"
               PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">680</x:Double>
        <x:Double x:Key="ContentDialogMinWidth">560</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="580">
        <StackPanel Spacing="14" Margin="0,4,0,0">

            <!-- ── 1. Profile Name ── -->
            <StackPanel Spacing="4">
                <TextBlock Text="📋 Tên Profile" FontWeight="SemiBold" FontSize="12" />
                <TextBox x:Name="TxtProfileName"
                         PlaceholderText="vd: Psychology Channel, Book Review..."
                         TextChanged="TxtProfileName_TextChanged" />
                <TextBlock x:Name="TxtNameError"
                           Text="Tên profile không được trống."
                           FontSize="11"
                           Foreground="Red"
                           Visibility="Collapsed" />
            </StackPanel>

            <!-- ── 2. Scriptwriter ── -->
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="🎬 Scriptwriter" FontWeight="SemiBold" FontSize="12" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Gem" FontSize="11" Opacity="0.7" />
                            <ComboBox x:Name="CmbScriptwriterGem"
                                      PlaceholderText="Chọn gem..."
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Model" FontSize="11" Opacity="0.7" />
                            <ComboBox x:Name="CmbScriptwriterModel"
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Grid>

                    <CheckBox x:Name="ChkDeepResearch"
                              Content="Bật Deep Research (luôn bật)"
                              IsChecked="True"
                              IsHitTestVisible="False"
                              IsEnabled="False"
                              Opacity="0.8"
                              FontSize="11" />

                    <!-- Word Count: controls the Gemini prompt's STRICT WORD COUNT REQUIREMENT block.
                         Min / Target / Max are independent so users can have e.g. Min=2000, Target=2500,
                         Max=2800 without being forced into a fixed 80%/100%/110% ratio. -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="📏 Script Word Count (Step 2 Transcript)"
                                   FontSize="11"
                                   Opacity="0.7" />
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Min" FontSize="10" Opacity="0.6" />
                                <NumberBox x:Name="NumScriptMinWords"
                                           Value="1600"
                                           Minimum="100"
                                           Maximum="50000"
                                           SmallChange="100"
                                           LargeChange="500"
                                           SpinButtonPlacementMode="Compact" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="Target" FontSize="10" Opacity="0.6" />
                                <NumberBox x:Name="NumScriptTargetWords"
                                           Value="2000"
                                           Minimum="100"
                                           Maximum="50000"
                                           SmallChange="100"
                                           LargeChange="500"
                                           SpinButtonPlacementMode="Compact" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="2">
                                <TextBlock Text="Max" FontSize="10" Opacity="0.6" />
                                <NumberBox x:Name="NumScriptMaxWords"
                                           Value="2200"
                                           Minimum="100"
                                           Maximum="50000"
                                           SmallChange="100"
                                           LargeChange="500"
                                           SpinButtonPlacementMode="Compact" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="⚠️ Min ≤ Target ≤ Max. Số ngoài phạm vi sẽ được tự động giới hạn về giá trị mặc định."
                                   FontSize="10"
                                   Opacity="0.6"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── 3. Scene Creator ── -->
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="🎭 Scene Creator (Stage C)" FontWeight="SemiBold" FontSize="12" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Gem" FontSize="11" Opacity="0.7" />
                            <ComboBox x:Name="CmbSceneCreatorGem"
                                      PlaceholderText="Chọn gem..."
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Model" FontSize="11" Opacity="0.7" />
                            <ComboBox x:Name="CmbSceneCreatorModel"
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Chế độ" FontSize="11" Opacity="0.7" />
                        <TextBlock Text="📡 API Stream (luôn bật — không cần Chrome)"
                                   FontSize="11"
                                   Opacity="0.8" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── 3b. Image Prompt Generation ── -->
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="🎨 Image Prompt Gen (Stage D)" FontWeight="SemiBold" FontSize="12" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Gem" FontSize="11" Opacity="0.7" />
                            <ComboBox x:Name="CmbImagePromptGem"
                                      PlaceholderText="Chọn gem..."
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Model" FontSize="11" Opacity="0.7" />
                            <ComboBox x:Name="CmbImagePromptModel"
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Grid>

                    <CheckBox x:Name="ChkSkipImagePromptGen"
                              Content="Bỏ qua nếu scenes.json đã có image_prompts"
                              FontSize="11" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="Chế độ" FontSize="11" Opacity="0.7" />
                        <TextBlock Text="📡 API Stream (luôn bật — không cần Chrome)"
                                   FontSize="11"
                                   Opacity="0.8" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── 4. Voiceover ── -->
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="🎙️ Voiceover" FontWeight="SemiBold" FontSize="12" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="Voice ID" FontSize="11" Opacity="0.7" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtVoiceId"
                                     Grid.Column="0"
                                     PlaceholderText="vd: en-US-Standard-A" />
                            <Button x:Name="BtnBrowseVoice"
                                    Grid.Column="1"
                                    Content="🔍 Tìm"
                                    ToolTipService.ToolTip="Tìm &amp; chọn Voice ID"
                                    Click="BtnBrowseVoice_Click" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── 5. Image Generation ── -->
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="🖼️ Image Generation" FontWeight="SemiBold" FontSize="12" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Provider" FontSize="11" Opacity="0.7" />
                            <ComboBox x:Name="CmbImageProvider"
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Character Ref" FontSize="11" Opacity="0.7" />
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtCharacterRef"
                                         Grid.Column="0"
                                         PlaceholderText="Đường dẫn ảnh nhân vật" />
                                <Button x:Name="BtnBrowseCharRef"
                                        Grid.Column="1"
                                        Content="📁"
                                        ToolTipService.ToolTip="Chọn file ảnh"
                                        Click="BtnBrowseCharRef_Click" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</ContentDialog>
