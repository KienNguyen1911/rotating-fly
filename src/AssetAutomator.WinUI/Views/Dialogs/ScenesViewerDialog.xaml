<ContentDialog x:Class="AssetAutomator.WinUI.Views.Dialogs.ScenesViewerDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               Title="Danh Sách Phân Cảnh (Scenes)"
               CloseButtonText="Đóng"
               DefaultButton="Close">

    <Grid MinWidth="700" MinHeight="450" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header & Toolbar -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4" VerticalAlignment="Center">
                <TextBlock x:Name="TxtInfo" Text="Phân cảnh trích xuất từ kịch bản:" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <TextBlock x:Name="TxtSceneStats" Text="Tổng số phân cảnh: 0" Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.7" />
            </StackPanel>
            <Button x:Name="BtnApplyAllToBatch"
                    Grid.Column="1"
                    Style="{ThemeResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8B6;" FontSize="14" />
                    <TextBlock Text="📥 Nhập Tất Cả Prompts Vào Batch Queue" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Scenes List -->
        <Border Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8">
            <ListView x:Name="LstScenes" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8" RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Column="0" Grid.Row="0" Text="{Binding SceneIndex}" FontWeight="Bold" VerticalAlignment="Top" />
                            <TextBlock Grid.Column="1" Grid.Row="0" Grid.ColumnSpan="2" Text="{Binding ScriptLine}" TextWrapping="Wrap" VerticalAlignment="Top" />
                            <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Prompt}" Opacity="0.7" FontStyle="Italic" TextWrapping="Wrap" Margin="0,4,0,0" VerticalAlignment="Center" />
                            
                            <Button Grid.Column="2" Grid.Row="1"
                                    x:Name="BtnCopyPrompt"
                                    Margin="8,0,0,0"
                                    Padding="8,4"
                                    ToolTipService.ToolTip="Sao chép prompt">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                                    <TextBlock Text="Copy" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</ContentDialog>
