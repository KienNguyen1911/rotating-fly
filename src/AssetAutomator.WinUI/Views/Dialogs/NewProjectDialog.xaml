<ContentDialog x:Class="AssetAutomator.WinUI.Views.Dialogs.NewProjectDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               Title="Tạo Dự Án Mới"
               PrimaryButtonText="Tạo Dự Án"
               CloseButtonText="Hủy"
               DefaultButton="Primary"
               PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <StackPanel Spacing="14" MinWidth="440">
        <TextBox x:Name="TxtProjectName" Header="Tên dự án:" PlaceholderText="Nhập tên dự án..." />

        <TextBox x:Name="TxtDescription" Header="Mô tả dự án (Tùy chọn):" PlaceholderText="Nhập mô tả..." AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" />
    </StackPanel>
</ContentDialog>
