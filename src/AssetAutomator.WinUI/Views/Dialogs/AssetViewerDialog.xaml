<?xml version="1.0" encoding="utf-8"?>
<ContentDialog x:Class="AssetAutomator.WinUI.Views.Dialogs.AssetViewerDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               Title="📦 Assets — Scenes · Transcript · Voiceover SRT"
               CloseButtonText="Đóng"
               DefaultButton="Close">

    <!-- Outer wrapper Grid (DialogRootGrid) lets us resize the dialog itself
         to 50% of the screen via ContentDialogMaxWidth/MinWidth theme resources. -->
    <Grid x:Name="DialogRootGrid" MinWidth="900" MinHeight="600" RowSpacing="8">

        <Grid.Resources>
            <!-- Reusable style for each tab's read-only viewer -->
            <Style x:Key="AssetTabTextBoxStyle" TargetType="TextBox">
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="AcceptsReturn" Value="True" />
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="#E2E8F0" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>
            <Style x:Key="AssetTabHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="AssetTabStatsTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Opacity" Value="0.7" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 3 tabs: scenes.json · transcript.txt · voiceover.srt
             We use Pivot (not TabView) because the ContentDialog template is
             already centered/sized — adding TabView introduces a second
             navigation chrome inside an already-chrome-heavy dialog. -->
        <Pivot x:Name="Tabs" Grid.Row="0">

            <!-- ───── Tab 1: scenes.json ───── -->
            <PivotItem x:Name="TabScenes">
                <PivotItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                        <TextBlock Text="scenes.json" FontWeight="SemiBold" />
                    </StackPanel>
                </PivotItem.Header>

                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Spacing="2">
                        <TextBlock x:Name="TxtScenesPath"
                                   Style="{StaticResource AssetTabHeaderTextStyle}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="TxtScenesStats"
                                   Style="{StaticResource AssetTabStatsTextStyle}" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            Background="#12141A"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="2">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="TxtScenesContent"
                                     Style="{StaticResource AssetTabTextBoxStyle}" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </PivotItem>

            <!-- ───── Tab 2: transcript.txt ───── -->
            <PivotItem x:Name="TabTranscript">
                <PivotItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                        <TextBlock Text="transcript.txt" FontWeight="SemiBold" />
                    </StackPanel>
                </PivotItem.Header>

                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Spacing="2">
                        <TextBlock x:Name="TxtTranscriptPath"
                                   Style="{StaticResource AssetTabHeaderTextStyle}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="TxtTranscriptStats"
                                   Style="{StaticResource AssetTabStatsTextStyle}" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            Background="#12141A"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="2">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="TxtTranscriptContent"
                                     Style="{StaticResource AssetTabTextBoxStyle}"
                                     TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </PivotItem>

            <!-- ───── Tab 3: voiceover.srt ───── -->
            <PivotItem x:Name="TabSrt">
                <PivotItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                        <TextBlock Text="voiceover.srt" FontWeight="SemiBold" />
                    </StackPanel>
                </PivotItem.Header>

                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Spacing="2">
                        <TextBlock x:Name="TxtSrtPath"
                                   Style="{StaticResource AssetTabHeaderTextStyle}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="TxtSrtStats"
                                   Style="{StaticResource AssetTabStatsTextStyle}" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            Background="#12141A"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="2">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="TxtSrtContent"
                                     Style="{StaticResource AssetTabTextBoxStyle}" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </PivotItem>
        </Pivot>

        <!-- Footer hint + Copy-All button -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TxtFooterHint"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="💡 Mẹo: chuyển tab bên trên để xem 3 file assets. Ctrl+A → Ctrl+C để copy."
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Opacity="0.6" />

            <Button x:Name="BtnCopyCurrent"
                    Grid.Column="1"
                    Click="BtnCopyCurrent_Click"
                    ToolTipService.ToolTip="Sao chép nội dung của tab hiện tại vào Clipboard">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                    <TextBlock Text="Copy tab hiện tại" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</ContentDialog>