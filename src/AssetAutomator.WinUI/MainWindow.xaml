<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="AssetAutomator.WinUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AssetAutomator.WinUI.ViewModels"
        xmlns:controls="using:AssetAutomator.WinUI.Controls"
        Title="AssetAutomator">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Height="40"
              Background="Transparent"
              VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0"
                   Width="16"
                   Height="16"
                   Margin="48,0,12,0"
                   VerticalAlignment="Center"
                   Source="ms-appx:///Assets/Square44x44Logo.scale-200.png" />
            <TextBlock Grid.Column="1"
                       Text="AssetAutomator"
                       VerticalAlignment="Center"
                       FontSize="14"
                       FontWeight="SemiBold" />
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center"
                        Margin="0,0,160,0">
                <!-- D2: Compact icon-only Logs drawer toggle (tooltip explains full label) -->
                <Button x:Name="BtnToggleSidebar" Click="BtnToggleSidebar_Click"
                        ToolTipService.ToolTip="Mở / đóng thanh Log"
                        Width="32" Height="32" Padding="0"
                        Style="{StaticResource HeaderPillButton}">
                    <FontIcon Glyph="&#xE9D9;" FontSize="13" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- NavigationView layout (WinUI 3 Gallery style) -->
        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Left"
                        OpenPaneLength="240"
                        SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Automation Tasks" Tag="tasks">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9F9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Image Pool" Tag="pool">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Chrome Profiles" Tag="profiles">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Gemini AI Creator" Tag="gemini">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE945;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Batch Image Gen" Tag="batch">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="History" Tag="history">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Settings" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <!--
          D2 — Sidebar drawer overlay (slides from the right, draggable resize handle).
          Sits in Row 1 alongside NavigationView. When closed, the entire panel is
          Collapsed + translated off-screen so it does not interact with input.
        -->
        <Grid x:Name="SidebarDrawerOverlay"
              Grid.Row="1"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Visibility="Collapsed">
            <Grid x:Name="SidebarDrawer"
                  HorizontalAlignment="Right"
                  Width="{x:Bind Sidebar.DrawerWidth, Mode=OneWay}"
                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1,0,0,0">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="SidebarTranslate" />
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header: title + close button -->
                <Grid Grid.Row="0" Padding="16,12" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{x:Bind Sidebar.Title, Mode=OneWay}"
                               FontWeight="SemiBold"
                               FontSize="14"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            x:Name="BtnCloseSidebar"
                            Click="BtnCloseSidebar_Click"
                            Style="{StaticResource RoundCloseButton}"
                            Content="✕"
                            ToolTipService.ToolTip="Đóng thanh log" />
                </Grid>

                <!-- Body: log viewer wrapped in a scrollable container -->
                <ScrollViewer Grid.Row="1"
                              Margin="8,0,8,8"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <TextBlock Text="{x:Bind Sidebar.Logs, Mode=OneWay}"
                               FontFamily="Consolas"
                               FontSize="11"
                               TextWrapping="NoWrap" />
                </ScrollViewer>

                <!-- Drag handle (resizer) — overlaid on the left edge of the drawer -->
                <controls:ResizableDragHandle x:Name="SidebarDragHandle"
                        Width="6"
                        HorizontalAlignment="Left"
                        Background="{ThemeResource CardStrokeColorDefaultBrush}"
                        PointerPressed="SidebarDragHandle_PointerPressed"
                        PointerMoved="SidebarDragHandle_PointerMoved"
                        PointerReleased="SidebarDragHandle_PointerReleased"
                        PointerEntered="SidebarDragHandle_PointerEntered"
                        PointerExited="SidebarDragHandle_PointerExited" />
            </Grid>
        </Grid>
    </Grid>
</Window>