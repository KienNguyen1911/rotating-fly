<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="AssetAutomator.WinUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AssetAutomator.WinUI.ViewModels"
        xmlns:controls="using:AssetAutomator.WinUI.Controls"
        Title="AssetAutomator">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Height="40"
              Background="Transparent"
              VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0"
                   Width="16"
                   Height="16"
                   Margin="48,0,12,0"
                   VerticalAlignment="Center"
                   Source="ms-appx:///Assets/Square44x44Logo.scale-200.png" />
            <TextBlock Grid.Column="1"
                       Text="AssetAutomator"
                       VerticalAlignment="Center"
                       FontSize="14"
                       FontWeight="SemiBold" />
        </Grid>

        <!-- NavigationView layout (WinUI 3 Gallery style) -->
        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Left"
                        OpenPaneLength="240"
                        SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Automation Tasks" Tag="tasks">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9F9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Image Pool" Tag="pool">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Chrome Profiles" Tag="profiles">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Gemini AI Creator" Tag="gemini">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE945;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Batch Image Gen" Tag="batch">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="History" Tag="history">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Settings" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!--
                CacheSize lớn để cache nhiều page khi user chuyển tab qua lại.
                Mỗi page cần set NavigationCacheMode="Required" trên root <Page>
                để giữ instance (xem GeminiPage.xaml). Frame mặc định cache
                NavigationCacheMode=Disabled, nghĩa là mỗi lần Navigate sẽ tạo
                page mới — đây chính là nguyên nhân user bị mất task list khi
                chuyển sang tab khác rồi quay lại Gemini AI Creator.
            -->
            <Frame x:Name="ContentFrame" CacheSize="10" />
        </NavigationView>

        <!-- Q3: BottomBar indicator cho Flow Local status -->
        <Border Grid.Row="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,12,8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="10,4"
                Opacity="0.92">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon x:Name="FlowLocalIcon" Glyph="&#xE9CE;" FontSize="12" />
                <TextBlock x:Name="FlowLocalIndicator"
                           Text="Flow Local: đang kiểm tra..."
                           FontSize="11"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>