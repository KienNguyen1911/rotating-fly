<?xml version="1.0" encoding="utf-8"?>
<Application x:Class="AssetAutomator.WinUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:AssetAutomator.WinUI.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Styles/CardStyles.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/Theme.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/ButtonStyles.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/Theme.Light.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters — register at App.Resources scope so they're
                 resolvable from any DataTemplate (Page.Resources scope is
                 unreliable inside nested ListView templates in WinUI 3). -->
            <conv:HistoryStatusToBackgroundConverter x:Key="HistoryStatusBackground" />
            <conv:HistoryStatusToForegroundConverter x:Key="HistoryStatusForeground" />
            <!--
              Theme.Dark.xaml is registered in ThemeDictionaries so the framework
              automatically swaps it in when the active theme is "Default" (Dark).
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="ms-appx:///Styles/Theme.Dark.xaml" />
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="ms-appx:///Styles/Theme.Light.xaml" />
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>