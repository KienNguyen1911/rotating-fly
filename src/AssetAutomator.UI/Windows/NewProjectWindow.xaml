<Window x:Class="AssetAutomator.UI.Windows.NewProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tạo Dự Án Mới" SizeToContent="Height" MinHeight="250" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource InkBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="➕ Tạo Dự Án Mới" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,6"/>
            <TextBlock Text="Nhập tên dự án để khởi tạo thư mục làm việc và quản lý kịch bản riêng." FontSize="12" Foreground="{DynamicResource BodyBrush}" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Tên Dự Án (Project Name):" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtProjectName" Height="36" FontSize="13" VerticalContentAlignment="Center" Padding="10,0"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnCancel" Content="Hủy bỏ" Height="34" Width="95" Margin="0,0,10,0" Style="{StaticResource PrimaryButton}" Click="BtnCancel_Click"/>
            <Button x:Name="BtnCreate" Content="Tạo Dự Án" Height="34" Width="115" Style="{StaticResource GreenButton}" IsDefault="True" Click="BtnCreate_Click"/>
        </StackPanel>
    </Grid>
</Window>
