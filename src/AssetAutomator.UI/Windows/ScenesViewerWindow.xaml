<Window x:Class="AssetAutomator.UI.Windows.ScenesViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scenes JSON Detail Viewer" Height="650" Width="1000" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource CanvasBrush}" FontFamily="Segoe UI"
        Icon="pack://application:,,,/Resources/app_logo.png">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Card -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Background="{DynamicResource SurfaceSoftBrush}" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="TxtVideoTitle" Text="Scenes Overview" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                    <TextBlock x:Name="TxtSceneStats" Text="Total scenes: 0" FontSize="12" Foreground="{DynamicResource BodyBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="BtnApplyAllToBatch" Content="📥 Import All Prompts to Queue" Style="{StaticResource GreenButton}" Padding="15,8" FontSize="12" FontWeight="Bold" Click="BtnApplyAllToBatch_Click"/>
            </Grid>
        </Border>

        <!-- DataGrid of Scenes -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Background="{DynamicResource CanvasBrush}" Padding="15" Margin="0,0,0,15">
            <DataGrid x:Name="DgridScenes" AutoGenerateColumns="False" CanUserAddRows="False"
                      Background="Transparent" BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      RowHeaderWidth="0" IsReadOnly="True" RowHeight="36" FontSize="12">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Scene #" Binding="{Binding SceneNumber}" Width="70">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Transcript" Binding="{Binding Transcript}" Width="2*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource BodyBrush}"/>
                                <Setter Property="TextWrapping" Value="NoWrap"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="ToolTip" Value="{Binding Transcript}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Image Prompt" Binding="{Binding ImagePrompt}" Width="3*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                                <Setter Property="TextWrapping" Value="NoWrap"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="ToolTip" Value="{Binding ImagePrompt}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="Action" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Copy" Padding="8,3" Click="BtnCopyPrompt_Click" FontSize="11"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer Bar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Close Window" Width="100" Height="32" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
