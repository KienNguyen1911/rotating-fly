<Window x:Class="AssetAutomator.UI.Windows.CookieInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🔑 Nhập Cookies Gemini" Height="560" Width="780"
        MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="#121214" Foreground="#F4F4F5">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="🔑 Nhập Cookies Gemini" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
            <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#A1A1AA" Margin="0,6,0,0">
                Dán cookies Gemini vào ô bên dưới. Hỗ trợ 3 định dạng:
                <LineBreak/>
                • JSON object:
                <Run FontFamily="Consolas" Foreground="#FBBF24">{"__Secure-1PSID": "abc...", "SID": "..."}</Run>
                <LineBreak/>
                • Chuỗi cookie header:
                <Run FontFamily="Consolas" Foreground="#FBBF24">__Secure-1PSID=abc...; SID=...</Run>
                <LineBreak/>
                • Nguyên file cookies.json (kèm updated_at, user_agent).
            </TextBlock>
        </StackPanel>

        <Border Grid.Row="1" Background="#1E1E22" CornerRadius="8" BorderBrush="#27272A" BorderThickness="1">
            <Grid Margin="2">
                <TextBox x:Name="TxtCookiesInput"
                         Background="Transparent"
                         Foreground="#F4F4F5"
                         BorderThickness="0"
                         Padding="12"
                         FontSize="13"
                         FontFamily="Consolas"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="NoWrap"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto"
                         SpellCheck.IsEnabled="False"/>

                <TextBlock x:Name="TxtPlaceholder"
                           Text="Dán cookies vào đây..."
                           Foreground="#52525B"
                           FontSize="13"
                           FontFamily="Consolas"
                           Margin="14,12,0,0"
                           IsHitTestVisible="False"
                           VerticalAlignment="Top"
                           HorizontalAlignment="Left"/>
            </Grid>
        </Border>

        <Border x:Name="BorderStatus" Grid.Row="2" Margin="0,14,0,0" Background="#1E1E22" CornerRadius="8"
                Padding="12" BorderBrush="#27272A" BorderThickness="1" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="TxtStatusHeader" FontSize="13" FontWeight="Bold" Foreground="#F59E0B" TextWrapping="Wrap"/>
                <TextBlock x:Name="TxtStatusDetails" FontSize="12" Foreground="#A1A1AA" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12" Foreground="#71717A">
                <Run x:Name="RunCharCount" Text="0"/>
                <Run Text=" ký tự"/>
            </TextBlock>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="BtnCancel" Content="Hủy" Padding="16,8"
                        Background="#27272A" Foreground="#FFFFFF" Margin="0,0,8,0"
                        Click="BtnCancel_Click" Cursor="Hand"/>
                <Button x:Name="BtnImport" Content="🔑 Nhập &amp; Lưu Profile" Padding="20,8"
                        Background="#2563EB" Foreground="#FFFFFF" FontWeight="Bold"
                        Click="BtnImport_Click" Cursor="Hand" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
