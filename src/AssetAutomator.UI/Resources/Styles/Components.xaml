<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Card}"/>
        <Setter Property="Padding" Value="{DynamicResource Space.Large}"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource TextSize.SectionTitle}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    </Style>
    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource TextSize.Caption}"/>
        <Setter Property="Foreground" Value="{DynamicResource BodyBrush}"/>
    </Style>
    <Style x:Key="Status.Pending" TargetType="Border">
        <Setter Property="Background" Value="#475569"/>
    </Style>
    <Style x:Key="Status.Running" TargetType="Border">
        <Setter Property="Background" Value="#F59E0B"/>
    </Style>
    <Style x:Key="Status.Success" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SemanticUpBrush}"/>
    </Style>
    <Style x:Key="Status.Danger" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SemanticDownBrush}"/>
    </Style>
</ResourceDictionary>
