<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Shared layout scale: use these values instead of adding new one-off measurements. -->
    <Thickness x:Key="Space.Compact">4</Thickness>
    <Thickness x:Key="Space.Small">8</Thickness>
    <Thickness x:Key="Space.Medium">12</Thickness>
    <Thickness x:Key="Space.Large">16</Thickness>
    <CornerRadius x:Key="Radius.Control">12</CornerRadius>
    <CornerRadius x:Key="Radius.Card">16</CornerRadius>
    <sys:Double x:Key="ControlHeight.Compact">28</sys:Double>
    <sys:Double x:Key="ControlHeight.Default">32</sys:Double>
    <sys:Double x:Key="TextSize.Caption">12</sys:Double>
    <sys:Double x:Key="TextSize.Body">13</sys:Double>
    <sys:Double x:Key="TextSize.SectionTitle">16</sys:Double>
</ResourceDictionary>
