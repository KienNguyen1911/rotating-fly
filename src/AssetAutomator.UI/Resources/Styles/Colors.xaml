<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Stable semantic colour tokens. Themes provide the brush values for these keys. -->
    <Color x:Key="Color.Canvas">#E2E8F0</Color>
    <Color x:Key="Color.Ink">#0F172A</Color>
    <Color x:Key="Color.Primary">#0F172A</Color>
    <Color x:Key="Color.Success">#22C55E</Color>
    <Color x:Key="Color.Warning">#F59E0B</Color>
    <Color x:Key="Color.Danger">#EF4444</Color>
</ResourceDictionary>
