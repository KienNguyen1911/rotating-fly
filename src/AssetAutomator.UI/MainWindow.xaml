                                                     <Border Width="20" Height="20" CornerRadius="10" Margin="2,0" ToolTip="Step 3: ChatGPT Rewrite">
                                                         <Border.Style>
                                                             <Style TargetType="Border">
                                                                 <Setter Property="Background" Value="#475569"/>
                                                                 <Style.Triggers>
                                                                     <DataTrigger Binding="{Binding Step3Status}" Value="Running">
                                                                         <Setter Property="Background" Value="#F59E0B"/>
                                                                     </DataTrigger>
                                                                     <DataTrigger Binding="{Binding Step3Status}" Value="Done">
                                                                         <Setter Property="Background" Value="#10B981"/>
                                                                     </DataTrigger>
                                                                     <DataTrigger Binding="{Binding Step3Status}" Value="Failed">
                                                                         <Setter Property="Background" Value="#EF4444"/>
                                                                     </DataTrigger>
                                                                 </Style.Triggers>
                                                             </Style>
                                                         </Border.Style>
                                                         <TextBlock Text="W" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                     </Border>

                                                     <!-- Step 4: Voiceover -->
                                                     <Border Width="20" Height="20" CornerRadius="10" Margin="2,0" ToolTip="Step 4: Voiceover">
                                                         <Border.Style>
                                                             <Style TargetType="Border">
                                                                 <Setter Property="Background" Value="#475569"/>
                                                                 <Style.Triggers>
                                                                     <DataTrigger Binding="{Binding Step4Status}" Value="Running">
                                                                         <Setter Property="Background" Value="#F59E0B"/>
                                                                     </DataTrigger>
                                                                     <DataTrigger Binding="{Binding Step4Status}" Value="Done">
                                                                         <Setter Property="Background" Value="#10B981"/>
                                                                     </DataTrigger>
                                                                     <DataTrigger Binding="{Binding Step4Status}" Value="Failed">
                                                                         <Setter Property="Background" Value="#EF4444"/>
                                                                     </DataTrigger>
                                                                 </Style.Triggers>
                                                             </Style>
                                                         </Border.Style>
                                                         <TextBlock Text="V" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                     </Border>

                                                     <!-- StepSrt: SRT -->
                                                     <Border Width="20" Height="20" CornerRadius="10" Margin="2,0" ToolTip="Step: SRT Subtitles">
                                                         <Border.Style>
                                                             <Style TargetType="Border">
                                                                 <Setter Property="Background" Value="#475569"/>
                                                                 <Style.Triggers>
                                                                     <DataTrigger Binding="{Binding StepSrtStatus}" Value="Running">
                                                                         <Setter Property="Background" Value="#F59E0B"/>
                                                                     </DataTrigger>
                                                                     <DataTrigger Binding="{Binding StepSrtStatus}" Value="Done">
                                                                         <Setter Property="Background" Value="#10B981"/>
                                                                     </DataTrigger>
                                                                     <DataTrigger Binding="{Binding StepSrtStatus}" Value="Failed">
                                                                         <Setter Property="Background" Value="#EF4444"/>
                                                                     </DataTrigger>
                                                                 </Style.Triggers>
                                                             </Style>
                                                         </Border.Style>
                                                         <TextBlock Text="S" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                     </Border>

                                                     <!-- Step 5: Image Gen -->
                                                     <Border Width="20" Height="20" CornerRadius="10" Margin="2,0" ToolTip="Step 5: Image Generation">
                                                         <Border.Style>
                                                             <Style TargetType="Border">
                                                                 <Setter Property="Background" Value="#475569"/>
                                                                 <Style.Triggers>
                                                                     <DataTrigger Binding="{Binding Step5Status}" Value="Running">
                                                                         <Setter Property="Background" Value="#F59E0B"/>
                                                                     </DataTrigger>
                                                                     <DataTrigger Binding="{Binding Step5Status}" Value="Done">
                                                                         <Setter Property="Background" Value="#10B981"/>
                                                                     </DataTrigger>
                                                                     <DataTrigger Binding="{Binding Step5Status}" Value="Failed">
                                                                         <Setter Property="Background" Value="#EF4444"/>
                                                                     </DataTrigger>
                                                                 </Style.Triggers>
                                                             </Style>
                                                         </Border.Style>
                                                         <TextBlock Text="G" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                     </Border>
                                                 </StackPanel>
                                             </DataTemplate>
                                         </DataGridTemplateColumn.CellTemplate>
                                     </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Action" Width="1.8*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                     <Button Content="Logs" Padding="8,4" Margin="2,0" Click="BtnViewHistoryTaskLog_Click" Height="26" FontSize="11"/>
                                                     <Button Content="Assets" Padding="8,4" Margin="2,0" Style="{StaticResource GreenButton}" Click="BtnViewHistoryTaskAssets_Click" Height="26" FontSize="11"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TabItem: Batch Image Gen -->
            <TabItem Header="Batch Image Gen" Padding="20,8" FontSize="12" FontWeight="SemiBold">
                <Grid Margin="0,15,0,0">

                    <!-- Level 1: Projects Dashboard Panel (Grid View) -->
                    <Grid x:Name="PanelProjectsDashboard" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Dashboard Header Card with Storage Location Setting -->
                        <Border Grid.Row="0" Style="{StaticResource Card}" Background="{DynamicResource SurfaceSoftBrush}" Padding="15" Margin="0,0,0,15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="📁 QUẢN LÝ DỰ ÁN (PROJECTS DASHBOARD)" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="⚙️ Thư mục lưu trữ tất cả Projects: " FontSize="11" Foreground="{DynamicResource BodyBrush}" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtProjectsStoragePath" Width="380" Height="28" FontSize="11" VerticalContentAlignment="Center" Padding="6,0" IsReadOnly="True" Margin="6,0,6,0"/>
                                        <Button x:Name="BtnBrowseProjectsDir" Content="Browse..." Height="28" Padding="10,0" Style="{StaticResource PrimaryButton}" FontSize="11" Click="BtnBrowseProjectsDir_Click"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnCreateProjectDashboard" Content="➕ Tạo dự án mới" Height="38" Padding="16,0" Style="{StaticResource GreenButton}" FontSize="12" FontWeight="Bold" Click="BtnNewProject_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Projects Cards Grid -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ItemsControlProjectsGrid">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" VerticalAlignment="Top"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Background="#18191E" CornerRadius="16" Padding="16" Margin="8" BorderBrush="#2B2D37" BorderThickness="1">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Folder Icon & Project Title -->
                                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Background="#2B2D37" CornerRadius="10" Width="42" Height="42" Margin="0,0,12,0">
                                                        <TextBlock Text="📁" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ProjectName}" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding CreatedAt, StringFormat='Ngày tạo: {0:dd/MM/yyyy HH:mm}'}" FontSize="10" Foreground="#8A90A3"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Output Path Snippet -->
                                                <Border Grid.Row="1" Background="#121317" CornerRadius="6" Padding="8,5" Margin="0,0,0,12">
                                                    <TextBlock Text="{Binding OutputDir, StringFormat='📁 {0}'}" FontSize="10" Foreground="#A0A5B5" TextTrimming="CharacterEllipsis"/>
                                                </Border>

                                                <!-- Settings Badges -->
                                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,15">
                                                    <Border Background="#252733" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding AspectRatio, StringFormat='Tỷ lệ: {0}'}" FontSize="10" Foreground="#CBD5E1"/>
                                                    </Border>
                                                    <Border Background="#252733" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding Engine, StringFormat='Engine: {0}'}" FontSize="10" Foreground="#CBD5E1"/>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Action Buttons -->
                                                <Grid Grid.Row="4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Button x:Name="BtnOpenProjectCard" Content="📂 Mở Dự Án" Height="34" Style="{StaticResource GreenButton}" FontSize="11" FontWeight="Bold" Tag="{Binding}" Click="BtnOpenProjectCard_Click"/>
                                                    <Button Grid.Column="2" x:Name="BtnDeleteProjectCard" Content="🗑️ Xóa" Height="34" Width="60" Style="{StaticResource PrimaryButton}" FontSize="11" Tag="{Binding}" Click="BtnDeleteProjectCard_Click" ToolTip="Xóa dự án này"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Level 2: Project Editor Panel (Current Generator UI) -->
                    <Grid x:Name="PanelProjectEditor" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Sidebar Panel -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                                <StackPanel>
                                    <!-- Section 1: NHÂN VẬT GỐC (High Contrast Fix) -->
                                    <Border Style="{StaticResource Card}" Background="{DynamicResource SurfaceSoftBrush}" Padding="15" Margin="0,0,0,15">
                                        <StackPanel>
                                            <TextBlock Text="1. NHÂN VẬT GỐC" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,10"/>
                                            
                                            <!-- Dashed Border Dropzone with Vibrant High-Contrast Blue Accent -->
                                            <Border x:Name="BorderBatchCharDropzone" BorderBrush="#3B82F6" BorderThickness="2" CornerRadius="0" Background="#161922" Height="150" Cursor="Hand" MouseLeftButtonDown="BtnBatchSelectChar_Click" Margin="0,0,0,10">
                                                <Grid>
                                                    <!-- Empty Placeholder with High Contrast -->
                                                    <StackPanel x:Name="PanelBatchCharEmpty" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock Text="👤+" FontSize="32" HorizontalAlignment="Center" Foreground="#3B82F6" Margin="0,0,0,6"/>
                                                        <TextBlock Text="Chọn ảnh nhân vật" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                                    </StackPanel>

                                                    <!-- Image Preview Thumbnail -->
                                                    <Grid x:Name="PanelBatchCharHasImage" Visibility="Collapsed">
                                                        <Image x:Name="ImgBatchCharPreview" Stretch="UniformToFill"/>
                                                        <Button x:Name="BtnBatchClearChar" Content="✕" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Style="{StaticResource PrimaryButton}" Click="BtnBatchClearChar_Click" ToolTip="Xóa ảnh nhân vật"/>
                                                    </Grid>
                                                </Grid>
                                            </Border>

                                            <TextBlock x:Name="TxtBatchCharInfo" Text="No reference image selected." FontSize="11" Foreground="{DynamicResource BodyBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Tag in Prompt: " FontSize="11" Foreground="{DynamicResource BodyBrush}"/>
                                                <TextBlock x:Name="TxtBatchCharTag" Text="@character" FontSize="11" FontWeight="Bold" Foreground="#3B82F6"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Section 2: KỊCH BẢN (JSON OBJECT/ARRAY) -->
                                    <Border Style="{StaticResource Card}" Background="{DynamicResource SurfaceSoftBrush}" Padding="15" Margin="0,0,0,15">
                                        <StackPanel>
                                            <TextBlock Text="2. KỊCH BẢN (JSON OBJECT/ARRAY)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,10"/>
                                            
                                            <TextBox x:Name="TxtBatchScriptJson" Height="180" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontSize="11" FontFamily="Consolas, Segoe UI" Padding="8" Background="#121316" Foreground="#E2E8F0" BorderBrush="{DynamicResource HairlineBrush}"/>

                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="BtnBatchImportJson" Content="📄 Chọn file JSON" Height="36" Style="{StaticResource PrimaryButton}" FontWeight="Bold" Click="BtnBatchImportJson_Click"/>
                                                <Button x:Name="BtnUpdateScriptJson" Grid.Column="2" Content="{}{ } Cập nhật kịch bản" Height="36" Style="{StaticResource PrimaryButton}" FontWeight="Bold" Click="BtnUpdateScriptJson_Click"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Section 3: CẤU HÌNH -->
                                    <Border Style="{StaticResource Card}" Background="{DynamicResource SurfaceSoftBrush}" Padding="15" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="3. CẤU HÌNH" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,10"/>
                                            
                                            <TextBlock Text="Tỷ lệ khung hình:" FontSize="11" Foreground="{DynamicResource BodyBrush}" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="CboxBatchAspect" Height="32" SelectedIndex="0" SelectionChanged="CboxBatchAspect_SelectionChanged" Margin="0,0,0,12">
                                                <ComboBoxItem Content="16:9 (Widescreen)" Tag="16:9"/>
                                                <ComboBoxItem Content="9:16 (Vertical/Shorts)" Tag="9:16"/>
                                                <ComboBoxItem Content="1:1 (Square)" Tag="1:1"/>
                                                <ComboBoxItem Content="4:3 (Classic)" Tag="4:3"/>
                                                <ComboBoxItem Content="3:4 (Portrait)" Tag="3:4"/>
                                            </ComboBox>

                                            <TextBlock Text="Thư mục lưu ảnh:" FontSize="11" Foreground="{DynamicResource BodyBrush}" Margin="0,0,0,4"/>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="TxtBatchOutputDir" Height="30" VerticalContentAlignment="Center" FontSize="11" Padding="6,0"/>
                                                <Button x:Name="BtnBrowseBatchOutputDir" Grid.Column="1" Content="Browse..." Height="30" Padding="10,0" Margin="6,0,0,0" Style="{StaticResource PrimaryButton}" FontSize="11" Click="BtnBrowseBatchOutputDir_Click"/>
                                            </Grid>

                                            <!-- Hidden Radios for backward compatibility binding -->
                                            <StackPanel Visibility="Collapsed">
                                                <RadioButton x:Name="RadAspect169" Tag="16:9" IsChecked="True" GroupName="GrpAspect"/>
                                                <RadioButton x:Name="RadAspect11" Tag="1:1" GroupName="GrpAspect"/>
                                                <RadioButton x:Name="RadAspect916" Tag="9:16" GroupName="GrpAspect"/>
                                                <RadioButton x:Name="RadAspect43" Tag="4:3" GroupName="GrpAspect"/>
                                                <RadioButton x:Name="RadAspect34" Tag="3:4" GroupName="GrpAspect"/>
                                            </StackPanel>

                                            <!-- Advanced AI Engine Settings Expander -->
                                            <Expander Header="Cấu hình Engine / Model AI..." Foreground="{DynamicResource InkBrush}" FontSize="11" FontWeight="Bold">
                                                <StackPanel Margin="0,10,0,0">
                                                    <TextBlock Text="API Service Provider:" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,4"/>
                                                    <StackPanel Margin="0,0,0,10">
                                                        <RadioButton x:Name="RadProviderGlabs" Content="🔵 G-Labs Webhook API (:8765)" Tag="glabs" IsChecked="True" GroupName="GrpProvider" Foreground="{DynamicResource InkBrush}" Margin="0,2" Checked="RadProvider_Checked"/>
                                                        <RadioButton x:Name="RadProviderFlowLocal" Content="🟢 Flow Image Local API (:8787)" Tag="flow_local" GroupName="GrpProvider" Foreground="{DynamicResource InkBrush}" Margin="0,2" Checked="RadProvider_Checked"/>
                                                    </StackPanel>

                                                    <TextBlock Text="Engine:" FontSize="11" Foreground="{DynamicResource BodyBrush}" Margin="0,0,0,4"/>
                                                    <ComboBox x:Name="CboxBatchEngine" Height="28" SelectedIndex="0" SelectionChanged="CboxBatchEngine_SelectionChanged" Margin="0,0,0,10">
                                                        <ComboBoxItem Content="Flow Image (/generate)" Tag="flow"/>
                                                        <ComboBoxItem Content="Meta AI Vibes (/api/meta/generate)" Tag="meta"/>
                                                        <ComboBoxItem Content="Super Grok AI (/api/grok/generate)" Tag="grok"/>
                                                    </ComboBox>

                                                    <StackPanel x:Name="PanelBatchFlowOptions">
                                                        <TextBlock Text="Model:" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,4"/>
                                                        
                                                        <!-- G-Labs Models Panel -->
                                                        <StackPanel x:Name="PanelModelsGlabs" Margin="0,0,0,8">
                                                            <RadioButton x:Name="RadModelBanana2" Content="Nano Banana 2 (Standard)" Tag="nano_banana_2" IsChecked="True" GroupName="GrpModel" Foreground="{DynamicResource InkBrush}" Margin="0,2"/>
                                                            <RadioButton x:Name="RadModelBananaPro" Content="Nano Banana Pro (Quality)" Tag="nano_banana_pro" GroupName="GrpModel" Foreground="{DynamicResource InkBrush}" Margin="0,2"/>
                                                            <RadioButton x:Name="RadModelBananaLite" Content="Nano Banana 2 Lite (Fast)" Tag="nano_banana_2_lite" GroupName="GrpModel" Foreground="{DynamicResource InkBrush}" Margin="0,2"/>
                                                        </StackPanel>

                                                        <!-- Flow Local Models Panel -->
                                                        <StackPanel x:Name="PanelModelsFlowLocal" Margin="0,0,0,8" Visibility="Collapsed">
                                                            <RadioButton x:Name="RadModelGemini31Flash" Content="Gemini 3.1 Flash Image" Tag="gemini-3.1-flash-image" IsChecked="True" GroupName="GrpModel" Foreground="{DynamicResource InkBrush}" Margin="0,2"/>
                                                            <RadioButton x:Name="RadModelGemini30Pro" Content="Gemini 3.0 Pro Image" Tag="gemini-3.0-pro-image" GroupName="GrpModel" Foreground="{DynamicResource InkBrush}" Margin="0,2"/>
                                                            <RadioButton x:Name="RadModelImagen4Preview" Content="Imagen 4.0 Preview" Tag="imagen-4.0-generate-preview" GroupName="GrpModel" Foreground="{DynamicResource InkBrush}" Margin="0,2"/>
                                                            <RadioButton x:Name="RadModelNanoBanana2Flow" Content="Nano Banana 2" Tag="nano-banana-2" GroupName="GrpModel" Foreground="{DynamicResource InkBrush}" Margin="0,2"/>
                                                            <RadioButton x:Name="RadModelNanoBananaProFlow" Content="Nano Banana Pro" Tag="nano-banana-pro" GroupName="GrpModel" Foreground="{DynamicResource InkBrush}" Margin="0,2"/>
                                                        </StackPanel>

                                                        <TextBlock Text="Upscale / Quality:" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,4"/>
                                                        <StackPanel Margin="0,0,0,8">
                                                            <RadioButton x:Name="RadUpscaleNone" Content="None / Standard" Tag="none" IsChecked="True" GroupName="GrpUpscale" Foreground="{DynamicResource InkBrush}" Margin="0,2"/>
                                                            <RadioButton x:Name="RadUpscale2K" Content="2K High Resolution (HD)" Tag="2K" GroupName="GrpUpscale" Foreground="{DynamicResource InkBrush}" Margin="0,2"/>
                                                            <RadioButton x:Name="RadUpscale4K" Content="4K Ultra Resolution" Tag="4K" GroupName="GrpUpscale" Foreground="{DynamicResource InkBrush}" Margin="0,2"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <TextBlock Text="Max Parallel Threads:" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,4"/>
                                                    <ComboBox x:Name="CboxBatchConcurrency" Height="28" SelectedIndex="2" SelectionChanged="CboxBatchConcurrency_SelectionChanged" Margin="0,0,0,5">
                                                        <ComboBoxItem Content="1 Task (Sequential)" Tag="1"/>
                                                        <ComboBoxItem Content="2 Tasks Parallel" Tag="2"/>
                                                        <ComboBoxItem Content="4 Tasks Parallel (Recommended)" Tag="4"/>
                                                        <ComboBoxItem Content="6 Tasks Parallel (Fast)" Tag="6"/>
                                                        <ComboBoxItem Content="8 Tasks Parallel (Ultra)" Tag="8"/>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Expander>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Fixed Bottom Generate Button -->
                            <Button Grid.Row="1" x:Name="BtnBatchGenerate" Content="⚡ Tạo hàng loạt (4 ảnh song song)" Height="44" Style="{StaticResource GreenButton}" FontSize="13" FontWeight="Bold" Click="BtnBatchGenerate_Click"/>
                        </Grid>

                        <!-- Right Main Panel: Header with Back to Projects & Scene Cards Grid -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Header Card -->
                            <Border Grid.Row="0" Style="{StaticResource Card}" Background="{DynamicResource SurfaceSoftBrush}" Padding="15" Margin="0,0,0,15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="BtnBackToProjects" Content="⬅️ Danh sách Dự án" Height="32" Padding="12,0" Margin="0,0,14,0" Style="{StaticResource PrimaryButton}" FontSize="11" FontWeight="Bold" Click="BtnBackToProjects_Click"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtVideoTitle" Text="Bedtime Psychology" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,3"/>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ProgressBar x:Name="ProgressBatchGen" Height="8" Width="180" Value="0" Maximum="100" VerticalAlignment="Center" Margin="0,0,10,0" Background="#2B2D37" Foreground="#10B981" BorderThickness="0"/>
                                                <TextBlock x:Name="TxtBatchProgress" Text="Đã tạo 0/0 ảnh (0%)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BodyBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="BtnSaveProjectEditor" Content="💾 Lưu dự án" Height="32" Padding="12,0" Margin="0,0,8,0" Style="{StaticResource GreenButton}" FontSize="11" FontWeight="Bold" Click="BtnSaveProject_Click"/>
                                        <Button x:Name="BtnOpenFlowProjectUrl" Content="🌐 Google Flow Web" Height="32" Padding="12,0" Margin="0,0,8,0" Style="{StaticResource PrimaryButton}" FontSize="11" FontWeight="Bold" Click="BtnOpenFlowProjectUrl_Click" ToolTip="Mở dự án này trực tiếp trên Web Google Flow (labs.google)"/>
                                        <Button x:Name="BtnBatchViewToggle" Content="📋 Table Queue View" Height="32" Padding="12,0" Margin="0,0,8,0" Style="{StaticResource PrimaryButton}" FontSize="11" Click="BtnBatchViewToggle_Click"/>
                                        <Button x:Name="BtnBatchOpenFolder" Content="📁 Open Folder" Height="32" Padding="12,0" Style="{StaticResource PrimaryButton}" FontSize="11" Click="BtnBatchOpenFolder_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Card Grid View (Main View) -->
                            <ScrollViewer Grid.Row="1" x:Name="ScrollCardGrid" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="ItemsControlBatchCards">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" VerticalAlignment="Top"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid x:Name="CardItemCell" Margin="6,0,6,14" VerticalAlignment="Top">
                                                <!-- Border with dynamic Height calculated from ActualWidth & AspectRatio -->
                                                <Border Background="#12141A" CornerRadius="0" BorderBrush="#2B2D37" BorderThickness="1" ClipToBounds="True">
                                                    <Border.Height>
                                                        <MultiBinding Converter="{StaticResource AspectRatioHeightConverter}">
                                                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}"/>
                                                            <Binding Path="AspectRatio"/>
                                                        </MultiBinding>
                                                    </Border.Height>

                                                    <Grid x:Name="CardGrid">
                                                        <!-- Waiting/Status Placeholder (Collapsed when image is Done) -->
                                                        <Grid x:Name="GridPlaceholder" Background="#12141A">
                                                            <Grid.Style>
                                                                <Style TargetType="Grid">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Grid.Style>
                                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <TextBlock Text="🖼️" FontSize="18" HorizontalAlignment="Center" Foreground="#4A4E5D" Margin="0,0,0,4"/>
                                                                <TextBlock Text="{Binding Status}" FontSize="10" Foreground="#6C7284" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Clear Crisp Generated Image (100% Un-dimmed) -->
                                                        <Image Source="{Binding ImagePath}" Stretch="UniformToFill" Cursor="Hand" Tag="{Binding}" MouseLeftButtonDown="CardImageContainer_Click"/>

                                                        <!-- Transparent Glass Overlay Container (Appears ONLY on MouseOver!) -->
                                                        <Grid x:Name="OverlayContainer" Background="Transparent">
                                                            <Grid.Style>
                                                                <Style TargetType="Grid">
                                                                    <Setter Property="Opacity" Value="0"/>
                                                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                                            <Setter Property="Opacity" Value="1"/>
                                                                            <Setter Property="IsHitTestVisible" Value="True"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Grid.Style>

                                                            <!-- Top Bar: Scene Title, Status Badge & Action Buttons -->
                                                            <Grid VerticalAlignment="Top" Margin="10">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Left: Scene Badge & Status Badge -->
                                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Border Background="#CC0F172A" CornerRadius="6" Padding="8,4" Margin="0,0,6,0" BorderBrush="#40FFFFFF" BorderThickness="1">
                                                                        <TextBlock Text="{Binding SceneTitle}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                                    </Border>
                                                                    <Border Background="#CC1E293B" CornerRadius="6" Padding="7,4" BorderBrush="#30FFFFFF" BorderThickness="1">
                                                                        <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                                                                    </Border>
                                                                </StackPanel>

                                                                <!-- Right: Quick Action Buttons (Re-gen 🔄, Open 📁, Copy 📋) -->
                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <!-- Re-generate Button -->
                                                                    <Button x:Name="BtnCardRegenerate" Tag="{Binding}" Click="BtnCardRegenerate_Click" ToolTip="Tạo lại ảnh cảnh này (Re-generate)" Cursor="Hand" Margin="0,0,6,0">
                                                                        <Button.Template>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border x:Name="btnBorder" Background="#CC0F172A" BorderBrush="#50FFFFFF" BorderThickness="1" CornerRadius="13" Width="26" Height="26">
                                                                                    <TextBlock Text="🔄" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF"/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter TargetName="btnBorder" Property="Background" Value="#E62563EB"/>
                                                                                        <Setter TargetName="btnBorder" Property="BorderBrush" Value="#80FFFFFF"/>
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Button.Template>
                                                                    </Button>

                                                                    <!-- Open Image File Button -->
                                                                    <Button x:Name="BtnCardOpenImage" Tag="{Binding}" Click="BtnBatchOpenImage_Click" ToolTip="Mở file ảnh" Cursor="Hand" Margin="0,0,6,0">
                                                                        <Button.Template>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border x:Name="btnBorder" Background="#CC0F172A" BorderBrush="#50FFFFFF" BorderThickness="1" CornerRadius="13" Width="26" Height="26">
                                                                                    <TextBlock Text="📁" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF"/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter TargetName="btnBorder" Property="Background" Value="#E610B981"/>
                                                                                        <Setter TargetName="btnBorder" Property="BorderBrush" Value="#80FFFFFF"/>
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Button.Template>
                                                                    </Button>

                                                                    <!-- Copy Prompt Button -->
                                                                    <Button x:Name="BtnCardCopyPrompt" Tag="{Binding}" Click="BtnCardCopyPrompt_Click" ToolTip="Sao chép prompt" Cursor="Hand">
                                                                        <Button.Template>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border x:Name="btnBorder" Background="#CC0F172A" BorderBrush="#50FFFFFF" BorderThickness="1" CornerRadius="13" Width="26" Height="26">
                                                                                    <TextBlock Text="📋" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF"/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter TargetName="btnBorder" Property="Background" Value="#E68B5CF6"/>
                                                                                        <Setter TargetName="btnBorder" Property="BorderBrush" Value="#80FFFFFF"/>
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Button.Template>
                                                                    </Button>
                                                                </StackPanel>
                                                            </Grid>

                                                            <!-- Bottom Glass Bar: Transcript & Prompt Snippet -->
                                                            <Border VerticalAlignment="Bottom" Margin="10" Background="#D9090D16" CornerRadius="8" Padding="10,8" BorderBrush="#30FFFFFF" BorderThickness="1">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Transcript}" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" Margin="0,0,0,3"/>
                                                                    <TextBlock Text="{Binding Prompt}" FontSize="10" FontStyle="Italic" Foreground="#CBD5E1" TextWrapping="Wrap" MaxHeight="28" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Fallback Table View (Hidden by default, togglable) -->
                            <Border Grid.Row="1" x:Name="BorderTableView" Style="{StaticResource Card}" Background="{DynamicResource CanvasBrush}" Padding="15" Visibility="Collapsed">
                                <DataGrid x:Name="DgridBatchImageItems" AutoGenerateColumns="False" CanUserAddRows="False" 
                                          Background="Transparent" BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                          RowHeaderWidth="0" IsReadOnly="True" RowHeight="40" FontSize="12">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="40"/>
                                        <DataGridTextColumn Header="Scene" Binding="{Binding SceneTitle}" Width="80"/>
                                        <DataGridTextColumn Header="Prompt" Binding="{Binding Prompt}" Width="3*"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                                        <DataGridTextColumn Header="Engine" Binding="{Binding Engine}" Width="80"/>
                                        <DataGridTextColumn Header="Aspect" Binding="{Binding AspectRatio}" Width="60"/>
                                        <DataGridTextColumn Header="Finished" Binding="{Binding FinishedTimeFormatted}" Width="80"/>
                                        <DataGridTextColumn Header="Error / Info" Binding="{Binding ErrorMessage}" Width="2*"/>
                                        <DataGridTemplateColumn Header="Action" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Open Image" Padding="6,3" Click="BtnBatchOpenImage_Click" FontSize="11"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Tab 7: Gemini AI Creator (Multi-Task DataGrid Queue) -->
            <TabItem Header="Gemini AI Creator" Padding="20,8" FontSize="12" FontWeight="SemiBold">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Action Toolbar -->
                        <RowDefinition Height="*"/>    <!-- DataGrid -->
                        <RowDefinition Height="Auto"/> <!-- Python Server Log Panel -->
                        <RowDefinition Height="Auto"/> <!-- Status Bar -->
                    </Grid.RowDefinitions>

                    <!-- Top Action Toolbar -->
                    <Border Grid.Row="0" Style="{StaticResource Card}" Background="{DynamicResource SurfaceCardBrush}" Padding="15,12" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="➕ Thêm Task Mới" Click="BtnAddGeminiTask_Click" Height="34" Padding="14,0" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" FontSize="12" FontWeight="SemiBold"/>
                                <Button Content="🗑️ Xóa Task Đã Chọn" Click="BtnDeleteGeminiTasks_Click" Height="34" Padding="14,0" Style="{StaticResource DeleteButton}" Margin="0,0,10,0" FontSize="12" FontWeight="SemiBold"/>
                                <Button x:Name="BtnSuggestTopics" Content="🔍 Gợi Ý Chủ Đề" Click="BtnSuggestTopics_Click" Height="34" Padding="14,0" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" FontSize="12" FontWeight="SemiBold" ToolTip="Nhập link kênh YouTube vào ô 'Chủ Đề' rồi bấm để lấy gợi ý"/>
                                <Button x:Name="BtnRefreshGems" Content="🔄 Tải Danh Sách Gems" Click="BtnRefreshGems_Click" Height="34" Padding="14,0" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" FontSize="12" FontWeight="SemiBold"/>
                                <Button x:Name="BtnImportCookies" Content="🔑 Nạp Cookies Gemini" Click="BtnImportCookies_Click" Height="34" Padding="14,0" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="🚀 CHẠY TASK ĐÃ CHỌN" Click="BtnRunSelectedGeminiTasks_Click" Height="36" Padding="18,0" Style="{StaticResource GreenButton}" FontSize="12" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- DataGrid of Gemini Tasks -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Background="{DynamicResource CanvasBrush}" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="📋 Danh Sách Gemini Automation Tasks" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>

                            <DataGrid Grid.Row="1" x:Name="DgridGeminiTasks" ItemsSource="{Binding GeminiTasks}" AutoGenerateColumns="False" CanUserAddRows="False" 
                                      Background="Transparent" BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      RowHeaderWidth="0" IsReadOnly="False" RowHeight="48" FontSize="12"
                                      RowDetailsVisibilityMode="VisibleWhenSelected"
                                      SelectionMode="Single">
                                <DataGrid.Resources>
                                    <!-- Progress bar style for step progress -->
                                    <Style x:Key="StepProgressBar" TargetType="ProgressBar">
                                        <Setter Property="Height" Value="8"/>
                                        <Setter Property="Minimum" Value="0"/>
                                        <Setter Property="Maximum" Value="100"/>
                                        <Setter Property="Background" Value="#2D3748"/>
                                        <Setter Property="Foreground">
                                            <Setter.Value>
                                                <LinearGradientBrush EndPoint="1,0.5" StartPoint="0,0.5">
                                                    <GradientStop Color="#3B82F6" Offset="0"/>
                                                    <GradientStop Color="#8B5CF6" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ProgressBar">
                                                    <Grid MinHeight="{TemplateBinding Height}">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                                                        <Border x:Name="PART_Track" CornerRadius="4">
                                                            <Border x:Name="PART_Indicator" CornerRadius="4"
                                                                    Background="{TemplateBinding Foreground}"
                                                                    HorizontalAlignment="Left"/>
                                                        </Border>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </DataGrid.Resources>

                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="Padding" Value="4,0"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>

                                <DataGrid.RowDetailsTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceCardBrush}" Padding="16,12" Margin="0,0,0,4"
                                                BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <!-- Content Grid -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Left Column: 🎬 Scriptwriter Config -->
                                                    <Border Grid.Row="0" Grid.Column="0" Margin="0,0,8,8" Padding="12,10"
                                                            Background="{DynamicResource CanvasBrush}" CornerRadius="6"
                                                            BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                                                        <StackPanel>
                                                            <TextBlock Text="🎬 Scriptwriter" FontWeight="Bold" FontSize="12" Margin="0,0,0,8"
                                                                       Foreground="{DynamicResource PrimaryBrush}"/>
                                                            <TextBlock Text="Gem" FontSize="11" Foreground="{DynamicResource SubtleBrush}" Margin="0,0,0,2"/>
                                                            <ComboBox ItemsSource="{Binding DataContext.AvailableScriptwriterGems, ElementName=RootWindow}"
                                                                      SelectedItem="{Binding SelectedScriptwriterGem, Mode=TwoWay}"
                                                                      Height="28" Margin="0,0,0,6"/>
                                                            <TextBlock Text="Model" FontSize="11" Foreground="{DynamicResource SubtleBrush}"/>
                                                            <ComboBox ItemsSource="{Binding DataContext.AvailableAiModels, ElementName=RootWindow}"
                                                                      SelectedItem="{Binding ScriptwriterModel, Mode=TwoWay}" Height="28"/>
                                                            <CheckBox IsChecked="{Binding EnableDeepResearch, Mode=TwoWay}" Content="Bật Deep Research"
                                                                      FontSize="11" Foreground="{DynamicResource InkBrush}" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Right Column: 🎭 Scene Creator Config -->
                                                    <Border Grid.Row="0" Grid.Column="1" Margin="8,0,0,8" Padding="12,10"
                                                            Background="{DynamicResource CanvasBrush}" CornerRadius="6"
                                                            BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                                                        <StackPanel>
                                                            <TextBlock Text="🎭 Scene Creator" FontWeight="Bold" FontSize="12" Margin="0,0,0,8"
                                                                       Foreground="{DynamicResource PrimaryBrush}"/>
                                                            <TextBlock Text="Gem" FontSize="11" Foreground="{DynamicResource SubtleBrush}" Margin="0,0,0,2"/>
                                                            <ComboBox ItemsSource="{Binding DataContext.AvailableSceneCreatorGems, ElementName=RootWindow}"
                                                                      SelectedItem="{Binding SelectedSceneCreatorGem, Mode=TwoWay}"
                                                                      Height="28" Margin="0,0,0,6"/>
                                                            <TextBlock Text="Model" FontSize="11" Foreground="{DynamicResource SubtleBrush}"/>
                                                            <ComboBox ItemsSource="{Binding DataContext.AvailableAiModels, ElementName=RootWindow}"
                                                                      SelectedItem="{Binding SceneCreatorModel, Mode=TwoWay}" Height="28"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Row 1: Voice ID + Provider + Character Ref -->
                                                    <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,8" Padding="12,10"
                                                            Background="{DynamicResource CanvasBrush}" CornerRadius="6"
                                                            BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                                <TextBlock Text="🎙️ Voice ID" FontSize="11" Foreground="{DynamicResource SubtleBrush}" Margin="0,0,0,2"/>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBox Grid.Column="0" Text="{Binding VoiceId, UpdateSourceTrigger=PropertyChanged}" Height="28"/>
                                                                    <Button Grid.Column="1" Content="🔍" Style="{StaticResource IconButton}"
                                                                            Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource OnPrimaryBrush}"
                                                                            BorderThickness="0" Margin="4,0,0,0" Click="BtnBrowseVoice_Click"/>
                                                                </Grid>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                                                <TextBlock Text="🖼️ Provider" FontSize="11" Foreground="{DynamicResource SubtleBrush}" Margin="0,0,0,2"/>
                                                                <ComboBox ItemsSource="{Binding DataContext.AvailableImageProviders, ElementName=RootWindow}"
                                                                          SelectedItem="{Binding SelectedImageProvider, Mode=TwoWay}" Height="28"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                                                <TextBlock Text="👤 Character Ref" FontSize="11" Foreground="{DynamicResource SubtleBrush}" Margin="0,0,0,2"/>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBox Grid.Column="0" Text="{Binding CharacterRef, UpdateSourceTrigger=PropertyChanged}" Height="28"/>
                                                                    <Button Grid.Column="1" Content="📁" Style="{StaticResource IconButton}"
                                                                            Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource OnPrimaryBrush}"
                                                                            BorderThickness="0" Margin="4,0,0,0" Click="BtnBrowseCharacterRef_Click"/>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </Grid>

                                                <!-- Collapse button (top-right overlay) -->
                                                <Button Content="▲" Width="28" Height="28"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Background="Transparent" Foreground="{DynamicResource SubtleBrush}"
                                                        BorderThickness="0" FontSize="11" FontWeight="Bold"
                                                        Click="BtnCollapseGeminiRowDetails_Click"
                                                        ToolTip="Thu gọn bảng cấu hình"
                                                        Cursor="Hand" Margin="0,-4,-4,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </DataGrid.RowDetailsTemplate>

                                <DataGrid.Columns>
                                    <!-- 1. CheckBox Select -->
                                    <DataGridTemplateColumn Width="40">
                                        <DataGridTemplateColumn.Header>
                                            <CheckBox x:Name="ChkSelectAllGeminiTasks" Click="ChkSelectAllGeminiTasks_Click" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- 2. Topic / Link -->
                                    <DataGridTemplateColumn Header="Chủ Đề / Link YouTube" Width="2.5*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Topic, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Padding="6,2" Height="30" Margin="4,0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- 3. Progress Bar + Status (merged) -->
                                    <DataGridTemplateColumn Header="Tiến Trình" Width="1.6*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="6" Padding="6,4" Margin="4,2"
                                                        Background="{DynamicResource SurfaceCardBrush}"
                                                        BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                                                    <StackPanel VerticalAlignment="Center">
                                                        <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}"
                                                                     Style="{StaticResource StepProgressBar}" Margin="0,0,0,4"/>
                                                        <TextBlock Text="{Binding ProgressText}" FontSize="10"
                                                                   Foreground="{DynamicResource SubtleBrush}" HorizontalAlignment="Center"
                                                                   FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- 4. Scriptwriter Quick Badge -->
                                    <DataGridTemplateColumn Header="🎬 Scriptwriter" Width="1.8*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="4" Padding="6,3" Margin="2,0"
                                                        Background="{DynamicResource SurfaceCardBrush}"
                                                        BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
                                                        ToolTip="{Binding ScriptwriterSummary}">
                                                    <TextBlock Text="{Binding ScriptwriterSummary}" FontSize="11"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource InkBrush}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- 5. Scene Creator Quick Badge -->
                                    <DataGridTemplateColumn Header="🎭 Scene Creator" Width="1.8*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="4" Padding="6,3" Margin="2,0"
                                                        Background="{DynamicResource SurfaceCardBrush}"
                                                        BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
                                                        ToolTip="{Binding SceneCreatorSummary}">
                                                    <TextBlock Text="{Binding SceneCreatorSummary}" FontSize="11"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource InkBrush}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- 6. Status Badge -->
                                    <DataGridTemplateColumn Header="Trạng Thái" Width="1*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="6" Padding="6,3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Background="{Binding Status, Converter={StaticResource NodeStatusToBrushConverter}}">
                                                    <TextBlock Text="{Binding StatusBadge}" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- 7. Actions: Run + ... menu -->
                                    <DataGridTemplateColumn Header="Thao Tác" Width="1.2*" IsReadOnly="True">
                                        <DataGridTemplateColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTemplateColumn.HeaderStyle>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Button Content="▶ Run" Style="{StaticResource PrimaryButton}" Padding="10,4" Height="28"
                                                            FontSize="11" FontWeight="SemiBold" Margin="3,0"
                                                            Click="BtnRunSingleGeminiTask_Click" ToolTip="Chạy task này"
                                                            Background="#3B82F6" Foreground="White" BorderThickness="0"/>
                                                    <Button Content="⋮" Height="28" Width="32"
                                                            FontSize="16" FontWeight="ExtraBold" Margin="3,0"
                                                            Click="BtnGeminiTaskMenu_Click" Tag="{Binding}"
                                                            ToolTip="Thêm tùy chọn (Logs, Assets, Delete)"
                                                            Cursor="Hand">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource Button.Base}">
                                                                <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
                                                                <Setter Property="Padding" Value="0"/>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- Python Server Log Panel (Collapsible) -->
                    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,8,0,0"
                            Background="{DynamicResource CanvasBrush}" Padding="12"
                            BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                        <StackPanel>
                            <!-- Header with collapse toggle -->
                            <Grid Cursor="Hand" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnTogglePythonLogs" Content="▼" Width="24" Height="24"
                                        FontSize="10" FontWeight="Bold" Padding="0"
                                        Background="Transparent" Foreground="{DynamicResource InkBrush}"
                                        BorderThickness="0" Cursor="Hand"
                                        Click="BtnTogglePythonLogs_Click"
                                        ToolTip="Mở rộng / Thu gọn Python Server Logs"/>
                                <TextBlock Grid.Column="1" Text="🐍 Python Server Logs" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center"
                                           Margin="4,0,0,0"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtPythonServerStatus" Text="⚪ Unknown" FontSize="11"
                                               Foreground="{DynamicResource SubtleBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <Button Content="🗑️ Clear" Click="BtnClearPythonServerLog_Click" Height="22" Padding="8,0"
                                            Style="{StaticResource SecondaryButton}" FontSize="10" Margin="0,0,8,0"
                                            VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <TextBox x:Name="TxtPythonServerLog"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas"
                                     FontSize="11"
                                     Background="{DynamicResource CanvasBrush}"
                                     Foreground="{DynamicResource InkBrush}"
                                     BorderThickness="0"
                                     MinHeight="120"
                                     MaxHeight="280"
                                     SpellCheck.IsEnabled="False"/>
                        </StackPanel>
                    </Border>

                    <!-- Status Bar for Gemini AI Creator -->
                    <Border Grid.Row="3" Background="{DynamicResource SurfaceCardBrush}" CornerRadius="6" Padding="10,8" Margin="0,8,0,0"
                            BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtGeminiStatusIcon" Grid.Column="0" Text="💡" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtGeminiStatus" Grid.Column="1" Text="Sẵn sàng — Nhấn 'Tải Danh Sách Gems' để làm mới hoặc 'Nạp Cookies' để đăng nhập Gemini."
                                       Foreground="{DynamicResource SubtleBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
 
        <!-- Sidebar Drawer Overlay (slides from right, resizable via drag handle) -->
        <Grid x:Name="SidebarLogs" Grid.Row="1" HorizontalAlignment="Right" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <!-- Drag handle column -->
                <ColumnDefinition Width="Auto"/>
                <!-- Sidebar content column -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
 
            <!-- Drag handle for resizing -->
            <Border Grid.Column="0" Width="6" Background="{DynamicResource HairlineBrush}" Cursor="SizeWE"
                    MouseLeftButtonDown="SidebarDragHandle_MouseLeftButtonDown"
                    MouseMove="SidebarDragHandle_MouseMove"
                    MouseLeftButtonUp="SidebarDragHandle_MouseLeftButtonUp">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
 
            <!-- Sidebar content -->
            <Border Grid.Column="1" Background="{DynamicResource SurfaceSoftBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
 
                    <!-- Header with close button -->
                    <Grid Grid.Row="0" Margin="15,15,15,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Task Live Logs" Foreground="{DynamicResource InkBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="✕" Width="32" Height="32" FontSize="14" FontWeight="ExtraBold" Cursor="Hand" Click="BtnCloseSidebar_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="16" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#EF4444"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter Property="BorderBrush" Value="#EF4444"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- Standard Log content for Tab 1 Automation Tasks -->
                    <RichTextBox Grid.Row="1" x:Name="TxtSidebarLog" Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource InkBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" 
                                 Margin="15,0,15,15" Padding="10" VerticalScrollBarVisibility="Auto" IsReadOnly="True" IsDocumentEnabled="True"
                                 FontSize="12" FontFamily="Consolas" Visibility="Visible">
                        <RichTextBox.Resources>
                            <Style TargetType="Paragraph">
                                <Setter Property="Margin" Value="0,1,0,1"/>
                            </Style>
                        </RichTextBox.Resources>
                    </RichTextBox>

                    <!-- Accordion Steps Log View for Gemini AI Creator -->
                    <ScrollViewer Grid.Row="1" x:Name="GridGeminiStepAccordion" Margin="15,0,15,15" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <!-- Step 1 Accordion -->
                            <Border CornerRadius="8" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" Margin="0,0,0,10">
                                <Expander x:Name="ExpanderStep1" IsExpanded="True" Padding="6">
                                    <Expander.Header>
                                        <Grid Width="380">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Step 1: Gemini Deep Research &amp; Script" Foreground="{DynamicResource InkBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <Border x:Name="BadgeStep1" Grid.Column="1" CornerRadius="10" Padding="8,2" Background="#475569" Margin="5,0">
                                                <TextBlock x:Name="TxtBadgeStep1" Text="⚪ Chờ" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                    </Expander.Header>
                                    <RichTextBox x:Name="TxtLogStep1" Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource InkBrush}" BorderThickness="0" Padding="8" FontFamily="Consolas" FontSize="11" IsReadOnly="True" MinHeight="60" MaxHeight="220" VerticalScrollBarVisibility="Auto"/>
                                </Expander>
                            </Border>

                            <!-- Step 2 Accordion -->
                            <Border CornerRadius="8" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" Margin="0,0,0,10">
                                <Expander x:Name="ExpanderStep2" IsExpanded="False" Padding="6">
                                    <Expander.Header>
                                        <Grid Width="380">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Step 2: Voiceover &amp; SRT Subtitles" Foreground="{DynamicResource InkBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <Border x:Name="BadgeStep2" Grid.Column="1" CornerRadius="10" Padding="8,2" Background="#475569" Margin="5,0">
                                                <TextBlock x:Name="TxtBadgeStep2" Text="⚪ Chờ" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                    </Expander.Header>
                                    <RichTextBox x:Name="TxtLogStep2" Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource InkBrush}" BorderThickness="0" Padding="8" FontFamily="Consolas" FontSize="11" IsReadOnly="True" MinHeight="60" MaxHeight="220" VerticalScrollBarVisibility="Auto"/>
                                </Expander>
                            </Border>

                            <!-- Step 3 Accordion -->
                            <Border CornerRadius="8" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" Margin="0,0,0,10">
                                <Expander x:Name="ExpanderStep3" IsExpanded="False" Padding="6">
                                    <Expander.Header>
                                        <Grid Width="380">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Step 3: Scene Breakdown &amp; Prompts" Foreground="{DynamicResource InkBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <Border x:Name="BadgeStep3" Grid.Column="1" CornerRadius="10" Padding="8,2" Background="#475569" Margin="5,0">
                                                <TextBlock x:Name="TxtBadgeStep3" Text="⚪ Chờ" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                    </Expander.Header>
                                    <RichTextBox x:Name="TxtLogStep3" Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource InkBrush}" BorderThickness="0" Padding="8" FontFamily="Consolas" FontSize="11" IsReadOnly="True" MinHeight="60" MaxHeight="220" VerticalScrollBarVisibility="Auto"/>
                                </Expander>
                            </Border>

                            <!-- Step 4 Accordion -->
                            <Border CornerRadius="8" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" Margin="0,0,0,10">
                                <Expander x:Name="ExpanderStep4" IsExpanded="False" Padding="6">
                                    <Expander.Header>
                                        <Grid Width="380">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Step 4: Batch Image Generation" Foreground="{DynamicResource InkBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <Border x:Name="BadgeStep4" Grid.Column="1" CornerRadius="10" Padding="8,2" Background="#475569" Margin="5,0">
                                                <TextBlock x:Name="TxtBadgeStep4" Text="⚪ Chờ" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                    </Expander.Header>
                                    <RichTextBox x:Name="TxtLogStep4" Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource InkBrush}" BorderThickness="0" Padding="8" FontFamily="Consolas" FontSize="11" IsReadOnly="True" MinHeight="60" MaxHeight="220" VerticalScrollBarVisibility="Auto"/>
                                </Expander>
                            </Border>

                            <!-- Step 5 Accordion -->
                            <Border CornerRadius="8" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" Margin="0,0,0,10">
                                <Expander x:Name="ExpanderStep5" IsExpanded="False" Padding="6">
                                    <Expander.Header>
                                        <Grid Width="380">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Step 5: Export &amp; Packaging" Foreground="{DynamicResource InkBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <Border x:Name="BadgeStep5" Grid.Column="1" CornerRadius="10" Padding="8,2" Background="#475569" Margin="5,0">
                                                <TextBlock x:Name="TxtBadgeStep5" Text="⚪ Chờ" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                    </Expander.Header>
                                    <RichTextBox x:Name="TxtLogStep5" Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource InkBrush}" BorderThickness="0" Padding="8" FontFamily="Consolas" FontSize="11" IsReadOnly="True" MinHeight="60" MaxHeight="220" VerticalScrollBarVisibility="Auto"/>
                                </Expander>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
