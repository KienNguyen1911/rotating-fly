<Window x:Class="AssetAutomator.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AssetAutomator.UI"
        xmlns:converters="clr-namespace:AssetAutomator.UI.Converters"
        mc:Ignorable="d"
        x:Name="RootWindow"
        Title="AssetAutomator" Height="700" Width="1240" MinWidth="1240" MinHeight="700" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource CanvasBrush}" FontFamily="Segoe UI"
        Icon="pack://application:,,,/Resources/app_logo.png">
    <Window.Resources>
        <!-- Value Converters -->
        <converters:YoutubeUrlConverter x:Key="YoutubeUrlConverter"/>
        <converters:AspectRatioHeightConverter x:Key="AspectRatioHeightConverter"/>
        <converters:HexToBrushConverter x:Key="HexToBrushConverter"/>
        <converters:NodeStatusToBrushConverter x:Key="NodeStatusToBrushConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryBrush}" CornerRadius="16" Padding="20,15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="YOUTUBE SCRIPT &amp; VOICEOVER AUTOMATION" Foreground="{DynamicResource OnPrimaryBrush}" FontSize="16" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnLicense" Click="BtnLicense_Click" Cursor="Hand" Margin="0,0,10,0" ToolTip="Quản lý bản quyền ứng dụng">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="12,6"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🔑" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Bản Quyền" Foreground="{DynamicResource InkBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="BtnCheckUpdate" Click="BtnCheckUpdate_Click" Cursor="Hand" Margin="0,0,10,0" ToolTip="Kiểm tra phiên bản cập nhật mới nhất">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="12,6"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🔄" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Check Update" Foreground="{DynamicResource InkBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                    <ToggleButton x:Name="BtnThemeToggle" Click="BtnThemeToggle_Click" Cursor="Hand">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="12,6"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="TxtThemeIcon" Text="🌙" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="TxtThemeLabel" Text="Dark Mode" Foreground="{DynamicResource InkBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main TabControl -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Header="Automation Tasks" Padding="20,8" FontSize="12" FontWeight="SemiBold">
                <Grid Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Toolbar for Tasks -->
                    <Border Grid.Row="0" Style="{StaticResource Card}" Background="{DynamicResource SurfaceSoftBrush}" Padding="15" Margin="0,0,0,15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Chọn tính năng chạy:" Foreground="{DynamicResource InkBrush}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnAddTask" Content="Tạo Task" Height="32" Width="100" Style="{StaticResource GreenButton}" FontSize="12" FontWeight="Bold" Click="BtnAddTask_Click" Margin="0,0,10,0"/>
                                    <Button x:Name="BtnAddBulkTasks" Content="Tạo Nhiều" Height="32" Width="100" Style="{StaticResource PrimaryButton}" FontSize="12" FontWeight="Bold" Click="BtnAddBulkTasks_Click" Margin="0,0,10,0"/>
                                    <Button x:Name="BtnRun" Content="Chạy Task Đã Chọn" Height="32" Width="150" Style="{StaticResource PrimaryButton}" FontSize="12" FontWeight="Bold" Click="BtnRun_Click"/>
                                </StackPanel>
                            </Grid>

                            <WrapPanel Grid.Row="1" Margin="0,12,0,0" VerticalAlignment="Center">
                                <CheckBox x:Name="ChkStepDownloadThumbnail" Content="Download Thumbnail" IsChecked="True" Margin="0,0,20,0" VerticalAlignment="Center"/>
                                <CheckBox x:Name="ChkStepGenerateThumbnail" Content="Generate Thumbnail" IsChecked="True" Margin="0,0,20,0" VerticalAlignment="Center"/>
                                <CheckBox x:Name="ChkStepGetTranscript" Content="Get Transcript" IsChecked="True" Margin="0,0,20,0" VerticalAlignment="Center"/>
                                <CheckBox x:Name="ChkStepRewrittenTranscript" Content="Rewritten Transcript" IsChecked="True" Margin="0,0,20,0" VerticalAlignment="Center"/>
                                <CheckBox x:Name="ChkStepVoiceover" Content="Voiceover" IsChecked="True" Margin="0,0,20,0" VerticalAlignment="Center"/>
                                <CheckBox x:Name="ChkStepSrt" Content="SRT" IsChecked="True" Margin="0,0,20,0" VerticalAlignment="Center"/>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <!-- Tasks Table & Logs Sidebar -->
                    <Grid Grid.Row="1">
                        <!-- Main Area: DataGrid of Tasks (always fills full width) -->
                        <Border Style="{StaticResource Card}" Background="{DynamicResource CanvasBrush}" Padding="15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Title -->
                                    <RowDefinition Height="Auto"/> <!-- Filters -->
                                    <RowDefinition Height="*"/>    <!-- DataGrid -->
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Task Queue &amp; Automation Control" Style="{StaticResource SectionTitle}" Margin="0,0,0,15"/>
                                
                                <!-- Filters Bar -->
                                <WrapPanel Grid.Row="1" Margin="0,0,0,12" VerticalAlignment="Center">
                                    <TextBlock Text="Link Video:" VerticalAlignment="Center" Foreground="{DynamicResource BodyBrush}" Margin="0,2,5,2" FontSize="12"/>
                                    <TextBox x:Name="TxtFilterVideoUrl" Width="130" Height="28" VerticalContentAlignment="Center" Margin="0,2,0,2" TextChanged="FilterFields_TextChanged"/>
                                    
                                    <TextBlock Text="Ngôn ngữ:" VerticalAlignment="Center" Foreground="{DynamicResource BodyBrush}" Margin="12,2,5,2" FontSize="12"/>
                                    <TextBox x:Name="TxtFilterLanguage" Width="85" Height="28" VerticalContentAlignment="Center" Margin="0,2,0,2" TextChanged="FilterFields_TextChanged"/>
                                    
                                    <TextBlock Text="Voice ID:" VerticalAlignment="Center" Foreground="{DynamicResource BodyBrush}" Margin="12,2,5,2" FontSize="12"/>
                                    <TextBox x:Name="TxtFilterVoiceId" Width="85" Height="28" VerticalContentAlignment="Center" Margin="0,2,0,2" TextChanged="FilterFields_TextChanged"/>
                                    
                                    <TextBlock Text="Failures:" VerticalAlignment="Center" Foreground="{DynamicResource BodyBrush}" Margin="12,2,5,2" FontSize="12" FontWeight="SemiBold"/>
                                    <CheckBox x:Name="ChkFilterT" Content="T" VerticalAlignment="Center" Foreground="{DynamicResource SemanticDownBrush}" Margin="3,2" Checked="FilterCheckbox_Changed" Unchecked="FilterCheckbox_Changed"/>
                                    <CheckBox x:Name="ChkFilterR" Content="R" VerticalAlignment="Center" Foreground="{DynamicResource SemanticDownBrush}" Margin="3,2" Checked="FilterCheckbox_Changed" Unchecked="FilterCheckbox_Changed"/>
                                    <CheckBox x:Name="ChkFilterW" Content="W" VerticalAlignment="Center" Foreground="{DynamicResource SemanticDownBrush}" Margin="3,2" Checked="FilterCheckbox_Changed" Unchecked="FilterCheckbox_Changed"/>
                                    <CheckBox x:Name="ChkFilterV" Content="V" VerticalAlignment="Center" Foreground="{DynamicResource SemanticDownBrush}" Margin="3,2" Checked="FilterCheckbox_Changed" Unchecked="FilterCheckbox_Changed"/>
                                    <CheckBox x:Name="ChkFilterS" Content="S" VerticalAlignment="Center" Foreground="{DynamicResource SemanticDownBrush}" Margin="3,2" Checked="FilterCheckbox_Changed" Unchecked="FilterCheckbox_Changed"/>
                                    <CheckBox x:Name="ChkFilterG" Content="G" VerticalAlignment="Center" Foreground="{DynamicResource SemanticDownBrush}" Margin="3,2" Checked="FilterCheckbox_Changed" Unchecked="FilterCheckbox_Changed"/>

                                    <Button x:Name="BtnClearFilters" Content="Xoá Lọc" Width="75" Height="28" Margin="12,2,0,2" FontSize="11" FontWeight="SemiBold" Click="BtnClearFilters_Click"/>
                                </WrapPanel>
                                
                                <DataGrid Grid.Row="2" x:Name="DgridTasks" AutoGenerateColumns="False" CanUserAddRows="False" 
                                          Background="Transparent" BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                          RowHeaderWidth="0" IsReadOnly="False" RowHeight="36" FontSize="13">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Width="0.6*">
                                             <DataGridTemplateColumn.Header>
                                                 <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                     <CheckBox x:Name="ChkSelectAllTasks" Click="ChkSelectAllTasks_Click" ToolTip="Chọn / Bỏ chọn tất cả" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                 </StackPanel>
                                             </DataGridTemplateColumn.Header>
                                             <DataGridTemplateColumn.CellTemplate>
                                                 <DataTemplate>
                                                     <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                 </DataTemplate>
                                             </DataGridTemplateColumn.CellTemplate>
                                         </DataGridTemplateColumn>
 
                                        <DataGridTextColumn Header="Ngày tạo" Binding="{Binding CreatedAtFormatted}" Width="1.4*" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Padding" Value="5,0"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
 
                                        <DataGridTextColumn Header="Link Video" Binding="{Binding VideoUrl, Converter={StaticResource YoutubeUrlConverter}, UpdateSourceTrigger=PropertyChanged}" Width="2*" IsReadOnly="False">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Padding" Value="5,0"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        
                                        <DataGridTextColumn Header="Ngôn ngữ" Binding="{Binding TargetLanguage}" Width="1.2*" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Padding" Value="5,0"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
 
                                        <DataGridTemplateColumn Header="Voice ID" Width="1.5*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="2,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0" Text="{Binding VoiceId, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
                                                        <Button Grid.Column="1" Content="🔍" Style="{StaticResource IconButton}" Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource OnPrimaryBrush}" BorderThickness="0" Margin="4,0,0,0" VerticalAlignment="Center" Click="BtnBrowseVoice_Click" ToolTip="Browse shared voices">
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="Chrome Profile" Width="1.5*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding ProfileList, ElementName=RootWindow}"
                                                              SelectedItem="{Binding SelectedProfile, UpdateSourceTrigger=PropertyChanged}"
                                                              IsEditable="False"
                                                              Height="28" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                         <DataGridTemplateColumn Header="Steps Status" Width="2.2*">
                                             <DataGridTemplateColumn.HeaderStyle>
                                                 <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                     <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                 </Style>
                                             </DataGridTemplateColumn.HeaderStyle>
                                             <DataGridTemplateColumn.CellTemplate>
                                                 <DataTemplate>
                                                     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                         <!-- Step 1: Download Thumbnail -->
                                                         <Border Width="20" Height="20" CornerRadius="10" Margin="2,0" ToolTip="Step 1: Download Thumbnail">
                                                             <Border.Style>
                                                                 <Style TargetType="Border">
                                                                     <Setter Property="Background" Value="#475569"/>
                                                                     <Style.Triggers>
                                                                         <DataTrigger Binding="{Binding Step1Status}" Value="Running">
                                                                             <Setter Property="Background" Value="#F59E0B"/>
                                                                         </DataTrigger>
                                                                         <DataTrigger Binding="{Binding Step1Status}" Value="Done">
                                                                             <Setter Property="Background" Value="#10B981"/>
                                                                         </DataTrigger>
                                                                         <DataTrigger Binding="{Binding Step1Status}" Value="Failed">
                                                                             <Setter Property="Background" Value="#EF4444"/>
                                                                         </DataTrigger>
                                                                     </Style.Triggers>
                                                                 </Style>
                                                             </Border.Style>
                                                             <TextBlock Text="T" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                         </Border>

                                                         <!-- Step 2: Get Transcript -->
                                                         <Border Width="20" Height="20" CornerRadius="10" Margin="2,0" ToolTip="Step 2: Get Transcript">
                                                             <Border.Style>
                                                                 <Style TargetType="Border">
                                                                     <Setter Property="Background" Value="#475569"/>
                                                                     <Style.Triggers>
                                                                         <DataTrigger Binding="{Binding Step2Status}" Value="Running">
                                                                             <Setter Property="Background" Value="#F59E0B"/>
                                                                         </DataTrigger>
                                                                         <DataTrigger Binding="{Binding Step2Status}" Value="Done">
                                                                             <Setter Property="Background" Value="#10B981"/>
                                                                         </DataTrigger>
                                                                         <DataTrigger Binding="{Binding Step2Status}" Value="Failed">
                                                                             <Setter Property="Background" Value="#EF4444"/>
                                                                         </DataTrigger>
                                                                     </Style.Triggers>
                                                                 </Style>
                                                             </Border.Style>
                                                             <TextBlock Text="R" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                         </Border>

                                                         <!-- Step 3: Rewrite Script -->
                                                         <Border Width="20" Height="20" CornerRadius="10" Margin="2,0" ToolTip="Step 3: ChatGPT Rewrite">
                                                             <Border.Style>
                                                                 <Style TargetType="Border">
                                                                     <Setter Property="Background" Value="#475569"/>
                                                                     <Style.Triggers>
                                                                         <DataTrigger Binding="{Binding Step3Status}" Value="Running">
                                                                             <Setter Property="Background" Value="#F59E0B"/>
                                                                         </DataTrigger>
                                                                         <DataTrigger Binding="{Binding Step3Status}" Value="Done">
                                                                             <Setter Property="Background" Value="#10B981"/>
                                                                         </DataTrigger>
                                                                         <DataTrigger Binding="{Binding Step3Status}" Value="Failed">
                                                                             <Setter Property="Background" Value="#EF4444"/>
                                                                         </DataTrigger>
                                                                     </Style.Triggers>
                                                                 </Style>
                                                             </Border.Style>
                                                             <TextBlock Text="W" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                         </Border>

                                                         <!-- Step 4: Voiceover -->
                                                         <Border Width="20" Height="20" CornerRadius="10" Margin="2,0" ToolTip="Step 4: Voiceover">
                                                             <Border.Style>
                                                                 <Style TargetType="Border">
                                                                     <Setter Property="Background" Value="#475569"/>
                                                                     <Style.Triggers>
                                                                         <DataTrigger Binding="{Binding Step4Status}" Value="Running">
                                                                             <Setter Property="Background" Value="#F59E0B"/>
                                                                         </DataTrigger>
                                                                         <DataTrigger Binding="{Binding Step4Status}" Value="Done">
                                                                             <Setter Property="Background" Value="#10B981"/>
                                                                         </DataTrigger>
                                                                         <DataTrigger Binding="{Binding Step4Status}" Value="Failed">
                                                                             <Setter Property="Background" Value="#EF4444"/>
                                                                         </DataTrigger>
                                                                     </Style.Triggers>
                                                                 </Style>
                                                             </Border.Style>
                                                             <TextBlock Text="V" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                         </Border>

                                                         <!-- StepSrt: SRT -->
                                                         <Border Width="20" Height="20" CornerRadius="10" Margin="2,0" ToolTip="Step: SRT Subtitles">
                                                             <Border.Style>
                                                                 <Style TargetType="Border">
                                                                     <Setter Property="Background" Value="#475569"/>
                                                                     <Style.Triggers>
                                                                         <DataTrigger Binding="{Binding StepSrtStatus}" Value="Running">
                                                                             <Setter Property="Background" Value="#F59E0B"/>
                                                                         </DataTrigger>
                                                                         <DataTrigger Binding="{Binding StepSrtStatus}" Value="Done">
                                                                             <Setter Property="Background" Value="#10B981"/>
                                                                         </DataTrigger>
                                                                         <DataTrigger Binding="{Binding StepSrtStatus}" Value="Failed">
                                                                             <Setter Property="Background" Value="#EF4444"/>
                                                                         </DataTrigger>
                                                                     </Style.Triggers>
                                                                 </Style>
                                                             </Border.Style>
                                                             <TextBlock Text="S" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                         </Border>

                                                         <!-- Step 5: Image Gen -->
                                                         <Border Width="20" Height="20" CornerRadius="10" Margin="2,0" ToolTip="Step 5: Image Generation">
                                                             <Border.Style>
                                                                 <Style TargetType="Border">
                                                                     <Setter Property="Background" Value="#475569"/>
                                                                     <Style.Triggers>
                                                                         <DataTrigger Binding="{Binding Step5Status}" Value="Running">
                                                                             <Setter Property="Background" Value="#F59E0B"/>
                                                                         </DataTrigger>
                                                                         <DataTrigger Binding="{Binding Step5Status}" Value="Done">
                                                                             <Setter Property="Background" Value="#10B981"/>
                                                                         </DataTrigger>
                                                                         <DataTrigger Binding="{Binding Step5Status}" Value="Failed">
                                                                             <Setter Property="Background" Value="#EF4444"/>
                                                                         </DataTrigger>
                                                                     </Style.Triggers>
                                                                 </Style>
                                                             </Border.Style>
                                                             <TextBlock Text="G" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                         </Border>
                                                     </StackPanel>
                                                 </DataTemplate>
                                             </DataGridTemplateColumn.CellTemplate>
                                         </DataGridTemplateColumn>

                                         <DataGridTemplateColumn Header="Action" Width="2.2*" IsReadOnly="True">
                                             <DataGridTemplateColumn.HeaderStyle>
                                                 <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                     <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                 </Style>
                                             </DataGridTemplateColumn.HeaderStyle>
                                             <DataGridTemplateColumn.CellTemplate>
                                                 <DataTemplate>
                                                     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                         <Button Content="Run" Style="{StaticResource PrimaryButton}" Padding="8,3" Height="24" Width="45" FontSize="11" FontWeight="SemiBold" Margin="2,0" Click="BtnRunSingleTask_Click"/>
                                                         <Button Content="Logs" Padding="8,3" Height="24" Width="45" FontSize="11" Margin="2,0" Click="BtnViewTaskLog_Click"/>
                                                         <Button Content="Assets" Style="{StaticResource GreenButton}" Padding="8,3" Height="24" Width="55" FontSize="11" Margin="2,0" Click="BtnViewTaskAssets_Click"/>
                                                         <Button Content="Delete" Style="{StaticResource DeleteButton}" Padding="8,3" Height="24" Width="55" FontSize="11" FontWeight="SemiBold" Margin="2,0" Click="BtnDeleteTask_Click"/>
                                                     </StackPanel>
                                                 </DataTemplate>
                                             </DataGridTemplateColumn.CellTemplate>
                                         </DataGridTemplateColumn>
                                     </DataGrid.Columns>
                                 </DataGrid>
                             </Grid>
                         </Border>
 
                     </Grid>
                 </Grid>
             </TabItem>
             <TabItem Header="Image Pool" Padding="20,8" FontSize="12" FontWeight="SemiBold">
                 <Grid Margin="15,15,15,15">
                     <Grid.RowDefinitions>
                         <RowDefinition Height="Auto"/>
                         <RowDefinition Height="*"/>
                     </Grid.RowDefinitions>
 
                     <!-- Top Stats Panel -->
                     <Border Grid.Row="0" Background="{DynamicResource SurfaceSoftBrush}" CornerRadius="16" Padding="15" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" Margin="0,0,0,15">
                         <Grid>
                             <Grid.ColumnDefinitions>
                                 <ColumnDefinition Width="*"/>
                                 <ColumnDefinition Width="*"/>
                                 <ColumnDefinition Width="*"/>
                                 <ColumnDefinition Width="*"/>
                                 <ColumnDefinition Width="*"/>
                                 <ColumnDefinition Width="*"/>
                             </Grid.ColumnDefinitions>
 
                             <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                 <TextBlock Text="Luồng Đang Chạy" Foreground="{DynamicResource BodyBrush}" FontSize="11" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                 <TextBlock x:Name="TxtPoolRunningWorkers" Text="0" Foreground="{DynamicResource InkBrush}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                             </StackPanel>
 
                             <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                 <TextBlock Text="Luồng Tối Đa" Foreground="{DynamicResource BodyBrush}" FontSize="11" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                 <TextBlock x:Name="TxtPoolMaxWorkers" Text="0" Foreground="{DynamicResource InkBrush}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                             </StackPanel>
 
                             <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                 <TextBlock Text="Waiting" Foreground="{DynamicResource BodyBrush}" FontSize="11" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                 <TextBlock x:Name="TxtPoolWaitingRequests" Text="0" Foreground="{DynamicResource InkBrush}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                             </StackPanel>
 
                             <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                 <TextBlock Text="Processing" Foreground="{DynamicResource BodyBrush}" FontSize="11" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                 <TextBlock x:Name="TxtPoolProcessingRequests" Text="0" Foreground="{DynamicResource PrimaryBrush}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                             </StackPanel>
 
                             <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                 <TextBlock Text="Finished" Foreground="{DynamicResource BodyBrush}" FontSize="11" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                 <TextBlock x:Name="TxtPoolFinishedRequests" Text="0" Foreground="{DynamicResource SemanticUpBrush}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                             </StackPanel>
 
                             <StackPanel Grid.Column="5" HorizontalAlignment="Center">
                                 <TextBlock Text="Thời Gian TB (s)" Foreground="{DynamicResource BodyBrush}" FontSize="11" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                 <TextBlock x:Name="TxtPoolAvgTime" Text="0.0" Foreground="{DynamicResource InkBrush}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                             </StackPanel>
                         </Grid>
                     </Border>
 
                     <!-- Table List -->
                     <Border Grid.Row="1" Background="{DynamicResource CanvasBrush}" CornerRadius="16" Padding="15" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="Danh sách Request Tạo Ảnh trong Pool" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Button x:Name="BtnRefreshPool" Content="Tải lại" Width="80" Height="28" HorizontalAlignment="Right" Click="BtnRefreshPool_Click"/>
                            </Grid>
 
                            <DataGrid Grid.Row="1" x:Name="DgridPoolRequests" AutoGenerateColumns="False" CanUserAddRows="False" 
                                      Background="Transparent" BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      RowHeaderWidth="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Task ID" Binding="{Binding TaskId}" Width="Auto">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Video ID" Binding="{Binding VideoId}" Width="Auto">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Account Email" Binding="{Binding AccountName}" Width="Auto">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Created Time" Binding="{Binding CreatedTimeFormatted}" Width="Auto">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Finished Time" Binding="{Binding FinishedTimeFormatted}" Width="Auto">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Error Message" Binding="{Binding ErrorMessage}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Prompt" Binding="{Binding Prompt}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Chrome Profiles" Padding="20,8" FontSize="12" FontWeight="SemiBold">
                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
 
                    <!-- Left: Profiles Listbox -->
                    <Border Grid.Column="0" Background="{DynamicResource SurfaceSoftBrush}" CornerRadius="16" Padding="15" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Select Profile" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                            <ListBox Grid.Row="1" x:Name="LboxProfiles" ItemsSource="{Binding ProfileList}" BorderThickness="0" Background="Transparent" SelectedIndex="0" SelectionChanged="LboxProfiles_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,8" Margin="0,2" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource HairlineBrush}" Background="{DynamicResource CanvasBrush}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="👤" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding}" FontSize="12" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                      <!-- Right: Profile Controls -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
 
                        <!-- Selected Profile Actions Card -->
                        <Border Grid.Row="0" Background="{DynamicResource CanvasBrush}" CornerRadius="16" Padding="20" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Selected Profile Management" FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>
                                
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Selected Profile:" FontSize="12" Foreground="{DynamicResource BodyBrush}"/>
                                        <TextBlock Text="{Binding ElementName=LboxProfiles, Path=SelectedItem}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                        <TextBlock Text="Mặc định: " FontSize="12" Foreground="{DynamicResource BodyBrush}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtDefaultProfileName" Text="None" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
 
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnOpenProfileBrowser" Content="🌐 Open Browser" Width="150" Height="35" Style="{StaticResource PrimaryButton}" Click="BtnOpenProfileBrowser_Click" Margin="0,0,10,0"/>
                                    <Button x:Name="BtnOpenProfileFolder" Content="📂 Open Folder" Width="130" Height="35" Click="BtnOpenProfileFolder_Click" Margin="0,0,10,0"/>
                                    <Button x:Name="BtnSetDefaultProfile" Content="⭐ Đặt làm mặc định" Width="160" Height="35" Style="{StaticResource PrimaryButton}" Click="BtnSetDefaultProfile_Click" Margin="0,0,10,0"/>
                                    <Button x:Name="BtnDeleteProfile" Content="🗑️ Delete Profile" Width="130" Height="35" Style="{StaticResource DeleteButton}" Click="BtnDeleteProfile_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
 
                        <!-- Create New Profile Card -->
                        <Border Grid.Row="2" Background="{DynamicResource CanvasBrush}" CornerRadius="16" Padding="20" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Create New Chrome Profile" FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>
                                <TextBlock Text="Profile Name (e.g. your Gmail or Name):" FontSize="12" Foreground="{DynamicResource BodyBrush}" Margin="0,0,0,5"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtNewProfileName" Height="32" VerticalContentAlignment="Center"/>
                                    <Button x:Name="BtnCreateProfile" Grid.Column="1" Content="Create &amp; Initialize Profile" Width="180" Height="32" Click="BtnCreateProfile_Click" Style="{StaticResource GreenButton}" Margin="10,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
 
                        <!-- Custom GPT settings Card -->
                        <Border Grid.Row="4" Background="{DynamicResource CanvasBrush}" CornerRadius="16" Padding="20" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Cấu hình Custom GPT (Dịch Chay)" FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>
                                <TextBlock Text="Custom GPT URL (Đường dẫn dùng ở Step 3):" FontSize="12" Foreground="{DynamicResource BodyBrush}" Margin="0,0,0,5"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtCustomGptUrl" Height="32" VerticalContentAlignment="Center"/>
                                    <Button x:Name="BtnSaveCustomGptUrl" Grid.Column="1" Content="Lưu URL" Width="120" Height="32" Click="BtnSaveCustomGptUrl_Click" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Settings" Padding="20,8" FontSize="12" FontWeight="SemiBold">
                <Grid Margin="0,15,0,0">
                    <Border Background="{DynamicResource CanvasBrush}" CornerRadius="16" Padding="20" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" VerticalAlignment="Top">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Title -->
                                <RowDefinition Height="*"/>    <!-- Form Fields -->
                                <RowDefinition Height="Auto"/> <!-- Action Buttons -->
                            </Grid.RowDefinitions>
 
                            <TextBlock Grid.Row="0" Text="Cấu Hình Hệ Thống (Settings)" FontSize="16" FontWeight="Bold" Margin="0,0,0,20"/>
 
                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/> <!-- Gap -->
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
 
                                <!-- Column 1: API Keys & Endpoints -->
                                <StackPanel Grid.Column="0">
                                    <!-- AI84 Key -->
                                    <TextBlock Text="AI84 API Key:" Foreground="{DynamicResource BodyBrush}" FontSize="12" Margin="0,0,0,5"/>
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <PasswordBox x:Name="PbSettingsAi84ApiKey" Height="32" VerticalContentAlignment="Center"/>
                                        <Button x:Name="BtnCheckAi84Key" Grid.Column="1" Content="Kiểm tra Key" Width="120" Height="32" Margin="10,0,0,0" Click="BtnCheckAi84Key_Click" Style="{StaticResource PrimaryButton}"/>
                                    </Grid>
 
                                    <!-- Supabase DB Url -->
                                    <TextBlock Text="Supabase PostgreSQL URL (DATABASE_URL):" Foreground="{DynamicResource BodyBrush}" FontSize="12" Margin="0,0,0,5"/>
                                    <PasswordBox x:Name="PbSettingsSupabaseDbUrl" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,15"/>
 
                                    <!-- Image API URL -->
                                    <TextBlock Text="Image API URL (G-Labs / ChatGPT2API):" Foreground="{DynamicResource BodyBrush}" FontSize="12" Margin="0,0,0,5"/>
                                    <TextBox x:Name="TxtSettingsImageApiUrl" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,15"/>
 
                                    <!-- Subtitle API URL -->
                                    <TextBlock Text="Subtitle API URL (Whisper SRT API):" Foreground="{DynamicResource BodyBrush}" FontSize="12" Margin="0,0,0,5"/>
                                    <TextBox x:Name="TxtSettingsSubtitleApiUrl" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,15"/>
 
                                    <!-- Image API Key -->
                                    <TextBlock Text="Image API Key (X-API-Key / Bearer Token):" Foreground="{DynamicResource BodyBrush}" FontSize="12" Margin="0,0,0,5"/>
                                    <PasswordBox x:Name="PbSettingsImageApiKey" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,15"/>
                                </StackPanel>
 
                                <!-- Column 2: System Paths, Max Tasks & Proxies -->
                                <StackPanel Grid.Column="2">
                                    <!-- Chrome Profiles Dir -->
                                    <TextBlock Text="Chrome Profiles Folder Path:" Foreground="{DynamicResource BodyBrush}" FontSize="12" Margin="0,0,0,5"/>
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtSettingsChromeProfilesDir" Height="32" VerticalContentAlignment="Center"/>
                                        <Button x:Name="BtnBrowseChromeProfilesDir" Grid.Column="1" Content="Browse..." Width="80" Height="32" Margin="10,0,0,0" Click="BtnBrowseChromeProfilesDir_Click"/>
                                    </Grid>
 
                                    <!-- Outputs Dir -->
                                    <TextBlock Text="Outputs Folder Path:" Foreground="{DynamicResource BodyBrush}" FontSize="12" Margin="0,0,0,5"/>
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtSettingsOutputsDir" Height="32" VerticalContentAlignment="Center"/>
                                        <Button x:Name="BtnBrowseOutputsDir" Grid.Column="1" Content="Browse..." Width="80" Height="32" Margin="10,0,0,0" Click="BtnBrowseOutputsDir_Click"/>
                                    </Grid>
 
                                    <!-- Concurrent Tasks -->
                                    <TextBlock Text="Số lượng task chạy song song tối đa (Max Concurrent Tasks):" Foreground="{DynamicResource BodyBrush}" FontSize="12" Margin="0,0,0,5"/>
                                    <TextBox x:Name="TxtSettingsMaxConcurrentTasks" Height="32" Width="80" HorizontalAlignment="Left" Margin="0,0,0,15" VerticalContentAlignment="Center" Text="4"/>
 
                                    <!-- Proxies File Path -->
                                    <TextBlock Text="Đường dẫn file Proxies JSON (proxies.json):" Foreground="{DynamicResource BodyBrush}" FontSize="12" Margin="0,0,0,5"/>
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtSettingsProxiesFilePath" Height="32" VerticalContentAlignment="Center"/>
                                        <Button x:Name="BtnBrowseProxiesFile" Grid.Column="1" Content="Browse..." Width="80" Height="32" Margin="10,0,0,0" Click="BtnBrowseProxiesFile_Click"/>
                                        <Button x:Name="BtnTestProxies" Grid.Column="2" Content="Test Proxies" Width="120" Height="32" Margin="10,0,0,0" Click="BtnTestProxies_Click" Style="{StaticResource PrimaryButton}"/>
                                    </Grid>
 
                                    <!-- Manual Proxies Textarea -->
                                    <TextBlock Text="Danh sách Proxy thủ công (mỗi dòng một proxy - định dạng user:pass@ip:port hoặc ip:port):" Foreground="{DynamicResource BodyBrush}" FontSize="12" Margin="0,0,0,5"/>
                                    <Grid Margin="0,0,0,15">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="90"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBox x:Name="TxtSettingsManualProxies" Grid.Row="0" TextWrapping="NoWrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"/>
                                        <Button x:Name="BtnTestManualProxies" Grid.Row="1" Content="Kiểm tra Proxy thủ công" Width="180" Height="32" Margin="0,5,0,0" HorizontalAlignment="Left" Click="BtnTestManualProxies_Click" Style="{StaticResource PrimaryButton}"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
 
                            <!-- Action Buttons -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="BtnSaveSettings" Content="Lưu Cấu Hình" Width="130" Height="35" Click="BtnSaveSettings_Click" Style="{StaticResource GreenButton}" Margin="0,0,10,0"/>
                                <Button x:Name="BtnExportSettings" Content="Xuất Cấu Hình" Width="130" Height="35" Click="BtnExportSettings_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"/>
                                <Button x:Name="BtnImportSettings" Content="Nhập Cấu Hình" Width="130" Height="35" Click="BtnImportSettings_Click" Margin="0,0,10,0"/>
                                <Button x:Name="BtnCheckRequirements" Content="Kiểm Tra Hệ Thống" Width="150" Height="35" Click="BtnCheckRequirements_Click" Style="{StaticResource PrimaryButton}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="History" Padding="20,8" FontSize="12" FontWeight="SemiBold">
                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
 
                    <!-- Left: Dates Listbox -->
                    <Border Grid.Column="0" Background="{DynamicResource SurfaceSoftBrush}" CornerRadius="16" Padding="15" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Lịch sử theo ngày" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                            
                            <ListBox Grid.Row="1" x:Name="LboxHistoryDates" ItemsSource="{Binding HistoryDates}" BorderThickness="0" Background="Transparent" 
                                     SelectedIndex="0" SelectionChanged="LboxHistoryDates_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,8" Margin="0,2" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource HairlineBrush}" Background="{DynamicResource CanvasBrush}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📅" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding}" FontSize="12" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
 
                            <Button Grid.Row="2" Content="Làm mới (Refresh)" Height="32" Margin="0,10,0,0" Click="BtnRefreshHistory_Click"/>
                        </Grid>
                    </Border>
 
                    <!-- Right: Historical Tasks DataGrid -->
                    <Border Grid.Column="2" Background="{DynamicResource CanvasBrush}" CornerRadius="16" Padding="15" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Danh sách task đã tạo" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>

                            <!-- Filters Bar for History -->
                            <WrapPanel Grid.Row="1" Margin="0,0,0,12" VerticalAlignment="Center">
                                <TextBlock Text="Bộ lọc:" VerticalAlignment="Center" Foreground="{DynamicResource BodyBrush}" Margin="0,2,8,2" FontSize="12" FontWeight="SemiBold"/>
                                
                                <TextBlock Text="Link Video:" VerticalAlignment="Center" Foreground="{DynamicResource BodyBrush}" Margin="8,2,4,2" FontSize="12"/>
                                <TextBox x:Name="TxtHistoryFilterVideoUrl" Width="120" Height="28" VerticalContentAlignment="Center" Margin="0,2,0,2" TextChanged="HistoryFilterFields_TextChanged"/>
                                
                                <TextBlock Text="Ngôn ngữ:" VerticalAlignment="Center" Foreground="{DynamicResource BodyBrush}" Margin="10,2,4,2" FontSize="12"/>
                                <TextBox x:Name="TxtHistoryFilterLanguage" Width="80" Height="28" VerticalContentAlignment="Center" Margin="0,2,0,2" TextChanged="HistoryFilterFields_TextChanged"/>
                                
                                <TextBlock Text="Voice ID:" VerticalAlignment="Center" Foreground="{DynamicResource BodyBrush}" Margin="10,2,4,2" FontSize="12"/>
                                <TextBox x:Name="TxtHistoryFilterVoiceId" Width="80" Height="28" VerticalContentAlignment="Center" Margin="0,2,0,2" TextChanged="HistoryFilterFields_TextChanged"/>
                                
                                <TextBlock Text="Failures:" VerticalAlignment="Center" Foreground="{DynamicResource BodyBrush}" Margin="10,2,4,2" FontSize="12" FontWeight="SemiBold"/>
                                <CheckBox x:Name="ChkHistoryFilterT" Content="T" VerticalAlignment="Center" Foreground="{DynamicResource SemanticDownBrush}" Margin="2,2" Checked="HistoryFilterCheckbox_Changed" Unchecked="HistoryFilterCheckbox_Changed"/>
                                <CheckBox x:Name="ChkHistoryFilterR" Content="R" VerticalAlignment="Center" Foreground="{DynamicResource SemanticDownBrush}" Margin="2,2" Checked="HistoryFilterCheckbox_Changed" Unchecked="HistoryFilterCheckbox_Changed"/>
                                <CheckBox x:Name="ChkHistoryFilterW" Content="W" VerticalAlignment="Center" Foreground="{DynamicResource SemanticDownBrush}" Margin="2,2" Checked="HistoryFilterCheckbox_Changed" Unchecked="HistoryFilterCheckbox_Changed"/>
                                <CheckBox x:Name="ChkHistoryFilterV" Content="V" VerticalAlignment="Center" Foreground="{DynamicResource SemanticDownBrush}" Margin="2,2" Checked="HistoryFilterCheckbox_Changed" Unchecked="HistoryFilterCheckbox_Changed"/>
                                <CheckBox x:Name="ChkHistoryFilterS" Content="S" VerticalAlignment="Center" Foreground="{DynamicResource SemanticDownBrush}" Margin="2,2" Checked="HistoryFilterCheckbox_Changed" Unchecked="HistoryFilterCheckbox_Changed"/>
                                <CheckBox x:Name="ChkHistoryFilterG" Content="G" VerticalAlignment="Center" Foreground="{DynamicResource SemanticDownBrush}" Margin="2,2" Checked="HistoryFilterCheckbox_Changed" Unchecked="HistoryFilterCheckbox_Changed"/>

                                <Button x:Name="BtnHistoryClearFilters" Content="Xoá Lọc" Width="70" Height="28" Margin="10,2,0,2" FontSize="11" FontWeight="SemiBold" Click="BtnHistoryClearFilters_Click"/>
                            </WrapPanel>

                            <DataGrid Grid.Row="2" x:Name="DgridHistoryTasks" ItemsSource="{Binding HistoryTasks}" AutoGenerateColumns="False" CanUserAddRows="False" 
                                      Background="Transparent" BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      RowHeaderWidth="0" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Ngày tạo" Binding="{Binding CreatedAtFormatted}" Width="1.4*"/>
                                    <DataGridTextColumn Header="Link Video (ID)" Binding="{Binding VideoUrl, Converter={StaticResource YoutubeUrlConverter}}" Width="1.6*"/>
                                    <DataGridTextColumn Header="Ngôn ngữ" Binding="{Binding TargetLanguage}" Width="1*"/>
                                    <DataGridTextColumn Header="Voice ID" Binding="{Binding VoiceId}" Width="0.8*"/>
                                    <DataGridTemplateColumn Header="Steps Status" Width="2.2*">
                                         <DataGridTemplateColumn.HeaderStyle>
                                             <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                 <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                             </Style>
                                         </DataGridTemplateColumn.HeaderStyle>
                                         <DataGridTemplateColumn.CellTemplate>
                                             <DataTemplate>
                                                 <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                     <!-- Step 1: Download Thumbnail -->
                                                     <Border Width="20" Height="20" CornerRadius="10" Margin="2,0" ToolTip="Step 1: Download Thumbnail">
                                                         <Border.Style>
                                                             <Style TargetType="Border">
                                                                 <Setter Property="Background" Value="#475569"/>
                                                                 <Style.Triggers>
                                                                     <DataTrigger Binding="{Binding Step1Status}" Value="Running">
                                                                         <Setter Property="Background" Value="#F59E0B"/>
                                                                     </DataTrigger>
                                                                     <DataTrigger Binding="{Binding Step1Status}" Value="Done">
                                                                         <Setter Property="Background" Value="#10B981"/>
                                                                     </DataTrigger>
                                                                     <DataTrigger Binding="{Binding Step1Status}" Value="Failed">
                                                                         <Setter Property="Background" Value="#EF4444"/>
                                                                     </DataTrigger>
                                                                 </Style.Triggers>
                                                             </Style>
                                                         </Border.Style>
                                                         <TextBlock Text="T" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                     </Border>

                                                     <!-- Step 2: Get Transcript -->
                                                     <Border Width="20" Height="20" CornerRadius="10" Margin="2,0" ToolTip="Step 2: Get Transcript">
                                                         <Border.Style>
                                                             <Style TargetType="Border">
                                                                 <Setter Property="Background" Value="#475569"/>
                                                                 <Style.Triggers>
                                                                     <DataTrigger Binding="{Binding Step2Status}" Value="Running">
                                                                         <Setter Property="Background" Value="#F59E0B"/>
                                                                     </DataTrigger>
