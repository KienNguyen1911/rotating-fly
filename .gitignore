# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/

# OS files
.DS_Store
Thumbs.db

# Build outputs and packaged archives
dist_package/
*.zip

# Python Portable runtime & setup files (bundled self-contained installer)
tools/PythonEmbed/
tools/PythonSource/
tools/get-pip.py
tools/python-embed.zip

# Runtime logs (created by app or PowerShell test wrappers)
*.log
crash.log
trace_log.txt

# Test runners (PowerShell wrapper outputs)
run-stdout.log
run-stderr.log
test-stdout.log
test-stderr.log

# Legacy mono csproj (disabled)
*.csproj.disabled

# Python module dependencies (downloaded into Modules/)
Modules/*/venv/
Modules/*/__pycache__/
Modules/*/.pytest_cache/

# Runtime authentication/session data — never commit
Modules/*/cookies.json
Modules/*/*cookies*.json
Modules/*/profiles/

# Generated module outputs
Modules/*/output/
Modules/*/screenshots/
Modules/*/tmp/

# Runtime PIDs/sockets for module process managers
Modules/*/*.pid
Modules/*/*.sock

# Local runtime and diagnostic artifacts
logs/
*.out.txt
*.err.txt
*_debug.png
appsettings.json
free-proxies.json

# MSBuild / dotnet build diagnostics
*.binlog
msbuild.log
xc_diag.log
xc_out.log
xaml_error.txt

# Ad-hoc test/debug scripts and logs (kept out of repo)
test_*.py
test_*.ps1
test_*.js
*_test.js
console-*.js
*.html
flow-ext.log
uv-job.log
uv2.log
_*repro*.ps1
_*list*.ps1
_*kill*.ps1
_*restart*.ps1
_*fix-*.ps1
