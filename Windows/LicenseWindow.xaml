<Window x:Class="AssetAutomator.Windows.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kích Hoạt Bản Quyền - AssetAutomator" Height="360" Width="520"
        MinWidth="480" MinHeight="300" WindowStartupLocation="CenterScreen" 
        ResizeMode="CanResizeWithGrip"
        Background="#121214" Foreground="#F4F4F5">
    
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="🔑 Kích Hoạt Bản Quyền" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"/>
            <TextBlock Text="Vui lòng nhập License Key được cấp để bắt đầu sử dụng ứng dụng." 
                       FontSize="13" Foreground="#A1A1AA" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Main Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- License Key Input -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="License Key của bạn:" FontSize="12" FontWeight="Medium" Foreground="#D4D4D8" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtLicenseKey" Background="#1E1E22" Foreground="#FFFFFF" BorderBrush="#3F3F46" BorderThickness="1" 
                             Padding="12,10" FontSize="14" FontFamily="Consolas" VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- Status Card -->
                <Border x:Name="BorderStatusCard" Background="#1E1E22" CornerRadius="8" Padding="14" BorderBrush="#27272A" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="TxtStatusHeader" Text="Trạng thái: Chưa kích hoạt" FontSize="14" FontWeight="Bold" Foreground="#F59E0B"/>
                        <TextBlock x:Name="TxtStatusDetails" Text="Vui lòng nhập License Key hợp lệ để kích hoạt." FontSize="12" Foreground="#A1A1AA" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Actions Footer -->
        <Border Grid.Row="2" Margin="0,16,0,0" Padding="0,12,0,0" BorderBrush="#27272A" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="BtnDeactivate" Content="Hủy kích hoạt" Padding="12,8" Background="#991B1B" Foreground="#FFFFFF" 
                            Margin="0,0,8,0" Click="BtnDeactivate_Click" Cursor="Hand" Visibility="Collapsed"/>
                    <Button x:Name="BtnTransfer" Content="Chuyển máy" Padding="12,8" Background="#D97706" Foreground="#FFFFFF" 
                            Click="BtnTransfer_Click" Cursor="Hand"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="BtnClose" Content="Đóng" Padding="16,8" Background="#27272A" Foreground="#FFFFFF" 
                            Margin="0,0,8,0" Click="BtnClose_Click" Cursor="Hand"/>
                    <Button x:Name="BtnActivate" Content="Kích hoạt" Padding="20,8" Background="#2563EB" Foreground="#FFFFFF" 
                            FontWeight="Bold" Click="BtnActivate_Click" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
