<Window x:Class="AssetAutomator.ProxyTestResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Kết quả Kiểm tra Proxy" Height="450" Width="750"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBrush}" FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="KẾT QUẢ KIỂM TRA PROXY THỦ CÔNG" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
            <TextBlock x:Name="TxtSummary" Text="Tổng cộng: 0 ONLINE, 0 OFFLINE" FontSize="12" Foreground="{StaticResource BodyBrush}" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Results Table -->
        <DataGrid x:Name="GridResults" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" 
                  IsReadOnly="True" Background="Transparent" BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <!-- Proxy Column -->
                <DataGridTextColumn Header="Proxy Address" Binding="{Binding Proxy}" Width="300">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="FontFamily" Value="Consolas"/>
                            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Status Column -->
                <DataGridTemplateColumn Header="Trạng thái" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="12" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource SemanticUpBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                <Setter Property="Background" Value="{StaticResource SemanticDownBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Status}" FontWeight="Bold" Foreground="White" FontSize="11" HorizontalAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Details / Response Column -->
                <DataGridTextColumn Header="Chi tiết phản hồi / Lỗi" Binding="{Binding Response}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource SemanticUpBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource SemanticDownBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Đóng" Width="100" Height="32" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
