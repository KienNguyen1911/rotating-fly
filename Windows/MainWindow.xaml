<Window x:Class="AutoCreateImage.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoCreateImage"
        mc:Ignorable="d"
         Title="YouTube &amp; ChatGPT Automation Prototype" Height="750" Width="1250"
         Background="#0F172A" FontFamily="Segoe UI">
    <Window.Resources>
        <!-- TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ComboBox ToggleButton Template -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="Border" 
                    Background="#1E293B" 
                    BorderBrush="#334155" 
                    BorderThickness="1" 
                    CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="24" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="1" BorderBrush="#334155" BorderThickness="1,0,0,0" Margin="0,2"/>
                    <Path x:Name="Arrow" 
                          Grid.Column="1" 
                          Fill="#94A3B8" 
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Center" 
                          Data="M 0 0 L 4 4 L 8 0 Z"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#334155"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="White"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#334155"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" 
                                          Template="{StaticResource ComboBoxToggleButton}" 
                                          Focusable="false" 
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter x:Name="ContentSite" 
                                              IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              Margin="8,1,28,1" 
                                              VerticalAlignment="Center" 
                                              HorizontalAlignment="Left"/>
                            <TextBox x:Name="PART_EditableTextBox"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Margin="8,1,28,1"
                                     Focusable="True"
                                     Background="Transparent"
                                     Foreground="White"
                                     CaretBrush="White"
                                     BorderThickness="0"
                                     Visibility="Hidden"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"/>
                            <Popup x:Name="Popup" 
                                   Placement="Bottom" 
                                   IsOpen="{TemplateBinding IsDropDownOpen}" 
                                   AllowsTransparency="True" 
                                   Focusable="False" 
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown" 
                                      SnapsToDevicePixels="True" 
                                      MinWidth="{TemplateBinding ActualWidth}" 
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" 
                                            Background="#0F172A" 
                                            BorderBrush="#475569" 
                                            BorderThickness="1" 
                                            CornerRadius="4"/>
                                    <ScrollViewer Margin="4,6" SnapsToDevicePixels="True" VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="true">
                                <Setter Property="IsTabStop" Value="false"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="DropDownBorder" Property="Height" Value="95"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Padding" Value="8,5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3B82F6"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- TabItem Custom Template for Dark Theme -->
        <Style TargetType="TabItem">
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <ContentPresenter Content="{TemplateBinding Content}"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="1,1,1,1" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}" 
                                Margin="0,0,8,0">
                            <ContentPresenter x:Name="ContentSite"
                                              ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Border" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="White"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>
        
        <!-- DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#334155"/>
        </Style>
        
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3B82F6"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- Value Converters -->
        <local:YoutubeUrlConverter x:Key="YoutubeUrlConverter"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="15" Margin="0,0,0,15" BorderBrush="#334155" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="YOUTUBE SCRIPT &amp; VOICEOVER AUTOMATION" Foreground="White" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="Prototype V2 - C# Playwright Automation Flow" Foreground="#93C5FD" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main TabControl -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Header="Automation Tasks" Padding="15,6" FontSize="12" FontWeight="SemiBold">
                <Grid Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Toolbar for Tasks -->
                    <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="15" Margin="0,0,0,15" BorderBrush="#334155" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Manage tasks configuration directly inside the table rows below. Press 'Tạo Task' to add a new row." VerticalAlignment="Center" Foreground="#94A3B8" FontSize="12" FontStyle="Italic"/>

                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnAddTask" Content="Tạo Task" Height="28" Width="100" Background="#10B981" Foreground="White" BorderThickness="0" FontSize="12" FontWeight="Bold" Click="BtnAddTask_Click" Margin="0,0,10,0"/>
                                <Button x:Name="BtnAddBulkTasks" Content="Tạo Nhiều" Height="28" Width="100" Background="#8B5CF6" Foreground="White" BorderThickness="0" FontSize="12" FontWeight="Bold" Click="BtnAddBulkTasks_Click" Margin="0,0,10,0"/>
                                <Button x:Name="BtnRun" Content="Chạy Task Đã Chọn" Height="28" Width="140" Background="#2563EB" Foreground="White" BorderThickness="0" FontSize="12" FontWeight="Bold" Click="BtnRun_Click"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,12,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Chọn tính năng chạy:" Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                <CheckBox x:Name="ChkStepDownloadThumbnail" Content="Download Thumbnail" IsChecked="True" Foreground="White" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                <CheckBox x:Name="ChkStepGenerateThumbnail" Content="Generate Thumbnail" IsChecked="True" Foreground="White" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                <CheckBox x:Name="ChkStepGetTranscript" Content="Get Transcript" IsChecked="True" Foreground="White" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                <CheckBox x:Name="ChkStepRewrittenTranscript" Content="Rewritten Transcript" IsChecked="True" Foreground="White" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                <CheckBox x:Name="ChkStepVoiceover" Content="Voiceover" IsChecked="True" Foreground="White" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                <CheckBox x:Name="ChkStepSrt" Content="SRT" IsChecked="True" Foreground="White" Margin="0,0,15,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Tasks Table & Logs Sidebar -->
                    <Grid Grid.Row="1">
                        <!-- Main Area: DataGrid of Tasks (always fills full width) -->
                        <Border Background="#1E293B" CornerRadius="8" Padding="15" BorderBrush="#334155" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Title -->
                                    <RowDefinition Height="Auto"/> <!-- Filters -->
                                    <RowDefinition Height="*"/>    <!-- DataGrid -->
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Task Queue &amp; Automation Control" FontSize="16" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,0,15"/>
                                
                                <!-- Filters Bar -->
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                                    <TextBlock Text="Bộ lọc:" VerticalAlignment="Center" Foreground="#94A3B8" Margin="0,0,10,0" FontSize="12" FontWeight="SemiBold"/>
                                    
                                    <TextBlock Text="Link Video:" VerticalAlignment="Center" Foreground="#94A3B8" Margin="10,0,5,0" FontSize="12"/>
                                    <TextBox x:Name="TxtFilterVideoUrl" Width="140" Height="26" VerticalContentAlignment="Center" Background="#1E293B" Foreground="White" BorderBrush="#334155" TextChanged="FilterFields_TextChanged" CaretBrush="White"/>
                                    
                                    <TextBlock Text="Ngôn ngữ:" VerticalAlignment="Center" Foreground="#94A3B8" Margin="15,0,5,0" FontSize="12"/>
                                    <TextBox x:Name="TxtFilterLanguage" Width="90" Height="26" VerticalContentAlignment="Center" Background="#1E293B" Foreground="White" BorderBrush="#334155" TextChanged="FilterFields_TextChanged" CaretBrush="White"/>
                                    
                                    <TextBlock Text="Voice ID:" VerticalAlignment="Center" Foreground="#94A3B8" Margin="15,0,5,0" FontSize="12"/>
                                    <TextBox x:Name="TxtFilterVoiceId" Width="90" Height="26" VerticalContentAlignment="Center" Background="#1E293B" Foreground="White" BorderBrush="#334155" TextChanged="FilterFields_TextChanged" CaretBrush="White"/>
                                    
                                    <TextBlock Text="Failures:" VerticalAlignment="Center" Foreground="#94A3B8" Margin="15,0,5,0" FontSize="12" FontWeight="SemiBold"/>
                                    <CheckBox x:Name="ChkFilterT" Content="T" VerticalAlignment="Center" Foreground="#EF4444" Margin="3,0" Checked="FilterCheckbox_Changed" Unchecked="FilterCheckbox_Changed"/>
                                    <CheckBox x:Name="ChkFilterR" Content="R" VerticalAlignment="Center" Foreground="#EF4444" Margin="3,0" Checked="FilterCheckbox_Changed" Unchecked="FilterCheckbox_Changed"/>
                                    <CheckBox x:Name="ChkFilterW" Content="W" VerticalAlignment="Center" Foreground="#EF4444" Margin="3,0" Checked="FilterCheckbox_Changed" Unchecked="FilterCheckbox_Changed"/>
                                    <CheckBox x:Name="ChkFilterV" Content="V" VerticalAlignment="Center" Foreground="#EF4444" Margin="3,0" Checked="FilterCheckbox_Changed" Unchecked="FilterCheckbox_Changed"/>
                                    <CheckBox x:Name="ChkFilterS" Content="S" VerticalAlignment="Center" Foreground="#EF4444" Margin="3,0" Checked="FilterCheckbox_Changed" Unchecked="FilterCheckbox_Changed"/>
                                    <CheckBox x:Name="ChkFilterG" Content="G" VerticalAlignment="Center" Foreground="#EF4444" Margin="3,0" Checked="FilterCheckbox_Changed" Unchecked="FilterCheckbox_Changed"/>

                                    <Button x:Name="BtnClearFilters" Content="Xoá Lọc" Width="65" Height="26" Margin="15,0,0,0" Background="#475569" Foreground="White" BorderThickness="0" FontSize="11" FontWeight="SemiBold" Click="BtnClearFilters_Click">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                                
                                <DataGrid Grid.Row="2" x:Name="DgridTasks" AutoGenerateColumns="False" CanUserAddRows="False" 
                                          Background="Transparent" BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                          RowHeaderWidth="0" IsReadOnly="False" RowHeight="36" FontSize="13">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Resources>
                                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3B82F6"/>
                                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#334155"/>
                                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White"/>
                                            </Style.Resources>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#334155"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Chọn" Width="0.6*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn Header="Ngày tạo" Binding="{Binding CreatedAtFormatted}" Width="1.4*" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Padding" Value="5,0"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTextColumn Header="Link Video" Binding="{Binding VideoUrl, Converter={StaticResource YoutubeUrlConverter}, UpdateSourceTrigger=PropertyChanged}" Width="2*" IsReadOnly="False">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Padding" Value="5,0"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        
                                        <DataGridTextColumn Header="Ngôn ngữ" Binding="{Binding TargetLanguage}" Width="1.2*" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Padding" Value="5,0"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTemplateColumn Header="Voice ID" Width="1.5*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="2,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0" Text="{Binding VoiceId, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalAlignment="Center" VerticalContentAlignment="Center" BorderThickness="1" BorderBrush="#334155" Background="#1E293B" Foreground="White" CaretBrush="White"/>
                                                        <Button Grid.Column="1" Content="🔍" Width="28" Height="28" Margin="4,0,0,0" VerticalAlignment="Center" Click="BtnBrowseVoice_Click" ToolTip="Browse shared voices" Background="#3B82F6" Foreground="White" BorderThickness="0">
                                                            <Button.Resources>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="CornerRadius" Value="4"/>
                                                                </Style>
                                                            </Button.Resources>
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="Chrome Profile" Width="1.5*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ProfileList}"
                                                              SelectedItem="{Binding SelectedProfile, UpdateSourceTrigger=PropertyChanged}"
                                                              IsEditable="False"
                                                              Height="28" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                         <DataGridTemplateColumn Header="Steps Status" Width="2.2*">
                                             <DataGridTemplateColumn.HeaderStyle>
                                                 <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                     <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                 </Style>
                                             </DataGridTemplateColumn.HeaderStyle>
                                             <DataGridTemplateColumn.CellTemplate>
                                                 <DataTemplate>
                                                     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                         <!-- Step 1: Download Thumbnail -->
                                                         <Border Width="20" Height="20" CornerRadius="10" Margin="2,0" ToolTip="Step 1: Download Thumbnail">
                                                             <Border.Style>
                                                                 <Style TargetType="Border">
                                                                     <Setter Property="Background" Value="#475569"/>
                                                                     <Style.Triggers>
                                                                         <DataTrigger Binding="{Binding Step1Status}" Value="Running">
                                                                             <Setter Property="Background" Value="#F59E0B"/>
                                                                         </DataTrigger>
                                                                         <DataTrigger Binding="{Binding Step1Status}" Value="Done">
                                                                             <Setter Property="Background" Value="#10B981"/>
                                                                         </DataTrigger>
                                                                         <DataTrigger Binding="{Binding Step1Status}" Value="Failed">
                                                                             <Setter Property="Background" Value="#EF4444"/>
                                                                         </DataTrigger>
                                                                     </Style.Triggers>
                                                                 </Style>
                                                             </Border.Style>
                                                             <TextBlock Text="T" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                         </Border>

                                                         <!-- Step 2: Get Transcript -->
                                                         <Border Width="20" Height="20" CornerRadius="10" Margin="2,0" ToolTip="Step 2: Get Transcript">
                                                             <Border.Style>
                                                                 <Style TargetType="Border">
                                                                     <Setter Property="Background" Value="#475569"/>
                                                                     <Style.Triggers>
                                                                         <DataTrigger Binding="{Binding Step2Status}" Value="Running">
                                                                             <Setter Property="Background" Value="#F59E0B"/>
                                                                         </DataTrigger>
                                                                         <DataTrigger Binding="{Binding Step2Status}" Value="Done">
                                                                             <Setter Property="Background" Value="#10B981"/>
                                                                         </DataTrigger>
                                                                         <DataTrigger Binding="{Binding Step2Status}" Value="Failed">
                                                                             <Setter Property="Background" Value="#EF4444"/>
                                                                         </DataTrigger>
                                                                     </Style.Triggers>
                                                                 </Style>
                                                             </Border.Style>
                                                             <TextBlock Text="R" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                         </Border>

                                                         <!-- Step 3: Rewrite Script -->
                                                         <Border Width="20" Height="20" CornerRadius="10" Margin="2,0" ToolTip="Step 3: ChatGPT Rewrite">
                                                             <Border.Style>
                                                                 <Style TargetType="Border">
                                                                     <Setter Property="Background" Value="#475569"/>
                                                                     <Style.Triggers>
                                                                         <DataTrigger Binding="{Binding Step3Status}" Value="Running">
                                                                             <Setter Property="Background" Value="#F59E0B"/>
                                                                         </DataTrigger>
                                                                         <DataTrigger Binding="{Binding Step3Status}" Value="Done">
                                                                             <Setter Property="Background" Value="#10B981"/>
                                                                         </DataTrigger>
                                                                         <DataTrigger Binding="{Binding Step3Status}" Value="Failed">
                                                                             <Setter Property="Background" Value="#EF4444"/>
                                                                         </DataTrigger>
                                                                     </Style.Triggers>
                                                                 </Style>
                                                             </Border.Style>
                                                             <TextBlock Text="W" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                         </Border>

                                                         <!-- Step 4: Voiceover -->
                                                         <Border Width="20" Height="20" CornerRadius="10" Margin="2,0" ToolTip="Step 4: Voiceover">
                                                             <Border.Style>
                                                                 <Style TargetType="Border">
                                                                     <Setter Property="Background" Value="#475569"/>
                                                                     <Style.Triggers>
                                                                         <DataTrigger Binding="{Binding Step4Status}" Value="Running">
                                                                             <Setter Property="Background" Value="#F59E0B"/>
                                                                         </DataTrigger>
                                                                         <DataTrigger Binding="{Binding Step4Status}" Value="Done">
                                                                             <Setter Property="Background" Value="#10B981"/>
                                                                         </DataTrigger>
                                                                         <DataTrigger Binding="{Binding Step4Status}" Value="Failed">
                                                                             <Setter Property="Background" Value="#EF4444"/>
                                                                         </DataTrigger>
                                                                     </Style.Triggers>
                                                                 </Style>
                                                             </Border.Style>
                                                             <TextBlock Text="V" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                         </Border>

                                                         <!-- StepSrt: SRT -->
                                                         <Border Width="20" Height="20" CornerRadius="10" Margin="2,0" ToolTip="Step: SRT Subtitles">
                                                             <Border.Style>
                                                                 <Style TargetType="Border">
                                                                     <Setter Property="Background" Value="#475569"/>
                                                                     <Style.Triggers>
                                                                         <DataTrigger Binding="{Binding StepSrtStatus}" Value="Running">
                                                                             <Setter Property="Background" Value="#F59E0B"/>
                                                                         </DataTrigger>
                                                                         <DataTrigger Binding="{Binding StepSrtStatus}" Value="Done">
                                                                             <Setter Property="Background" Value="#10B981"/>
                                                                         </DataTrigger>
                                                                         <DataTrigger Binding="{Binding StepSrtStatus}" Value="Failed">
                                                                             <Setter Property="Background" Value="#EF4444"/>
                                                                         </DataTrigger>
                                                                     </Style.Triggers>
                                                                 </Style>
                                                             </Border.Style>
                                                             <TextBlock Text="S" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                         </Border>

                                                         <!-- Step 5: Image Gen -->
                                                         <Border Width="20" Height="20" CornerRadius="10" Margin="2,0" ToolTip="Step 5: Image Generation">
                                                             <Border.Style>
                                                                 <Style TargetType="Border">
                                                                     <Setter Property="Background" Value="#475569"/>
                                                                     <Style.Triggers>
                                                                         <DataTrigger Binding="{Binding Step5Status}" Value="Running">
                                                                             <Setter Property="Background" Value="#F59E0B"/>
                                                                         </DataTrigger>
                                                                         <DataTrigger Binding="{Binding Step5Status}" Value="Done">
                                                                             <Setter Property="Background" Value="#10B981"/>
                                                                         </DataTrigger>
                                                                         <DataTrigger Binding="{Binding Step5Status}" Value="Failed">
                                                                             <Setter Property="Background" Value="#EF4444"/>
                                                                         </DataTrigger>
                                                                     </Style.Triggers>
                                                                 </Style>
                                                             </Border.Style>
                                                             <TextBlock Text="G" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                         </Border>
                                                     </StackPanel>
                                                 </DataTemplate>
                                             </DataGridTemplateColumn.CellTemplate>
                                         </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="Action" Width="2.2*" IsReadOnly="True">
                                            <DataGridTemplateColumn.HeaderStyle>
                                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTemplateColumn.HeaderStyle>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Button Content="Run" Padding="6,3" Margin="2,0" Click="BtnRunSingleTask_Click" Background="#2563EB" Foreground="White" BorderThickness="0" FontSize="11" FontWeight="SemiBold"/>
                                                        <Button Content="Logs" Padding="6,3" Margin="2,0" Click="BtnViewTaskLog_Click" Background="#475569" Foreground="White" BorderThickness="0" FontSize="11"/>
                                                        <Button Content="Assets" Padding="6,3" Margin="2,0" Click="BtnViewTaskAssets_Click" Background="#10B981" Foreground="White" BorderThickness="0" FontSize="11"/>
                                                        <Button Content="Delete" Padding="6,3" Margin="2,0" Click="BtnDeleteTask_Click" Background="#EF4444" Foreground="White" BorderThickness="0" FontSize="11" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Image Pool" Padding="15,6" FontSize="12" FontWeight="SemiBold">
                <Grid Margin="15,15,15,15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Stats Panel -->
                    <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="15" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="Luồng Đang Chạy" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtPoolRunningWorkers" Text="0" Foreground="#F8FAFC" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="Luồng Tối Đa" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtPoolMaxWorkers" Text="0" Foreground="#F8FAFC" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="Waiting" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtPoolWaitingRequests" Text="0" Foreground="#FBBF24" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                <TextBlock Text="Processing" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtPoolProcessingRequests" Text="0" Foreground="#60A5FA" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                <TextBlock Text="Finished" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtPoolFinishedRequests" Text="0" Foreground="#34D399" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="5" HorizontalAlignment="Center">
                                <TextBlock Text="Thời Gian TB (s)" Foreground="#94A3B8" FontSize="11" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtPoolAvgTime" Text="0.0" Foreground="#F8FAFC" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Table List -->
                    <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" Padding="15" BorderBrush="#334155" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="Danh sách Request Tạo Ảnh trong Pool" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                <Button x:Name="BtnRefreshPool" Content="Tải lại" Width="80" Height="25" HorizontalAlignment="Right" Click="BtnRefreshPool_Click" Background="#475569" Foreground="White" BorderThickness="0" FontSize="11" FontWeight="SemiBold">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>

                            <DataGrid Grid.Row="1" x:Name="DgridPoolRequests" AutoGenerateColumns="False" CanUserAddRows="False" 
                                      Background="Transparent" RowBackground="#0F172A" AlternatingRowBackground="#1E293B" 
                                      BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155" 
                                      Foreground="#F1F5F9" RowHeaderWidth="0">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#334155"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Padding" Value="10,6"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </Style>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Padding" Value="10,8"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="DataGridCell">
                                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#3B82F6"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Task ID" Binding="{Binding TaskId}" Width="Auto"/>
                                    <DataGridTextColumn Header="Video ID" Binding="{Binding VideoId}" Width="Auto"/>
                                    <DataGridTextColumn Header="Account Email" Binding="{Binding AccountName}" Width="Auto"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                                    <DataGridTextColumn Header="Created Time" Binding="{Binding CreatedTimeFormatted}" Width="Auto"/>
                                    <DataGridTextColumn Header="Finished Time" Binding="{Binding FinishedTimeFormatted}" Width="Auto"/>
                                    <DataGridTextColumn Header="Error Message" Binding="{Binding ErrorMessage}" Width="*"/>
                                    <DataGridTextColumn Header="Prompt" Binding="{Binding Prompt}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Chrome Profiles" Padding="15,6" FontSize="12" FontWeight="SemiBold">
                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Profiles Listbox -->
                    <Border Grid.Column="0" Background="#1E293B" CornerRadius="8" Padding="15" BorderBrush="#334155" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Select Profile" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,10"/>
                            <ListBox Grid.Row="1" x:Name="LboxProfiles" ItemsSource="{Binding ProfileList}" BorderThickness="0" Background="Transparent" SelectedIndex="0" SelectionChanged="LboxProfiles_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,8" Margin="0,2" CornerRadius="4" BorderThickness="1" BorderBrush="#334155" Background="#0F172A">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="👤" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding}" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Right: Profile Controls -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Selected Profile Actions Card -->
                        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="20" BorderBrush="#334155" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Selected Profile Management" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,15"/>
                                
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Selected Profile:" FontSize="12" Foreground="#94A3B8"/>
                                        <TextBlock Text="{Binding ElementName=LboxProfiles, Path=SelectedItem}" FontSize="18" FontWeight="Bold" Foreground="#60A5FA" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                        <TextBlock Text="Mặc định: " FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtDefaultProfileName" Text="None" FontSize="14" FontWeight="Bold" Foreground="#FBBF24" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnOpenProfileBrowser" Content="🌐 Open Browser" Width="150" Height="35" Background="#2563EB" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Click="BtnOpenProfileBrowser_Click" Margin="0,0,10,0"/>
                                    <Button x:Name="BtnOpenProfileFolder" Content="📂 Open Folder" Width="130" Height="35" Background="#475569" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Click="BtnOpenProfileFolder_Click" Margin="0,0,10,0"/>
                                    <Button x:Name="BtnSetDefaultProfile" Content="⭐ Đặt làm mặc định" Width="150" Height="35" Background="#D97706" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Click="BtnSetDefaultProfile_Click" Margin="0,0,10,0"/>
                                    <Button x:Name="BtnDeleteProfile" Content="🗑️ Delete Profile" Width="130" Height="35" Background="#EF4444" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Click="BtnDeleteProfile_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Create New Profile Card -->
                        <Border Grid.Row="2" Background="#1E293B" CornerRadius="8" Padding="20" BorderBrush="#334155" BorderThickness="1" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Create New Chrome Profile" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,15"/>
                                <TextBlock Text="Profile Name (e.g. your Gmail or Name):" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,5"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtNewProfileName" Height="30" VerticalContentAlignment="Center" Padding="5" />
                                    <Button x:Name="BtnCreateProfile" Grid.Column="1" Content="Create &amp; Initialize Profile" Width="180" Height="30" Margin="10,0,0,0" Click="BtnCreateProfile_Click" Background="#10B981" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Custom GPT settings Card -->
                        <Border Grid.Row="4" Background="#1E293B" CornerRadius="8" Padding="20" BorderBrush="#334155" BorderThickness="1" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Cấu hình Custom GPT (Dịch Chay)" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,15"/>
                                <TextBlock Text="Custom GPT URL (Đường dẫn dùng ở Step 3):" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,5"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtCustomGptUrl" Height="30" VerticalContentAlignment="Center" Padding="5" />
                                    <Button x:Name="BtnSaveCustomGptUrl" Grid.Column="1" Content="Lưu URL" Width="120" Height="30" Margin="10,0,0,0" Click="BtnSaveCustomGptUrl_Click" Background="#2563EB" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Settings" Padding="15,6" FontSize="12" FontWeight="SemiBold">
                <Grid Margin="0,15,0,0">
                    <Border Background="#1E293B" CornerRadius="8" Padding="20" BorderBrush="#334155" BorderThickness="1" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Cấu Hình Hệ Thống (Settings)" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,20"/>

                            <!-- AI84 Key -->
                            <TextBlock Text="AI84 API Key:" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,5"/>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="PbSettingsAi84ApiKey" Height="30" VerticalContentAlignment="Center" Background="#1E293B" Foreground="White" BorderBrush="#334155" BorderThickness="1" Padding="6,4"/>
                                <Button x:Name="BtnCheckAi84Key" Grid.Column="1" Content="Kiểm tra Key" Width="120" Height="30" Margin="10,0,0,0" Click="BtnCheckAi84Key_Click" Background="#2563EB" Foreground="White" BorderThickness="0" FontWeight="SemiBold">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>

                            <!-- Supabase DB Url -->
                            <TextBlock Text="Supabase PostgreSQL URL (DATABASE_URL):" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,5"/>
                            <PasswordBox x:Name="PbSettingsSupabaseDbUrl" Height="30" VerticalContentAlignment="Center" Background="#1E293B" Foreground="White" BorderBrush="#334155" BorderThickness="1" Padding="6,4" Margin="0,0,0,15"/>

                            <!-- Image API URL -->
                            <TextBlock Text="Image API URL (G-Labs / ChatGPT2API):" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtSettingsImageApiUrl" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

                            <!-- Subtitle API URL -->
                            <TextBlock Text="Subtitle API URL (Whisper SRT API):" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtSettingsSubtitleApiUrl" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

                            <!-- Image API Key -->
                            <TextBlock Text="Image API Key (X-API-Key / Bearer Token):" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,5"/>
                            <PasswordBox x:Name="PbSettingsImageApiKey" Height="30" VerticalContentAlignment="Center" Background="#1E293B" Foreground="White" BorderBrush="#334155" BorderThickness="1" Padding="6,4" Margin="0,0,0,15"/>

                            <!-- Chrome Profiles Dir -->
                            <TextBlock Text="Chrome Profiles Folder Path:" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,5"/>
