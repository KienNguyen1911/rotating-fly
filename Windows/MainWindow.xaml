                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtSettingsChromeProfilesDir" Height="30" VerticalContentAlignment="Center"/>
                                <Button x:Name="BtnBrowseChromeProfilesDir" Grid.Column="1" Content="Browse..." Width="80" Height="30" Margin="10,0,0,0" Click="BtnBrowseChromeProfilesDir_Click" Background="#475569" Foreground="White" BorderThickness="0">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>

                            <!-- Outputs Dir -->
                            <TextBlock Text="Outputs Folder Path:" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,5"/>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtSettingsOutputsDir" Height="30" VerticalContentAlignment="Center"/>
                                <Button x:Name="BtnBrowseOutputsDir" Grid.Column="1" Content="Browse..." Width="80" Height="30" Margin="10,0,0,0" Click="BtnBrowseOutputsDir_Click" Background="#475569" Foreground="White" BorderThickness="0">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>

                            <!-- Concurrent Tasks -->
                            <TextBlock Text="Số lượng task chạy song song tối đa (Max Concurrent Tasks):" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtSettingsMaxConcurrentTasks" Height="30" Width="80" HorizontalAlignment="Left" Margin="0,0,0,20" VerticalContentAlignment="Center" Text="4"/>

                            <!-- Proxies File Path -->
                            <TextBlock Text="Đường dẫn file Proxies JSON (proxies.json):" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,5"/>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtSettingsProxiesFilePath" Height="30" VerticalContentAlignment="Center"/>
                                <Button x:Name="BtnBrowseProxiesFile" Grid.Column="1" Content="Browse..." Width="80" Height="30" Margin="10,0,0,0" Click="BtnBrowseProxiesFile_Click" Background="#475569" Foreground="White" BorderThickness="0">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <Button x:Name="BtnTestProxies" Grid.Column="2" Content="Test Proxies" Width="120" Height="30" Margin="10,0,0,0" Click="BtnTestProxies_Click" Background="#8B5CF6" Foreground="White" BorderThickness="0" FontWeight="SemiBold">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>

                            <!-- Action Buttons -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Button x:Name="BtnSaveSettings" Content="Lưu Cấu Hình" Width="130" Height="35" Click="BtnSaveSettings_Click" Background="#10B981" Foreground="White" BorderThickness="0" FontWeight="Bold" Margin="0,0,10,0">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <Button x:Name="BtnExportSettings" Content="Xuất Cấu Hình" Width="130" Height="35" Click="BtnExportSettings_Click" Background="#2563EB" Foreground="White" BorderThickness="0" FontWeight="Bold" Margin="0,0,10,0">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <Button x:Name="BtnImportSettings" Content="Nhập Cấu Hình" Width="130" Height="35" Click="BtnImportSettings_Click" Background="#475569" Foreground="White" BorderThickness="0" FontWeight="Bold">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="History" Padding="15,6" FontSize="12" FontWeight="SemiBold">
                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Dates Listbox -->
                    <Border Grid.Column="0" Background="#1E293B" CornerRadius="8" Padding="15" BorderBrush="#334155" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Lịch sử theo ngày" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,10"/>
                            
                            <ListBox Grid.Row="1" x:Name="LboxHistoryDates" ItemsSource="{Binding HistoryDates}" BorderThickness="0" Background="Transparent" 
                                     SelectedIndex="0" SelectionChanged="LboxHistoryDates_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,8" Margin="0,2" CornerRadius="4" BorderThickness="1" BorderBrush="#334155" Background="#0F172A">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📅" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding}" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Button Grid.Row="2" Content="Làm mới (Refresh)" Height="30" Margin="0,10,0,0" Click="BtnRefreshHistory_Click" Background="#2563EB" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
                        </Grid>
                    </Border>

                    <!-- Right: Historical Tasks DataGrid -->
                    <Border Grid.Column="2" Background="#1E293B" CornerRadius="8" Padding="15" BorderBrush="#334155" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Danh sách task đã tạo" FontSize="16" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,0,15"/>
                            
                            <!-- Filters Bar for History -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                                <TextBlock Text="Bộ lọc:" VerticalAlignment="Center" Foreground="#94A3B8" Margin="0,0,10,0" FontSize="12" FontWeight="SemiBold"/>
                                
                                <TextBlock Text="Link Video:" VerticalAlignment="Center" Foreground="#94A3B8" Margin="10,0,5,0" FontSize="12"/>
                                <TextBox x:Name="TxtHistoryFilterVideoUrl" Width="140" Height="26" VerticalContentAlignment="Center" Background="#1E293B" Foreground="White" BorderBrush="#334155" TextChanged="HistoryFilterFields_TextChanged" CaretBrush="White"/>
                                
                                <TextBlock Text="Ngôn ngữ:" VerticalAlignment="Center" Foreground="#94A3B8" Margin="15,0,5,0" FontSize="12"/>
                                <TextBox x:Name="TxtHistoryFilterLanguage" Width="90" Height="26" VerticalContentAlignment="Center" Background="#1E293B" Foreground="White" BorderBrush="#334155" TextChanged="HistoryFilterFields_TextChanged" CaretBrush="White"/>
                                
                                <TextBlock Text="Voice ID:" VerticalAlignment="Center" Foreground="#94A3B8" Margin="15,0,5,0" FontSize="12"/>
                                <TextBox x:Name="TxtHistoryFilterVoiceId" Width="90" Height="26" VerticalContentAlignment="Center" Background="#1E293B" Foreground="White" BorderBrush="#334155" TextChanged="HistoryFilterFields_TextChanged" CaretBrush="White"/>
                                
                                <TextBlock Text="Failures:" VerticalAlignment="Center" Foreground="#94A3B8" Margin="15,0,5,0" FontSize="12" FontWeight="SemiBold"/>
                                <CheckBox x:Name="ChkHistoryFilterT" Content="T" VerticalAlignment="Center" Foreground="#EF4444" Margin="3,0" Checked="HistoryFilterCheckbox_Changed" Unchecked="HistoryFilterCheckbox_Changed"/>
                                <CheckBox x:Name="ChkHistoryFilterR" Content="R" VerticalAlignment="Center" Foreground="#EF4444" Margin="3,0" Checked="HistoryFilterCheckbox_Changed" Unchecked="HistoryFilterCheckbox_Changed"/>
                                <CheckBox x:Name="ChkHistoryFilterW" Content="W" VerticalAlignment="Center" Foreground="#EF4444" Margin="3,0" Checked="HistoryFilterCheckbox_Changed" Unchecked="HistoryFilterCheckbox_Changed"/>
                                <CheckBox x:Name="ChkHistoryFilterV" Content="V" VerticalAlignment="Center" Foreground="#EF4444" Margin="3,0" Checked="HistoryFilterCheckbox_Changed" Unchecked="HistoryFilterCheckbox_Changed"/>
                                <CheckBox x:Name="ChkHistoryFilterS" Content="S" VerticalAlignment="Center" Foreground="#EF4444" Margin="3,0" Checked="HistoryFilterCheckbox_Changed" Unchecked="HistoryFilterCheckbox_Changed"/>
                                <CheckBox x:Name="ChkHistoryFilterG" Content="G" VerticalAlignment="Center" Foreground="#EF4444" Margin="3,0" Checked="HistoryFilterCheckbox_Changed" Unchecked="HistoryFilterCheckbox_Changed"/>

                                <Button x:Name="BtnHistoryClearFilters" Content="Xoá Lọc" Width="65" Height="26" Margin="15,0,0,0" Background="#475569" Foreground="White" BorderThickness="0" FontSize="11" FontWeight="SemiBold" Click="BtnHistoryClearFilters_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>

                            <DataGrid Grid.Row="2" x:Name="DgridHistoryTasks" ItemsSource="{Binding HistoryTasks}" AutoGenerateColumns="False" CanUserAddRows="False" 
                                      Background="Transparent" BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      RowHeaderWidth="0" IsReadOnly="True">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Resources>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3B82F6"/>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#334155"/>
                                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White"/>
                                        </Style.Resources>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#334155"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Ngày tạo" Binding="{Binding CreatedAtFormatted}" Width="1.4*"/>
                                    <DataGridTextColumn Header="Link Video (ID)" Binding="{Binding VideoUrl, Converter={StaticResource YoutubeUrlConverter}}" Width="1.6*"/>
                                    <DataGridTextColumn Header="Ngôn ngữ" Binding="{Binding TargetLanguage}" Width="1*"/>
                                    <DataGridTextColumn Header="Voice ID" Binding="{Binding VoiceId}" Width="0.8*"/>
                                    <DataGridTemplateColumn Header="Steps Status" Width="2.2*">
                                         <DataGridTemplateColumn.HeaderStyle>
                                             <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                 <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                             </Style>
                                         </DataGridTemplateColumn.HeaderStyle>
                                         <DataGridTemplateColumn.CellTemplate>
                                             <DataTemplate>
                                                 <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                     <!-- Step 1: Download Thumbnail -->
                                                     <Border Width="20" Height="20" CornerRadius="10" Margin="2,0" ToolTip="Step 1: Download Thumbnail">
                                                         <Border.Style>
                                                             <Style TargetType="Border">
                                                                 <Setter Property="Background" Value="#475569"/>
                                                                 <Style.Triggers>
                                                                     <DataTrigger Binding="{Binding Step1Status}" Value="Running">
                                                                         <Setter Property="Background" Value="#F59E0B"/>
                                                                     </DataTrigger>
                                                                     <DataTrigger Binding="{Binding Step1Status}" Value="Done">
                                                                         <Setter Property="Background" Value="#10B981"/>
                                                                     </DataTrigger>
                                                                     <DataTrigger Binding="{Binding Step1Status}" Value="Failed">
                                                                         <Setter Property="Background" Value="#EF4444"/>
                                                                     </DataTrigger>
                                                                 </Style.Triggers>
                                                             </Style>
                                                         </Border.Style>
                                                         <TextBlock Text="T" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                     </Border>

                                                     <!-- Step 2: Get Transcript -->
                                                     <Border Width="20" Height="20" CornerRadius="10" Margin="2,0" ToolTip="Step 2: Get Transcript">
                                                         <Border.Style>
                                                             <Style TargetType="Border">
                                                                 <Setter Property="Background" Value="#475569"/>
                                                                 <Style.Triggers>
                                                                     <DataTrigger Binding="{Binding Step2Status}" Value="Running">
                                                                         <Setter Property="Background" Value="#F59E0B"/>
                                                                     </DataTrigger>
                                                                     <DataTrigger Binding="{Binding Step2Status}" Value="Done">
                                                                         <Setter Property="Background" Value="#10B981"/>
                                                                     </DataTrigger>
                                                                     <DataTrigger Binding="{Binding Step2Status}" Value="Failed">
                                                                         <Setter Property="Background" Value="#EF4444"/>
                                                                     </DataTrigger>
                                                                 </Style.Triggers>
                                                             </Style>
                                                         </Border.Style>
                                                         <TextBlock Text="R" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                     </Border>

                                                     <!-- Step 3: Rewrite Script -->
                                                     <Border Width="20" Height="20" CornerRadius="10" Margin="2,0" ToolTip="Step 3: ChatGPT Rewrite">
                                                         <Border.Style>
                                                             <Style TargetType="Border">
                                                                 <Setter Property="Background" Value="#475569"/>
                                                                 <Style.Triggers>
                                                                     <DataTrigger Binding="{Binding Step3Status}" Value="Running">
                                                                         <Setter Property="Background" Value="#F59E0B"/>
                                                                     </DataTrigger>
                                                                     <DataTrigger Binding="{Binding Step3Status}" Value="Done">
                                                                         <Setter Property="Background" Value="#10B981"/>
                                                                     </DataTrigger>
                                                                     <DataTrigger Binding="{Binding Step3Status}" Value="Failed">
                                                                         <Setter Property="Background" Value="#EF4444"/>
                                                                     </DataTrigger>
                                                                 </Style.Triggers>
                                                             </Style>
                                                         </Border.Style>
                                                         <TextBlock Text="W" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                     </Border>

                                                     <!-- Step 4: Voiceover -->
                                                     <Border Width="20" Height="20" CornerRadius="10" Margin="2,0" ToolTip="Step 4: Voiceover">
                                                         <Border.Style>
                                                             <Style TargetType="Border">
                                                                 <Setter Property="Background" Value="#475569"/>
                                                                 <Style.Triggers>
                                                                     <DataTrigger Binding="{Binding Step4Status}" Value="Running">
                                                                         <Setter Property="Background" Value="#F59E0B"/>
                                                                     </DataTrigger>
                                                                     <DataTrigger Binding="{Binding Step4Status}" Value="Done">
                                                                         <Setter Property="Background" Value="#10B981"/>
                                                                     </DataTrigger>
                                                                     <DataTrigger Binding="{Binding Step4Status}" Value="Failed">
                                                                         <Setter Property="Background" Value="#EF4444"/>
                                                                     </DataTrigger>
                                                                 </Style.Triggers>
                                                             </Style>
                                                         </Border.Style>
                                                         <TextBlock Text="V" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                     </Border>

                                                     <!-- StepSrt: SRT -->
                                                     <Border Width="20" Height="20" CornerRadius="10" Margin="2,0" ToolTip="Step: SRT Subtitles">
                                                         <Border.Style>
                                                             <Style TargetType="Border">
                                                                 <Setter Property="Background" Value="#475569"/>
                                                                 <Style.Triggers>
                                                                     <DataTrigger Binding="{Binding StepSrtStatus}" Value="Running">
                                                                         <Setter Property="Background" Value="#F59E0B"/>
                                                                     </DataTrigger>
                                                                     <DataTrigger Binding="{Binding StepSrtStatus}" Value="Done">
                                                                         <Setter Property="Background" Value="#10B981"/>
                                                                     </DataTrigger>
                                                                     <DataTrigger Binding="{Binding StepSrtStatus}" Value="Failed">
                                                                         <Setter Property="Background" Value="#EF4444"/>
                                                                     </DataTrigger>
                                                                 </Style.Triggers>
                                                             </Style>
                                                         </Border.Style>
                                                         <TextBlock Text="S" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                     </Border>

                                                     <!-- Step 5: Image Gen -->
                                                     <Border Width="20" Height="20" CornerRadius="10" Margin="2,0" ToolTip="Step 5: Image Generation">
                                                         <Border.Style>
                                                             <Style TargetType="Border">
                                                                 <Setter Property="Background" Value="#475569"/>
                                                                 <Style.Triggers>
                                                                     <DataTrigger Binding="{Binding Step5Status}" Value="Running">
                                                                         <Setter Property="Background" Value="#F59E0B"/>
                                                                     </DataTrigger>
                                                                     <DataTrigger Binding="{Binding Step5Status}" Value="Done">
                                                                         <Setter Property="Background" Value="#10B981"/>
                                                                     </DataTrigger>
                                                                     <DataTrigger Binding="{Binding Step5Status}" Value="Failed">
                                                                         <Setter Property="Background" Value="#EF4444"/>
                                                                     </DataTrigger>
                                                                 </Style.Triggers>
                                                             </Style>
                                                         </Border.Style>
                                                         <TextBlock Text="G" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                     </Border>
                                                 </StackPanel>
                                             </DataTemplate>
                                         </DataGridTemplateColumn.CellTemplate>
                                     </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Action" Width="1.8*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="Logs" Padding="6,3" Margin="2,0" Click="BtnViewHistoryTaskLog_Click" Background="#475569" Foreground="White" BorderThickness="0" FontSize="11"/>
                                                    <Button Content="Assets" Padding="6,3" Margin="2,0" Click="BtnViewHistoryTaskAssets_Click" Background="#10B981" Foreground="White" BorderThickness="0" FontSize="11"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Sidebar Drawer Overlay (slides from right, resizable via drag handle) -->
        <Grid x:Name="SidebarLogs" Grid.Row="1" HorizontalAlignment="Right" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <!-- Drag handle column -->
                <ColumnDefinition Width="Auto"/>
                <!-- Sidebar content column -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Drag handle for resizing -->
            <Border Grid.Column="0" Width="6" Background="#334155" Cursor="SizeWE"
                    MouseLeftButtonDown="SidebarDragHandle_MouseLeftButtonDown"
                    MouseMove="SidebarDragHandle_MouseMove"
                    MouseLeftButtonUp="SidebarDragHandle_MouseLeftButtonUp">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3B82F6"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <!-- Sidebar content -->
            <Border Grid.Column="1" Background="#0B0F19" BorderBrush="#3B82F6" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header with close button -->
                    <Grid Grid.Row="0" Margin="15,15,15,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Task Live Logs" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="✕" Width="30" Height="30" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="16" Click="BtnCloseSidebar_Click"/>
                    </Grid>

                    <!-- Log content (stretches to fill sidebar width) -->
                    <TextBox Grid.Row="1" x:Name="TxtSidebarLog" Background="Transparent" Foreground="#F8FAFC" BorderThickness="0" 
                              Margin="15,0,15,15" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsReadOnly="True" 
                              FontSize="12" FontFamily="Consolas" AcceptsReturn="True"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
