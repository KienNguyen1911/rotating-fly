<Window x:Class="AssetAutomator.BulkTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Tạo Nhiều Task" Height="480" Width="680"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBrush}" FontFamily="Segoe UI" FontSize="13"
        Icon="pack://application:,,,/Resources/app_logo.png">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Title & Description -->
            <RowDefinition Height="Auto"/>
            <!-- Text area input -->
            <RowDefinition Height="*"/>
            <!-- Action buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Tạo Nhiều Task Tự Động" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="Nhập danh sách YouTube URL và Voice ID (1 dòng = 1 link + 1 voice id, phân tách bởi khoảng trắng hoặc tab)" FontSize="12" Foreground="{StaticResource BodyBrush}" Margin="0,4,0,0"/>
            <TextBlock Text="Ví dụ:&#x0a;https://www.youtube.com/watch?v=sHo_tlZ3PZ0&#x9;UgBBYS2sOqTuMpoF3BR0&#x0a;https://www.youtube.com/watch?v=YGpllKL3YP8&#x9;UgBBYS2sOqTuMpoF3BR0" FontSize="11" Foreground="{StaticResource BodyBrush}" FontStyle="Italic" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Input Area -->
        <TextBox Grid.Row="1" x:Name="TxtBulkInput" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20"/>

        <!-- Bottom Actions -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnCancel" Content="Hủy bỏ" Width="90" Height="32" Margin="0,0,12,0" Click="BtnCancel_Click"/>
                <Button x:Name="BtnCreate" Content="Tạo Task" Width="120" Height="32" Style="{StaticResource GreenButton}" Click="BtnCreate_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
