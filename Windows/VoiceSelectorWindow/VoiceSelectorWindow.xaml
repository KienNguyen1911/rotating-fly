<Window x:Class="AssetAutomator.VoiceSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Select ElevenLabs Shared Voice" Height="650" Width="1050"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CanvasBrush}" FontFamily="Segoe UI" FontSize="13"
        Icon="pack://application:,,,/Resources/app_logo.png">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Content (Filters Left, Table Right) -->
            <RowDefinition Height="*"/>
            <!-- Bottom Controls -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="ElevenLabs Shared Voices Explorer" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="Search, filter, and select a shared voice to use for Text-to-Speech" FontSize="12" Foreground="{StaticResource BodyBrush}" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <!-- Filters Sidebar -->
                <ColumnDefinition Width="280"/>
                <!-- Splitter -->
                <ColumnDefinition Width="15"/>
                <!-- Voices Grid -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Filters Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceSoftBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="16" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="FILTERS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12"/>

                            <!-- Search -->
                            <TextBlock Text="Search (Name / Label)" Foreground="{StaticResource BodyBrush}" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtSearch" Height="30" Margin="0,0,0,12" KeyDown="FilterInput_KeyDown"/>

                            <!-- Sort -->
                            <TextBlock Text="Sort Criteria" Foreground="{StaticResource BodyBrush}" FontSize="11" Margin="0,0,0,4"/>
                            <ComboBox x:Name="ComboSort" Height="30" Margin="0,0,0,12">
                                <ComboBoxItem Content="Trending" Tag="trending" IsSelected="True"/>
                                <ComboBoxItem Content="Created Date" Tag="created_date"/>
                                <ComboBoxItem Content="Cloned Count" Tag="cloned_by_count"/>
                                <ComboBoxItem Content="1 Year Usage" Tag="usage_character_count_1y"/>
                            </ComboBox>

                            <!-- Gender -->
                            <TextBlock Text="Gender" Foreground="{StaticResource BodyBrush}" FontSize="11" Margin="0,0,0,4"/>
                            <ComboBox x:Name="ComboGender" Height="30" Margin="0,0,0,12">
                                <ComboBoxItem Content="All Genders" Tag="" IsSelected="True"/>
                                <ComboBoxItem Content="Male" Tag="male"/>
                                <ComboBoxItem Content="Female" Tag="female"/>
                                <ComboBoxItem Content="Neutral" Tag="neutral"/>
                            </ComboBox>

                            <!-- Age -->
                            <TextBlock Text="Age" Foreground="{StaticResource BodyBrush}" FontSize="11" Margin="0,0,0,4"/>
                            <ComboBox x:Name="ComboAge" Height="30" Margin="0,0,0,12">
                                <ComboBoxItem Content="All Ages" Tag="" IsSelected="True"/>
                                <ComboBoxItem Content="Young" Tag="young"/>
                                <ComboBoxItem Content="Middle Aged" Tag="middle_aged"/>
                                <ComboBoxItem Content="Old" Tag="old"/>
                            </ComboBox>

                            <!-- Language -->
                            <TextBlock Text="Language (ISO 639-1 e.g. en, vi)" Foreground="{StaticResource BodyBrush}" FontSize="11" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtLanguage" Height="30" Margin="0,0,0,12" KeyDown="FilterInput_KeyDown"/>

                            <!-- Use Cases -->
                            <TextBlock Text="Use Cases" Foreground="{StaticResource BodyBrush}" FontSize="11" Margin="0,0,0,4"/>
                            <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" Background="{StaticResource CanvasBrush}" CornerRadius="8" Padding="5" Height="120" Margin="0,0,0,12">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="PanelUseCases">
                                        <CheckBox Content="Conversational" Tag="conversational" Margin="0,2"/>
                                        <CheckBox Content="Narrative Story" Tag="narrative_story" Margin="0,2"/>
                                        <CheckBox Content="Social Media" Tag="social_media" Margin="0,2"/>
                                        <CheckBox Content="Characters Animation" Tag="characters_animation" Margin="0,2"/>
                                        <CheckBox Content="Informative Educational" Tag="informative_educational" Margin="0,2"/>
                                        <CheckBox Content="Advertisement" Tag="advertisement" Margin="0,2"/>
                                        <CheckBox Content="Entertainment TV" Tag="entertainment_tv" Margin="0,2"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Button Grid.Row="1" x:Name="BtnApplyFilters" Content="Apply Filters" Height="34" Style="{StaticResource PrimaryButton}" Click="BtnApplyFilters_Click"/>
                </Grid>
            </Border>

            <!-- Voices Grid -->
            <Border Grid.Column="2" Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="16" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="DgridVoices" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              Background="Transparent" BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0" RowHeight="36" FontSize="13" SelectionMode="Single" SelectionChanged="DgridVoices_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Voice Name" Binding="{Binding name}" Width="1.5*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Gender" Binding="{Binding gender}" Width="0.8*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Language" Binding="{Binding language}" Width="0.8*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Description" Binding="{Binding description}" Width="3*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Voice ID" Binding="{Binding voice_id}" Width="2*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Loading overlay / No results indicator -->
                    <Grid x:Name="OverlayStatus" Background="#E6FFFFFF" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="TxtStatusText" Text="Loading voices..." Foreground="{StaticResource InkBrush}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <ProgressBar x:Name="ProgressLoading" IsIndeterminate="True" Width="200" Height="6" Margin="0,10,0,0" Background="{StaticResource SurfaceSoftBrush}" Foreground="{StaticResource PrimaryBrush}" BorderThickness="0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Pagination Controls -->
                    <Grid Grid.Row="1" Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Page size:" Foreground="{StaticResource BodyBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <ComboBox x:Name="ComboPageSize" Width="70" SelectionChanged="ComboPageSize_SelectionChanged">
                                <ComboBoxItem Content="15" Tag="15"/>
                                <ComboBoxItem Content="30" Tag="30" IsSelected="True"/>
                                <ComboBoxItem Content="50" Tag="50"/>
                                <ComboBoxItem Content="100" Tag="100"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnPrevPage" Content="◀ Prev" Width="75" Height="28" Margin="0,0,10,0" Click="BtnPrevPage_Click"/>
                            <TextBlock x:Name="TxtPageIndex" Text="Page 1" Foreground="{StaticResource BodyBrush}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                            <Button x:Name="BtnNextPage" Content="Next ▶" Width="75" Height="28" Click="BtnNextPage_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Controls -->
        <Border Grid.Row="2" Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="16" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Selected Voice ID: " Foreground="{StaticResource BodyBrush}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtSelectedVoiceId" Text="None" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold" Margin="5,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnCancel" Content="Cancel" Width="90" Height="32" Margin="0,0,10,0" Click="BtnCancel_Click"/>
                    <Button x:Name="BtnConfirm" Content="Select Voice" Width="120" Height="32" Style="{StaticResource GreenButton}" Click="BtnConfirm_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
