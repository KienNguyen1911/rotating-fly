<Window x:Class="AssetAutomator.Windows.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Cập nhật ứng dụng AssetAutomator" Height="530" Width="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource InkBrush}"
        FontFamily="Segoe UI" FontSize="13"
        Icon="pack://application:,,,/Resources/app_logo.png">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Version Comparison Card -->
            <RowDefinition Height="Auto"/>
            <!-- Release Notes Section -->
            <RowDefinition Height="*"/>
            <!-- Action Buttons Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Card -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceSoftBrush}" CornerRadius="16" Padding="16,14" Margin="0,0,0,15" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="46" Height="46" CornerRadius="23" Background="{DynamicResource PrimaryBrush}" Margin="0,0,15,0" VerticalAlignment="Center">
                    <TextBlock Text="🚀" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtHeaderTitle" Text="Đã có phiên bản cập nhật mới!" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                    <TextBlock x:Name="TxtHeaderSubtitle" Text="Vui lòng nâng cấp để trải nghiệm các tính năng và cải tiến mới nhất." FontSize="12" Foreground="{DynamicResource BodyBrush}" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Version Comparison Card -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceCardBrush}" CornerRadius="12" Padding="15" Margin="0,0,0,15" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="Phiên bản hiện tại" FontSize="11" Foreground="{DynamicResource MutedSoftBrush}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtCurrentVersion" Text="v1.2.4.0" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="➔" FontSize="18" Foreground="{DynamicResource SemanticUpBrush}" VerticalAlignment="Center" Margin="15,0"/>

                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="Phiên bản mới nhất" FontSize="11" Foreground="{DynamicResource MutedSoftBrush}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtNewVersion" Text="v1.2.5" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource SemanticUpBrush}" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Release Notes Section -->
        <Grid Grid.Row="2" Margin="0,0,0,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="📝 Nội dung cập nhật (Release Notes):" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,8"/>
            <Border Grid.Row="1" Background="{DynamicResource SurfaceSoftBrush}" CornerRadius="12" Padding="12" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBox x:Name="TxtReleaseNotes" Text="Đang tải thông tin cập nhật..." IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" Foreground="{DynamicResource BodyBrush}" BorderThickness="0" FontSize="12.5"/>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Action Buttons Bar -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="BtnSkipVersion" Content="🚫 Bỏ qua bản này" Height="36" Padding="12,0" Style="{StaticResource Button.Base}" Click="BtnSkipVersion_Click" Cursor="Hand"/>
            <Button Grid.Column="2" x:Name="BtnRemindLater" Content="⏰ Nhắc tôi sau" Height="36" Padding="15,0" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Click="BtnRemindLater_Click" Cursor="Hand"/>
            <Button Grid.Column="3" x:Name="BtnUpdateNow" Content="🚀 Cập nhật ngay" Height="36" Padding="20,0" Style="{StaticResource GreenButton}" FontWeight="Bold" Click="BtnUpdateNow_Click" Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>
